{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coldsession-scout/1/request",
  "title": "coldsession scout request",
  "description": "Produced by `plan scout request` from a fixed kind template. Hosts never send a free-form question.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "kind", "template", "params", "scope", "known", "purpose", "budget", "rev", "prompt"],
  "properties": {
    "contract": {"const": "coldsession-scout/1"},
    "kind": {"enum": ["locate", "trace", "inventory"]},
    "template": {
      "description": "Versions of the kind template and the shared rules it was rendered from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "common"],
      "properties": {
        "kind": {"enum": ["locate", "trace", "inventory"]},
        "version": {"type": "integer", "minimum": 1},
        "common": {"type": "integer", "minimum": 1}
      }
    },
    "params": {
      "description": "locate and inventory take symbol; trace takes from and to. One line each, at most 200 characters.",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]*$"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string"}},
        "exclude": {"type": "array", "maxItems": 20, "items": {"type": "string"}}
      }
    },
    "known": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]*$"}
    },
    "purpose": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n]*$"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "snippet_lines", "answer_sentences"],
      "properties": {
        "evidence": {"const": 15},
        "snippet_lines": {"const": 5},
        "answer_sentences": {"const": 3}
      }
    },
    "rev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "dirty"],
      "properties": {
        "head": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "prompt": {"type": "string", "description": "The rendered template; derived, never edited."}
  }
}
