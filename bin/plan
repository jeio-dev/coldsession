#!/usr/bin/env python3
"""plan - dependency and context tooling for the planning workflow.

Reads PLAN.md (an index) and the phase file it points at. The phase file's
frontmatter carries a machine-readable task graph, its `## Findings` block
carries a machine-readable finding list, and the body carries the prose.
Stdlib only, no install step.

  plan status                     where the phase stands, and what to run next
  plan recommend                  one line: the next command to run, and why
  plan lint                       validate graph and findings, exit 1 on error
  plan next [--parallel]          next runnable task ids
  plan brief T2                   bounded read list, token budget, verify line
  plan done T2                    mark a task done
  plan block T2 "reason"          mark a task blocked
  plan findings [--open]          the finding list
  plan resolve F1 STATE "note"    set a finding state, log it to the changelog
  plan begin STAGE [--resume]      claim review/revise/approve/close
  plan finish STAGE [--pass|--fail|--accept-only] complete a claimed stage
  plan start T2 [--resume]         claim one approved build task
  plan verify T2 [--attest CHECK=TEXT]  run checks and record matching evidence
  plan replan [--recover-claims]  preserve history and return unfinished work to draft
  plan doctor [--json]             runtime, adapters, hooks, trust, and gaps
  plan recover                    replay an interrupted workflow transaction
  plan assign BACKEND [--max N]   coordinator claims one approved worker group
  plan integrate RESULT.json      accept a current verified worker result
  plan handoff T2 JSON|--stdin    record a bounded structured handoff
  plan bump                       bump the phase rev, at the start of a revise
  plan reviewed                   record that this rev has had a review pass
  plan metrics                    deterministic workflow metrics across every phase
  plan guard KIND [target]        shared hook checks; quiet for unrelated projects
  plan issue NUMBER               read-only GitHub issue intake for /cs-plan --issue
  plan scout template|request|validate|cached   experimental scout report contract
  plan scout run --request REQUEST.json | KIND NAME=VALUE... --purpose TEXT
                                  run one request through the provider (experimental)
  plan scout status [--json]      exit 0 only when a scout run can reach its provider
  plan scout setup|model|exclude|disable        opt-in scout configuration (experimental)
  plan version                    print the coldsession release version
"""

import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import shutil
import threading
import uuid
from pathlib import Path
from datetime import datetime

TOOL_VERSION = "3.5.0"
FORMAT_VERSION = "2.0.0"

ROOT = os.path.realpath(os.environ.get("PLAN_ROOT", "."))
INDEX = os.path.join(ROOT, "PLAN.md")
AGENTS_PATH = os.path.join(ROOT, "AGENTS.md")
AGENTS_MD_BUDGET = 60
# Soft budget on direct task context. Shared prose, inherited legacy scope,
# and package-manager lockfiles are reported separately. This is advisory.
BRIEF_TOKEN_BUDGET = 12000
LOCKFILE_NAMES = frozenset((
    'package-lock.json', 'npm-shrinkwrap.json', 'yarn.lock', 'pnpm-lock.yaml',
    'bun.lock', 'bun.lockb', 'Cargo.lock', 'poetry.lock', 'uv.lock', 'Pipfile.lock',
    'composer.lock', 'Gemfile.lock',
))

TASK_RE = re.compile(r"^\s{2}(T\d+):\s*\{(.*)\}\s*$")
HEAD_RE = re.compile(r"^##\s+(.+?)\s*$")
TASK_HEAD_RE = re.compile(r"^(T\d+)\b")
FINDING_RE = re.compile(r"^F\d+\b")
CHANGE_RE = re.compile(r"^rev\s+(\d+)\s*\|\s*(F\d+)\s*\|\s*([A-Za-z_-]+)\s*\|\s*(.*)$")
LIST_RE = lambda k: re.compile(k + r":\s*\[([^\]]*)\]")
WORD_RE = lambda k: re.compile(k + r":\s*([A-Za-z_-]+)")
# Owner ids are opaque and come from the surface, not from us: an Orca
# terminal handle or a Claude Code session id. Match anything up to the next
# field separator rather than a word, so a new surface's id shape needs no
# change here.
OWNER_RE = re.compile(r"owner:\s*([^,}\s]+)")
STATUSES = ("pending", "in_progress", "done", "blocked")
PSTATUSES = ("draft", "approved", "closed")
FSTATUSES = ("open", "resolved", "accepted")
SEVERITIES = ("Critical", "High", "Medium", "Low")
META_KEYS = ("phase", "rev", "status", "reviewed", "ready", "active",
             "active-rev", "workflow-rev", "ready-spec", "reviewed-spec",
             "active-spec", "reconciliation")
STAGES = ("review", "revise", "approve", "close")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def read_text(path):
    """Read a file, tolerating a UTF-8 BOM.

    Windows PowerShell writes one by default - `Set-Content -Encoding UTF8`
    and `Out-File` both do - and a BOM ahead of the opening `---` means
    split_frontmatter sees no frontmatter at all, so the phase reads as
    having no tasks. Files are always written back without one.
    """
    with open(path, encoding="utf-8-sig") as handle:
        return handle.read()


def split_frontmatter(text):
    if not text.startswith("---"):
        return "", text
    end = text.find("\n---", 3)
    if end == -1:
        return "", text
    return text[3:end], text[end + 4:]


def join_frontmatter(fm, body):
    return "---" + fm + "\n---" + body


def csv(raw):
    return [p.strip() for p in raw.split(",") if p.strip()]


def intof(value, default=0):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def read_index():
    if not os.path.exists(INDEX):
        die("no PLAN.md at repo root. Run /cs-plan first.")
    fm, _ = split_frontmatter(read_text(INDEX))
    m = re.search(r"^current:\s*(\S+)", fm, re.M)
    if not m:
        die("PLAN.md frontmatter has no `current:` pointer.")
    path = phase_path(m.group(1))
    if not os.path.exists(path):
        die(f"PLAN.md points at {m.group(1)}, which does not exist.\n"
            "  A phase was probably closed and the next one not planned yet.\n"
            "  Run /cs-plan for it in a new session -- /cs-plan writes the phase file\n"
            "  and moves `current:` to it -- or point `current:` back at the\n"
            "  phase file you are still working in.")
    return path


def parse_tasks(fm):
    tasks, order, malformed = {}, [], []
    in_tasks = False
    for line in fm.splitlines():
        if re.match(r"^tasks:\s*$", line):
            in_tasks = True
            continue
        if in_tasks:
            if line.strip() and not line.startswith("  "):
                in_tasks = False
                continue
            if not line.strip():
                continue
            m = TASK_RE.match(line)
            if not m:
                malformed.append(line.rstrip())
                continue
            tid, inner = m.group(1), m.group(2)
            if tid in tasks:
                malformed.append(f"duplicate task ID {tid}: {line}")
                continue
            fields = re.findall(r'(?:^|,)\s*([\w-]+)\s*:', inner)
            if (len(fields) != len(set(fields)) or set(fields) - {'deps', 'status', 'files', 'reads', 'owner'}
                    or not {'deps', 'status', 'files'}.issubset(fields)):
                malformed.append(f'invalid or duplicate task fields: {line}')
                continue
            deps = LIST_RE("deps").search(inner)
            files = LIST_RE("files").search(inner)
            status = WORD_RE("status").search(inner)
            owner = OWNER_RE.search(inner)
            tasks[tid] = {
                "deps": csv(deps.group(1)) if deps else [],
                "files": csv(files.group(1)) if files else [],
                "reads": csv(LIST_RE("reads").search(inner).group(1)) if LIST_RE("reads").search(inner) else [],
                "status": status.group(1) if status else "?",
                # Absent on every phase file written before format 1.5, and
                # absent again the moment the task stops being in progress.
                "owner": owner.group(1) if owner else None,
            }
            order.append(tid)
    return tasks, order, malformed


def parse_blocks(body):
    """Every `## Heading` in the body, mapped to its text."""
    blocks, current, buf = {}, None, []
    for line in body.splitlines():
        m = HEAD_RE.match(line)
        if m:
            if current is not None:
                blocks[current] = "\n".join(buf).strip()
            current, buf = m.group(1).strip(), []
            continue
        if current is not None:
            buf.append(line)
    if current is not None:
        blocks[current] = "\n".join(buf).strip()
    return blocks


COMMENT_RE = re.compile(r"<!--.*?-->", re.S)


def block(blocks, name):
    """A block's text with HTML comments removed.

    The templates carry their format examples inside comments; a commented
    finding is documentation, not a finding, including when the comment spans
    several lines and the example sits on one of the inner ones.
    """
    for head, text in blocks.items():
        if head.lower() == name.lower():
            return COMMENT_RE.sub("", text)
    return ""


def parse_findings(text):
    """One finding per line:

      F1 | Critical | Task ordering | T3 | open | description | recommended fix

    Prose and HTML comments are ignored. A line that starts with an F-id but
    does not carry seven fields is reported rather than silently dropped.
    """
    findings, order, malformed, dupes = {}, [], [], []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        if not line or line.startswith("<!--"):
            continue
        if not FINDING_RE.match(line):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) != 7:
            malformed.append(line)
            continue
        fid, sev, cat, tasks, status, desc, fix = parts
        if sev.title() not in SEVERITIES or status.lower() not in FSTATUSES:
            malformed.append(line)
            continue
        if fid in findings:
            dupes.append(fid)
            continue
        findings[fid] = {"severity": sev.title(), "category": cat,
                         "tasks": csv(tasks), "status": status.lower(),
                         "desc": desc, "fix": fix}
        order.append(fid)
    return findings, order, malformed, dupes


def parse_changelog(text):
    """One entry per line:  rev 2 | F1 | resolved | what carries the fix"""
    entries = []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        m = CHANGE_RE.match(line)
        if m:
            entries.append({"rev": intof(m.group(1)), "fid": m.group(2),
                            "state": m.group(3).lower(), "note": m.group(4).strip()})
    return entries


def read_phase(path):
    text = read_text(path)
    fm, body = split_frontmatter(text)
    meta = {}
    for key in META_KEYS:
        m = re.search(r"^%s:\s*(.+)$" % key, fm, re.M)
        if m:
            meta[key] = m.group(1).strip()

    tasks, order, malformed = parse_tasks(fm)
    meta_fields = re.findall(r'^([\w-]+):', fm, re.M)
    if len(meta_fields) != len(set(meta_fields)):
        malformed.append('duplicate frontmatter keys')
    task_heads = re.findall(r'^##\s+(T\d+)\b', COMMENT_RE.sub('', body), re.M)
    if len(task_heads) != len(set(task_heads)):
        malformed.append('duplicate task body sections')
    blocks = parse_blocks(body)

    sections = {}
    for head, chunk in blocks.items():
        m = TASK_HEAD_RE.match(head)
        if m:
            sections[m.group(1)] = chunk

    findings, forder, fmalformed, fdupes = parse_findings(block(blocks, "Findings"))

    return {"path": path, "meta": meta, "tasks": tasks, "order": order,
            "sections": sections, "blocks": blocks, "malformed": malformed,
            "findings": findings, "forder": forder, "fmalformed": fmalformed,
            "fdupes": fdupes, "changelog": parse_changelog(block(blocks, "Changelog")),
            "text": text}


def num(tid):
    return int(tid[1:])


def cycles(tasks):
    color, found = {}, []

    def walk(node, stack):
        color[node] = 1
        for dep in tasks.get(node, {}).get("deps", []):
            if dep not in tasks:
                continue
            if color.get(dep) == 1:
                found.append(" -> ".join(stack + [node, dep]))
            elif color.get(dep, 0) == 0:
                walk(dep, stack + [node])
        color[node] = 2

    for tid in tasks:
        if color.get(tid, 0) == 0:
            walk(tid, [])
    return found


def runnable(phase):
    out = []
    for tid in phase["order"]:
        t = phase["tasks"][tid]
        if t["status"] != "pending":
            continue
        if all(phase["tasks"].get(d, {}).get("status") == "done" for d in t["deps"]):
            out.append(tid)
    return out


def open_findings(phase, severities=None):
    out = []
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        if f["status"] != "open":
            continue
        if severities and f["severity"] not in severities:
            continue
        out.append(fid)
    return out


def verify_line(phase, tid):
    for line in phase["sections"].get(tid, "").splitlines():
        if re.match(r"^\s*[-*]?\s*Verify:", line):
            return line.strip().lstrip("-* ").strip()
    return None


# ------------------------------------------------------------------- lint

def lint_issues(phase):
    errs, warns = [], []
    t = phase["tasks"]

    for line in phase["malformed"]:
        errs.append(f"E01 unparseable task line: {line}")
    if not t:
        errs.append("E02 no tasks: block in the phase file frontmatter")

    fmt = phase["meta"].get("workflow-rev")
    if fmt is None:
        warns.append("W03 phase file has no workflow-rev; it was written by an "
                     "older coldsession and may not match this tool")
    elif fmt.split(".")[0] not in ("1", "2"):
        errs.append(f"E11 phase file is format {fmt}, supported format is {FORMAT_VERSION}; "
                    "major versions differ and the shapes are not compatible")

    if phase["meta"].get("status") not in PSTATUSES + (None,):
        warns.append(f"W01 unexpected phase status {phase['meta'].get('status')!r}")

    active = phase["meta"].get("active")
    if active and active not in STAGES + ("plan",):
        errs.append(f"E16 unknown active stage {active!r}")
    if active and not phase["meta"].get("active-rev"):
        errs.append(f"E17 active stage {active!r} has no active-rev")
    if not active and phase["meta"].get("active-rev"):
        errs.append("E18 active-rev exists without an active stage")

    for tid in phase["order"]:
        task = t[tid]
        if task["status"] not in STATUSES:
            errs.append(f"E03 {tid} has status {task['status']!r}")
        if task["status"] == "in_progress" and phase["meta"].get("status") != "approved":
            errs.append(f"E19 {tid} is in_progress but the phase is not approved")
        if not task["files"]:
            errs.append(f"E04 {tid} has an empty files list; build cannot bound its reads")
        elif task["status"] != "done" and phase["meta"].get("status") != "closed":
            tokens = _context_budget(phase, tid)['task']
            if tokens > BRIEF_TOKEN_BUDGET:
                warns.append(f"W07 {tid} file context is ~{tokens:,} tokens "
                             "(whole-file estimate, bytes/4; direct task context, "
                             "excluding shared/inherited files and implicit lockfile reads), over the "
                             f"{BRIEF_TOKEN_BUDGET:,}-token soft budget; advisory only. "
                             "Large existing files can trigger this for a small edit; "
                             f"inspect `plan brief {tid}` and use targeted reads. "
                             "Keep required files in scope; split only if the work is too broad.")
        for dep in task["deps"]:
            if dep not in t:
                errs.append(f"E05 {tid} depends on {dep}, which is not in this phase")
            elif num(dep) > num(tid):
                warns.append(f"W02 {tid} depends on later task {dep}; reorder or renumber")
        if task["status"] == "done":
            for dep in task["deps"]:
                if t.get(dep, {}).get("status") != "done":
                    errs.append(f"E06 {tid} is done but its dependency {dep} is not")
        if tid not in phase["sections"]:
            errs.append(f"E07 {tid} is in the graph but has no `## {tid}` section in the body")
        elif not verify_line(phase, tid):
            errs.append(f"E08 {tid} has no Verify: line; build has nothing to run")

    for tid in phase["sections"]:
        if tid not in t:
            errs.append(f"E09 `## {tid}` exists in the body but not in the tasks graph")

    for c in cycles(t):
        errs.append(f"E10 dependency cycle: {c}")

    for line in phase["fmalformed"]:
        errs.append(f"E12 unparseable finding line: {line}")
    for fid in phase["fdupes"]:
        errs.append(f"E13 finding {fid} is defined more than once")

    logged = {c["fid"] for c in phase["changelog"]}
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        for ref in f["tasks"]:
            if re.match(r"^T\d+$", ref) and ref not in t:
                errs.append(f"E14 finding {fid} names {ref}, which is not in this phase")
        if f["status"] != "open" and fid not in logged:
            warns.append(f"W04 {fid} is marked {f['status']} but no changelog entry "
                         "says what carries the fix")

    if phase["meta"].get("status") in ("approved", "closed"):
        stuck = open_findings(phase, ("Critical", "High"))
        if stuck:
            errs.append(f"E15 phase is {phase['meta']['status']} with open "
                        f"Critical/High findings: {', '.join(stuck)}")

    fmt_minor = intof((fmt or "1.0").split(".")[1] if "." in (fmt or "") else 0)
    rev = intof(phase["meta"].get("rev"), 1)
    ready = intof(phase["meta"].get("ready"), 0)
    if ready > rev:
        errs.append(f"E20 ready revision {ready} is newer than rev {rev}")
    if ready == rev and open_findings(phase):
        errs.append("E21 current revision is marked ready but still has open findings")
    if fmt_minor >= 4 and phase["meta"].get("status") == "approved" and ready != rev:
        errs.append(f"E22 phase is approved but rev {rev} has no matching ready marker")

    if intof(phase["meta"].get("rev"), 1) >= 3 and open_findings(phase, ("Critical",)):
        warns.append("W05 round 3 still has an open Critical; the phase is too large "
                     "or the objective is wrong. Split it and re-plan rather than "
                     "revising again")

    if os.path.exists(AGENTS_PATH):
        try:
            agents_lines = len(read_text(AGENTS_PATH).splitlines())
        except OSError:
            agents_lines = 0
        if agents_lines > AGENTS_MD_BUDGET:
            warns.append(f"W06 AGENTS.md is {agents_lines} lines, over the "
                         f"{AGENTS_MD_BUDGET}-line budget; a build session re-reads it "
                         "every task, trim it before adding more")

    source = block(phase["blocks"], "Source").strip()
    if source:
        url, sha, updated = source_issue(phase["text"])
        if not (url and sha and updated):
            warns.append("W08 ## Source needs issue:, updated:, and body-sha256: lines "
                         "as printed by plan issue; without them duplicate adoption "
                         "cannot be detected")

    if strict(phase):
        for tid, task in t.items():
            section = phase['sections'].get(tid, '')
            for field in ('Goal', 'Deliverables', 'Acceptance Criteria'):
                match = re.search(r'^' + field + r':(.*?)(?=^(?:Goal|Deliverables|Acceptance Criteria|Verify):|\Z)', section, re.M | re.S)
                if not match or not match.group(1).strip():
                    errs.append(f'E35 {tid} requires concrete {field}')
            for entry in task['files'] + task['reads']:
                try:
                    scope_path(entry)
                    if sensitive(entry):
                        raise ValueError(f'sensitive path cannot be task scope: {entry}')
                except ValueError as exc:
                    errs.append(f"E26 {tid}: {exc}")
            try:
                if scout_evidence([c['command'] for c in verification_checks(phase, tid)]):
                    errs.append(f"E36 {tid}: Verify cites a scout report, which is orientation only")
            except ValueError as exc:
                errs.append(f"E27 {tid}: {exc}")
        if not block(phase['blocks'], 'Constraints').strip():
            errs.append('E28 missing durable Constraints (write None. if none apply)')
        spec = specification(phase)
        if phase['meta'].get('ready') and phase['meta'].get('ready-spec') != spec:
            errs.append('E29 readiness is stale; run plan replan')
        if phase['meta'].get('status') == 'approved' and (
                ready != rev or phase['meta'].get('ready-spec') != spec or
                phase['meta'].get('reviewed-spec') != spec):
            errs.append('E30 approval does not match the reviewed specification; run plan replan')
    return errs, warns


# -------------------------------------------------------------- recommend

def recommend(phase):
    """What to run next, derived from the file rather than from memory.

    Returns (command, why). The command is what a human types; the reason is
    the state that produced it, so a wrong recommendation is debuggable.
    """
    meta = phase["meta"]
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0) if meta.get("reviewed") else 0
    status = meta.get("status", "draft")
    opened = open_findings(phase)
    if strict(phase) and status != 'closed':
        if (any(t['status'] == 'blocked' for t in phase['tasks'].values()) or
                (meta.get('ready') and meta.get('ready-spec') != specification(phase))):
            return ('plan replan', 'blocked work or changed specification requires renewed review; settle active claims first')
        errs, _ = lint_issues(phase)
        if errs:
            return ('plan lint', 'repair the reported document errors, then run plan replan if approval is stale')
        if status == 'approved':
            for tid in phase['order']:
                if phase['tasks'][tid]['status'] == 'done' and not evidence_valid(phase, tid):
                    return (f'plan verify {tid}', 'historical completion requires current verification before close')

    active = meta.get("active")
    if active:
        return (f"/cs-{active} --resume",
                f"{active} is already active for rev {meta.get('active-rev', rev)}; "
                "a plain rerun is refused")

    if strict(phase) and load_json(assignment_path(phase), {}):
        return ('plan status', 'worker assignments remain; wait for results or explicitly recover settled claims, never replace quiet workers')

    in_progress = [x for x in phase["order"]
                   if phase["tasks"][x]["status"] == "in_progress"]
    if in_progress:
        return (f"/cs-build {in_progress[0]} --resume",
                f"{', '.join(in_progress)} already in progress; resume explicitly")

    if status == "closed":
        return ("/cs-plan",
                "this phase is closed; the next one has no file yet, and /cs-plan "
                "writes it and moves `current:` onto it")

    errs, _ = lint_issues(phase)

    if status == "draft":
        if rev >= 3 and open_findings(phase, ("Critical",)):
            return ("plan replan",
                    f"rev {rev} still has an open Critical "
                    f"({', '.join(open_findings(phase, ('Critical',)))}); split this phase "
                    "and re-plan rather than revising a fourth time")
        if not reviewed:
            return ("/cs-review",
                    "this phase has had no review pass; start one in a NEW session")
        if reviewed < rev:
            return ("/cs-review",
                    f"rev {rev} has not been checked since the last revision "
                    f"(last review pass was rev {reviewed}); run it in a NEW session")
        if opened:
            sev = ", ".join(sorted({phase["findings"][f]["severity"] for f in opened}))
            return ("/cs-revise",
                    f"{len(opened)} open finding(s) ({sev}): {', '.join(opened)}")
        if errs:
            return ("plan lint",
                    f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                    "this file until they are fixed")
        if intof(meta.get("ready"), 0) == rev:
            return ("(set status: approved, or type /cs-grant)",
                    f"rev {rev} passed /cs-approve; the human approval is pending")
        return ("/cs-approve",
                f"rev {rev} is reviewed with no open findings; /cs-approve produces the "
                "evidence, then you set `status: approved` yourself")

    if errs:
        return ("plan lint",
                f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                "this file until they are fixed")

    if status == "approved":
        done = [x for x in phase["order"] if phase["tasks"][x]["status"] == "done"]
        nxt = runnable(phase)
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        blocked = [x for x in phase["order"] if phase["tasks"][x]["status"] == "blocked"]
        if nxt:
            return (f"/cs-build {nxt[0]}",
                    f"{len(done)} of {len(phase['order'])} tasks done; "
                    f"{nxt[0]} is runnable")
        if blocked and not pending:
            return ("/cs-review",
                    f"{', '.join(blocked)} blocked and nothing else is pending; "
                    "re-enter the loop at review")
        if pending:
            waiting = []
            for tid in pending:
                unmet = [d for d in phase["tasks"][tid]["deps"]
                         if phase["tasks"].get(d, {}).get("status") != "done"]
                waiting.append(f"{tid} waits on {', '.join(unmet) or 'nothing runnable'}")
            return ("plan replan", "; ".join(waiting))
        return ("/cs-close", "every task is done")

    return ("plan lint", f"unsupported phase status {status!r}")


# ---------------------------------------------------------------- writing

def write_phase(phase, text):
    atomic_write(phase["path"], text)


def sub_outside_comments(pat, repl, text):
    """Replace the first match that is not inside an HTML comment.

    The read path drops commented lines, so the write path has to as well.
    Otherwise `plan resolve F1` edits the F1 in the template's format example
    and reports success while the real finding stays open.
    """
    spans = [(m.start(), m.end()) for m in COMMENT_RE.finditer(text)]
    for m in pat.finditer(text):
        if any(a <= m.start() < b for a, b in spans):
            continue
        return text[:m.start()] + repl(m) + text[m.end():], True
    return text, False


def set_meta(text, key, value):
    """Set a frontmatter field, inserting it after `status:` if absent."""
    fm, body = split_frontmatter(text)
    pat = re.compile(r"^(%s:\s*).*$" % re.escape(key), re.M)
    if pat.search(fm):
        fm = pat.sub(lambda m: m.group(1) + str(value), fm, count=1)
    else:
        anchor = re.compile(r"^(status:.*)$", re.M)
        if anchor.search(fm):
            fm = anchor.sub(lambda m: m.group(1) + f"\n{key}: {value}", fm, count=1)
        else:
            fm = fm.rstrip("\n") + f"\n{key}: {value}\n"
    return join_frontmatter(fm, body)


def del_meta(text, *keys):
    """Remove optional frontmatter fields without disturbing body text."""
    fm, body = split_frontmatter(text)
    for key in keys:
        fm = re.sub(r"^%s:\s*.*\n?" % re.escape(key), "", fm, flags=re.M)
    return join_frontmatter(fm.rstrip("\n") + "\n", body)


def set_metas(text, values=None, remove=()):
    for key, value in (values or {}).items():
        text = set_meta(text, key, value)
    return del_meta(text, *remove) if remove else text


def append_to_block(text, name, line):
    """Insert a line at the end of a `## Name` block, creating it if absent."""
    fm, body = split_frontmatter(text)
    lines = body.splitlines()
    start = None
    for i, raw in enumerate(lines):
        m = HEAD_RE.match(raw)
        if m and m.group(1).strip().lower() == name.lower():
            start = i
            break
    if start is None:
        body = body.rstrip("\n") + f"\n\n## {name}\n\n{line}\n"
        return join_frontmatter(fm, body)
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if HEAD_RE.match(lines[i]):
            end = i
            break
    tail = end
    while tail > start + 1 and not lines[tail - 1].strip():
        tail -= 1
    if tail == start + 1:
        lines.insert(tail, "")
        tail += 1
    lines.insert(tail, line)
    return join_frontmatter(fm, "\n".join(lines))


def _owner_id():
    """Who is running this build, as durably as the surface allows.

    Orca's terminal handle first: it outlives a restarted agent session and
    names a terminal that a coordinator can address, so a resumed build keeps
    the claim it started with. Claude and Codex session/thread IDs are fallbacks.
    Anonymous single-task execution stays scoped; teams require stable identity.
    """
    return (os.environ.get("ORCA_TERMINAL_HANDLE")
            or os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("CODEX_THREAD_ID")
            or os.environ.get("CODEX_SESSION_ID") or None)


def _set_owner(text, tid, owner):
    """Write, replace, or drop one task's `owner:` field.

    Appended last inside the braces rather than woven in beside `status:`, so
    a phase file written before 1.5 gains the key without its other fields
    moving, and a diff of a claim is one field wide.
    """
    line = re.compile(r"^(\s{2}%s:\s*\{)(.*?)(\}\s*)$" % tid, re.M)

    def rewrite(m):
        inner = OWNER_RE.sub("", m.group(2))
        inner = re.sub(r",\s*,", ",", inner).rstrip().rstrip(",").rstrip()
        if owner:
            inner += f", owner: {owner}"
        return m.group(1) + inner + m.group(3)

    updated, _ = sub_outside_comments(line, rewrite, text)
    return updated


def _set_status(phase, tid, status, note=None):
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    pat = re.compile(r"^(\s{2}%s:\s*\{.*?status:\s*)([A-Za-z_-]+)" % tid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + status, phase["text"])
    if not hit:
        die(f"could not find a status field for {tid}")
    # One write, not two: the claim and the status it belongs to should never
    # be separately observable, least of all by a parallel build session.
    text = _set_owner(text, tid, _owner_id() if status == "in_progress" else None)
    write_phase(phase, text)
    print(f"{tid} -> {status}")
    if note:
        log = phase["path"].replace(".md", ".log.md")
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(f"\n## {tid} blocked\n{note}\n")
        print(f"note appended to {log}")


# ---------------------------------------------------------------- commands

def print_recommend(phase, prefix="next"):
    cmd, why = recommend(phase)
    print(f"{prefix}     {cmd}")
    print(f"          why: {why}")


def cmd_status(phase, _args):
    m = phase["meta"]
    counts = {s: 0 for s in STATUSES}
    for t in phase["tasks"].values():
        counts[t["status"]] = counts.get(t["status"], 0) + 1
    reviewed = m.get("reviewed")
    print(f"phase    {m.get('phase', '?')}  rev {m.get('rev', '?')}  "
          f"status {m.get('status', '?')}  "
          f"reviewed {reviewed if reviewed else 'never'}  "
          f"ready {m.get('ready', 'no')}  "
          f"active {m.get('active', 'none')}  "
          f"workflow-rev {m.get('workflow-rev', '?')}")
    print(f"file     {phase['path']}")
    print("tasks    " + "  ".join(f"{k} {v}" for k, v in counts.items() if v))
    if phase["forder"]:
        opened = open_findings(phase)
        detail = ""
        if opened:
            by = {}
            for fid in opened:
                by[phase["findings"][fid]["severity"]] = \
                    by.get(phase["findings"][fid]["severity"], 0) + 1
            detail = "  (" + ", ".join(f"{v} {k}" for k, v in by.items()) + ")"
        print(f"findings {len(phase['forder'])} total  {len(opened)} open{detail}")
    nxt = runnable(phase)
    print("runnable " + (", ".join(nxt) if nxt else "none"))
    blocked = [t for t in phase["order"] if phase["tasks"][t]["status"] == "blocked"]
    if blocked:
        print("blocked  " + ", ".join(blocked))
    print_recommend(phase)


def cmd_recommend(phase, _args):
    cmd, why = recommend(phase)
    print(f"{cmd}   why: {why}")
    return 0


def cmd_lint(phase, _args):
    errs, warns = lint_issues(phase)
    for line in errs:
        print(line)
    for line in warns:
        print(line)
    if not errs and not warns:
        print(f"ok  {len(phase['tasks'])} tasks, graph is acyclic, every task has files "
              f"and a Verify line; {len(phase['forder'])} findings, "
              f"{len(open_findings(phase))} open")
    return 1 if errs else 0


def cmd_next(phase, args):
    if strict(phase):
        validate_transition(phase, 'assign', [])
    nxt = runnable(phase)
    if strict(phase):
        nxt = [tid for tid in nxt if not any(
            other != tid and task['status'] == 'in_progress' and task_conflict(phase, tid, other)
            for other, task in phase['tasks'].items())]
    if not nxt:
        if strict(phase):
            print_recommend(phase)
            return 0
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        if phase["meta"].get("status") == "closed":
            print("this phase is closed: run /cs-plan for the next one")
        elif not pending:
            print("no pending tasks: the phase is complete, run /cs-close")
        else:
            print("nothing runnable: every pending task is waiting on an unfinished dependency")
            for tid in pending:
                waiting = [d for d in phase["tasks"][tid]["deps"]
                           if phase["tasks"].get(d, {}).get("status") != "done"]
                print(f"  {tid} waits on {', '.join(waiting)}")
        return 0

    if "--parallel" not in args:
        print(" ".join(nxt))
        return 0

    groups = []
    for tid in nxt:
        files = {_guard_norm(p) for p in phase["tasks"][tid]["files"]}
        running = {_guard_norm(p) for t in phase['tasks'].values() if t['status'] == 'in_progress' for p in t['files']}
        if files & running:
            continue
        for g in groups:
            if not files & g["files"] and not (strict(phase) and any(task_conflict(phase, tid, other) for other in g['ids'])):
                g["ids"].append(tid)
                g["files"] |= files
                break
        else:
            groups.append({"ids": [tid], "files": set(files)})
    print("these can run at the same time, one session each:")
    for g in groups:
        print("  " + " ".join(g["ids"]))
    if len(groups) > 1:
        print("groups touch overlapping files; run the groups in sequence")
    return 0


def _transitive_deps(phase, tid):
    """All ancestor task ids reachable via deps, in dependency-first order."""
    seen, order = set(), []

    def visit(t):
        for d in phase["tasks"].get(t, {}).get("deps", []):
            if d not in seen:
                seen.add(d)
                visit(d)
                order.append(d)

    visit(tid)
    return order


def read_set(phase, tid):
    """The bounded read list for one task, in the order a build session opens it.

    AGENTS.md, the phase file, the files of every transitive dependency, then
    the task's own; first occurrence wins so the prefix stays byte-identical
    across build sessions. `plan brief` prints this list and `plan guard`
    enforces it; they must never disagree about what a session may open, so
    both call this rather than rebuilding the traversal.
    """
    reads = ["AGENTS.md", phase["path"]]
    if not strict(phase):
        for dep in _transitive_deps(phase, tid):
            reads += phase["tasks"].get(dep, {}).get("files", [])
    reads += phase['tasks'].get(tid, {}).get('reads', [])
    reads += phase["tasks"].get(tid, {}).get("files", [])

    seen, ordered = set(), []
    for r in reads:
        if r not in seen:
            seen.add(r)
            ordered.append(r)
    return ordered


def _context_budget(phase, tid, include_inherited=False):
    """Whole-file bytes/4 inventory, separated from direct task context.

    Legacy read authorization inherits dependency files; that is not an
    instruction to load them all. Lockfiles are usually generated outputs;
    count them toward W07 only when explicitly requested in `reads`.
    Neither distinction changes read/write authorization or fingerprints.
    Other source/doc files still use their full size, not guessed excerpts.
    Resolve aliases once and keep missing files visible without guessing size.
    """
    phase_path = phase['path']

    def resolve(rel):
        if rel == phase_path:
            return rel
        return os.path.join(ROOT, rel)

    def canon(rel):
        return os.path.normcase(os.path.realpath(resolve(rel)))

    phase_canon = canon(phase_path)
    agents_canon = canon("AGENTS.md")
    task = phase['tasks'].get(tid, {})
    explicit_reads = {canon(p) for p in task.get('reads', [])}
    direct = explicit_reads | {canon(p) for p in task.get('files', [])}
    lockfile_names = {os.path.normcase(n) for n in LOCKFILE_NAMES}
    budget = dict(task=0, phase=0, agents=0, inherited=0, lockfiles=0, missing=[])
    seen = set()
    paths = (read_set(phase, tid) if include_inherited else
             ['AGENTS.md', phase_path] + task.get('reads', []) + task.get('files', []))
    for rel in paths:
        path = canon(rel)
        if path in seen:
            continue
        seen.add(path)
        try:
            size = os.path.getsize(resolve(rel)) // 4
        except OSError:
            budget['missing'].append(rel)
            continue
        if path == phase_canon:
            bucket = 'phase'
        elif path == agents_canon:
            bucket = 'agents'
        elif os.path.basename(path) in lockfile_names and path not in explicit_reads:
            bucket = 'lockfiles'
        elif path not in direct:
            bucket = 'inherited'
        else:
            bucket = 'task'
        budget[bucket] += size
    return budget


def _last_log_entry(path):
    """The most recent `## ...` entry in a handoff log, headed and bodied, or None.

    `plan brief` already tells a build session to read only the last entry;
    inlining it here bounds that the same way the Verify line already is,
    rather than trusting the instruction to stop a session short once it has
    the whole file open.
    """
    try:
        text = read_text(path)
    except (OSError, UnicodeDecodeError):
        # A pre-existing log in some other encoding (UTF-16, latin-1 from an
        # editor that never asked) must not turn "inline the last entry" into
        # a crash; brief still has a phase and files to report without it.
        return None
    # [ \t]+, not \s+: \s matches a newline too, so a bare "##" line with no
    # text after it would otherwise let the match run on through the blank
    # line beneath and swallow the next paragraph as part of the "heading".
    parts = re.split(r"(?m)^(##[ \t]+\S.*)$", text)
    if len(parts) < 3:
        return None
    head, body = parts[-2].strip(), parts[-1].strip()
    return f"{head}\n{body}" if body else head


def cmd_brief(phase, args):
    tid = task_arg(args, "plan brief T2")
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]

    unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
    ordered = read_set(phase, tid)

    status = phase["meta"].get("status", "?")
    print(f"task    {tid}   status {task['status']}")
    print(f"phase   {phase['path']}  (phase status {status})")
    if status != "approved":
        cmd, _ = recommend(phase)
        print(f"NOT APPROVED this phase is {status}, not approved - run {cmd} first")
    if task["status"] != "in_progress":
        print(f"NOT STARTED {tid} is {task['status']}; run plan start {tid} first")
    if unmet:
        print(f"BLOCKED unmet dependencies: {', '.join(unmet)} - do not start this task")
    read_lines = []
    for r in ordered:
        if r == phase["path"]:
            read_lines.append(f"{r}  (own section inlined below; open only for "
                               "Assumptions, Policy, or another task)")
        else:
            read_lines.append(r)
    print("read    " + "\n        ".join(read_lines))
    print("write   " + ', '.join(task['files']))
    print("        (bounded read-only discovery is allowed; correct an insufficient brief before implementation)")
    if strict(phase):
        print('spec    ' + specification(phase))
        for name in ('Constraints', 'Assumptions', 'Policy', 'Out of scope'):
            print(name.lower() + ' ' + block(phase['blocks'], name))
        for entry in relevant_handoffs(phase, tid):
            print('handoff ' + json.dumps(entry, ensure_ascii=True))

    section = phase["sections"].get(tid, "").strip()
    if section:
        print(f"section {tid}")
        print("        " + section.replace("\n", "\n        "))

    budget = _context_budget(phase, tid, include_inherited=True)
    total = sum(budget[key] for key in ('task', 'phase', 'agents', 'inherited', 'lockfiles'))
    note = f"; {len(budget['missing'])} not yet on disk" if budget['missing'] else ""
    over = f"  -- direct task context is over the {BRIEF_TOKEN_BUDGET:,}-token soft budget (advisory)" \
        if budget['task'] > BRIEF_TOKEN_BUDGET else ""
    print(f"budget  ~{total:,} tokens (estimate, bytes/4) across {len(ordered)} file(s): "
          f"~{budget['phase']:,} phase file, ~{budget['task']:,} task files/supporting reads, "
          f"~{budget['agents']:,} shared AGENTS.md, ~{budget['inherited']:,} inherited files, "
          f"~{budget['lockfiles']:,} generated lockfiles{note}{over}")
    print("        (file inventory, not measured prompt usage; inherited files need only targeted reads; "
          "lockfiles count toward W07 only when explicitly listed in reads)")

    v = verify_line(phase, tid)
    print(f"verify  {v[len('Verify:'):].strip() if v and v.startswith('Verify:') else v}")
    log = phase["path"].replace(".md", ".log.md")
    if os.path.exists(log) and not strict(phase):
        entry = _last_log_entry(log)
        if entry:
            print(f"handoff {log}  (last entry inlined below; open the file only for more)")
            print("        " + entry.replace("\n", "\n        "))
        else:
            print(f"handoff {log}  (no parseable `## ...` entry yet; read it directly "
                  "if you need it)")
    return 1 if unmet or status != "approved" or task["status"] != "in_progress" else 0


def cmd_findings(phase, args):
    only_open = "--open" in args
    rows = [f for f in phase["forder"]
            if not only_open or phase["findings"][f]["status"] == "open"]
    if not rows:
        print("no open findings" if only_open else
              "no findings recorded; /cs-review writes them into the phase file")
        return 0
    for fid in rows:
        f = phase["findings"][fid]
        print(f"{fid:<4} {f['severity']:<9} {f['status']:<9} "
              f"{','.join(f['tasks']) or '-':<10} {f['category']}")
        print(f"     {f['desc']}")
        print(f"     fix: {f['fix']}")
        reopens = finding_reopens(phase, fid)
        if reopens:
            print(f"     reopened {reopens} time(s)")
        if reopens >= 2 and f['status'] == 'open':
            print("     escalation: previous settlements did not stick; compare the exact "
                  "requested edit with the prior notes before doing more verification")
            notes = [c for c in phase['changelog'] if c['fid'] == fid]
            for entry in notes[-3:]:
                print(f"       rev {entry['rev']} {entry['state']}: {entry['note']}")
    opened = open_findings(phase)
    print(f"{len(phase['forder'])} findings, {len(opened)} open")
    return 0


def finding_reopens(phase, fid):
    """Count settlement -> open transitions, not duplicate open log entries."""
    settled, count = False, 0
    for entry in phase['changelog']:
        if entry['fid'] != fid:
            continue
        if entry['state'] in ('resolved', 'accepted'):
            settled = True
        elif entry['state'] == 'open' and settled:
            count += 1
            settled = False
    return count


def cmd_resolve(phase, args):
    if len(args) < 2:
        die('usage: plan resolve F1 <open|resolved|accepted> "what carries the fix"')
    fid, state = args[0].upper(), args[1].lower()
    note = " ".join(args[2:]).strip()
    if fid not in phase["findings"]:
        die(f"{fid} is not a finding in this phase")
    if state not in FSTATUSES:
        die(f"state must be one of {', '.join(FSTATUSES)}")
    if state != "open" and not note:
        die(f"{fid} -> {state} needs a note naming the task or plan line that "
            "carries the fix")
    if any(char in note for char in ('|', '\n', '\r')):
        die('finding notes must be one line with no pipe characters')
    refuse_scout_evidence(note, 'review')
    note = redact(note)
    finding = phase['findings'][fid]
    if state == 'accepted' and finding['severity'] in ('Critical', 'High'):
        die('Critical and High findings must be resolved, not accepted')

    active = phase["meta"].get("active")
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = strict(phase) or intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    expected = "review" if state == "open" else "revise"
    if modern and active != expected:
        die(f"{fid} -> {state} is only valid during an active {expected} pass; "
            f"run /cs-{expected} first")
    if strict(phase) and state != 'open':
        rev = intof(phase['meta'].get('rev'), 1)
        base = intof(phase['meta'].get('active-rev'), rev)
        if rev == base and not (state == 'accepted' and finding['severity'] == 'Low'):
            die('run plan bump before resolving a finding or accepting a Medium')
    if state == 'resolved' and finding_reopens(phase, fid) >= 2:
        print(f'warning: {fid} has reopened at least twice; the settlement should name '
              'the exact target and quote the changed line (redact sensitive values). '
              'Accept a Low or Medium with a concrete reason when appropriate.', file=sys.stderr)

    pat = re.compile(r"^(\s*[-*]?\s*%s\s*\|[^|]*\|[^|]*\|[^|]*\|\s*)([A-Za-z_-]+)" % fid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + state, phase["text"])
    if not hit:
        die(f"could not find the status field of {fid}; check its line has seven "
            "pipe-separated fields")
    rev = intof(phase["meta"].get("rev"), 1)
    text = append_to_block(text, "Changelog",
                           f"rev {rev} | {fid} | {state} | {note or 'reopened'}")
    write_phase(phase, text)
    print(f"{fid} -> {state}, logged to the changelog at rev {rev}")
    return 0


def _stage_refusal(phase, message):
    cmd, why = recommend(phase)
    die(f"{message}\nnext: {cmd}\nwhy: {why}")


def cmd_begin(phase, args):
    if not args:
        die(f"usage: plan begin <{'|'.join(STAGES)}> [--resume]")
    stage = args[0].lower()
    resume = "--resume" in args[1:]
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")

    meta = phase["meta"]
    active = meta.get("active")
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0)
    status = meta.get("status", "draft")

    if active:
        if active == stage and resume:
            if stage == "revise" and _owner_id():
                _session_record(_owner_id(), "cs-revise")
            print(f"resume {stage} at rev {meta.get('active-rev', rev)}")
            return 0
        if active == stage:
            _stage_refusal(phase, f"{stage} is already active; rerun with --resume")
        _stage_refusal(phase, f"cannot begin {stage}; {active} is active")
    if resume:
        _stage_refusal(phase, f"cannot resume {stage}; no {stage} pass is active")

    opened = open_findings(phase)
    if stage == "review":
        if status != "draft" or reviewed >= rev:
            _stage_refusal(phase, f"rev {rev} is not waiting for review")
    elif stage == "revise":
        if status != "draft" or reviewed != rev or not opened:
            _stage_refusal(phase, "this phase is not waiting for revision")
        if rev >= 3 and open_findings(phase, ("Critical",)):
            _stage_refusal(phase, "round 3 still has an open Critical; re-plan the phase")
    elif stage == "approve":
        if (status != "draft" or reviewed != rev or opened or
                intof(meta.get("ready"), 0) == rev):
            _stage_refusal(phase, "this revision is not waiting for readiness checking")
    elif stage == "close":
        unfinished = [tid for tid in phase["order"]
                      if phase["tasks"][tid]["status"] != "done"]
        if status != "approved" or unfinished or opened:
            _stage_refusal(phase, "this phase is not ready to close")

    text = set_metas(phase["text"], {"active": stage, "active-rev": rev})
    if strict(phase):
        text = set_meta(text, 'active-spec', specification(phase))
        if stage == 'revise':
            # Bind acceptance-only completion to this pass, including resume.
            # Hash the expected ledger instead of retaining finding prose/PII.
            expected_findings = {fid: dict(f) for fid, f in phase['findings'].items()}
            for f in expected_findings.values():
                if f['status'] == 'open' and f['severity'] == 'Low':
                    f['status'] = 'accepted'
            snapshot = {'rev': rev, 'findings': json_digest(expected_findings),
                        'tasks': json_digest(phase['tasks']),
                        'implementation': phase_working_fingerprint(phase),
                        'index': digest(read_text(INDEX).encode()),
                        'count': len(phase['changelog']),
                        'history': json_digest(phase['changelog']),
                        'open': opened}
            transaction({revise_snapshot_path(phase): json.dumps(snapshot) + '\n',
                         phase['path']: text})
            if _owner_id():
                _session_record(_owner_id(), "cs-revise")
            print(f"begin {stage} at rev {rev}")
            return 0
    write_phase(phase, text)
    if stage == "revise" and _owner_id():
        _session_record(_owner_id(), "cs-revise")
    print(f"begin {stage} at rev {rev}")
    return 0


def _require_active(phase, stage):
    active = phase["meta"].get("active")
    if active != stage:
        _stage_refusal(phase, f"cannot finish {stage}; active stage is {active or 'none'}")


def _tick_current_phase(phase):
    rel = os.path.relpath(phase["path"], ROOT).replace(os.sep, "/")
    index_text = read_text(INDEX)
    lines = index_text.splitlines()
    hit = False
    for i, line in enumerate(lines):
        if rel in line and re.match(r"^\s*-\s*\[[ xX]\]", line):
            lines[i] = re.sub(r"^(\s*-\s*)\[[ xX]\]", r"\1[x]", line, count=1)
            hit = True
            break
    if not hit:
        die(f"PLAN.md has no phase checklist line for {rel}")
    return "\n".join(lines) + ("\n" if index_text.endswith("\n") else "")


def cmd_finish(phase, args):
    if not args:
        die(f"usage: plan finish <{'|'.join(STAGES)}> [--pass|--fail|--accept-only]")
    stage = args[0].lower()
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")
    options = args[1:]
    allowed = ({'--accept-only'} if stage == 'revise' else
               {'--pass', '--fail'} if stage in ('approve', 'close') else set())
    if len(options) != len(set(options)) or any(option not in allowed for option in options):
        expected = ('--accept-only' if stage == 'revise' else
                    '--pass or --fail' if stage in ('approve', 'close') else 'no flags')
        die(f"finish {stage} accepts {expected}")
    _require_active(phase, stage)

    rev = intof(phase["meta"].get("rev"), 1)
    active_rev = intof(phase["meta"].get("active-rev"), rev)
    text = phase["text"]

    if stage == "review":
        if rev != active_rev:
            die(f"review claimed rev {active_rev}, but phase is now rev {rev}")
        text = set_meta(text, "reviewed", rev)
        if strict(phase):
            if phase['meta'].get('active-spec') != specification(phase):
                die('specification changed during review; run plan replan')
            text = set_meta(text, 'reviewed-spec', specification(phase))
    elif stage == "revise":
        if '--accept-only' in args[1:]:
            meta = phase['meta']
            snapshot = load_json(revise_snapshot_path(phase), {})
            count = snapshot.get('count', len(phase['changelog']))
            settlements = phase['changelog'][count:]
            only_lows = bool(settlements) and all(
                c['rev'] == rev and c['state'] == 'accepted' and c['note'] and
                phase['findings'].get(c['fid'], {}).get('severity') == 'Low' and
                phase['findings'][c['fid']]['status'] == 'accepted'
                for c in settlements)
            if (not strict(phase) or rev != active_rev or
                    snapshot.get('rev') != rev or
                    snapshot.get('findings') != json_digest(phase['findings']) or
                    snapshot.get('tasks') != json_digest(phase['tasks']) or
                    snapshot.get('implementation') != phase_working_fingerprint(phase) or
                    snapshot.get('index') != digest(read_text(INDEX).encode()) or
                    snapshot.get('history') != json_digest(phase['changelog'][:count]) or
                    set(snapshot.get('open', [])) != {c['fid'] for c in settlements} or
                    intof(meta.get('reviewed'), 0) != rev or
                    meta.get('active-spec') != specification(phase) or
                    meta.get('reviewed-spec') != specification(phase) or
                    open_findings(phase) or not only_lows):
                die('accept-only requires format 2, no bump, an unchanged reviewed '
                    'specification and implementation, only reasoned Low acceptances '
                    'during this pass, and no open findings; otherwise bump and finish revise')
        elif rev != active_rev + 1:
            die("finish revise requires exactly one successful plan bump")
    elif stage in ("approve", "close"):
        passed = "--pass" in args[1:]
        failed = "--fail" in args[1:]
        if passed == failed:
            die(f"finish {stage} requires exactly one of --pass or --fail")
        errs, _ = lint_issues(phase)
        if passed and (errs or open_findings(phase)):
            die(f"cannot pass {stage}; lint errors or open findings remain")
        if failed and not (errs or open_findings(phase)):
            die(f"cannot fail {stage} without a persisted open finding or lint error")
        if stage == "approve" and passed:
            if intof(phase["meta"].get("reviewed"), 0) != rev:
                die(f"cannot mark rev {rev} ready; it has not been reviewed")
            text = set_meta(text, "ready", rev)
            if strict(phase):
                if phase['meta'].get('reviewed-spec') != specification(phase):
                    die('review is stale; run plan replan')
                text = set_meta(text, 'ready-spec', specification(phase))
        if stage == "close" and passed:
            if phase["meta"].get("status") != "approved":
                die("only an approved phase can close")
            if any(t["status"] != "done" for t in phase["tasks"].values()):
                die("cannot close while tasks remain unfinished")
            index_text = _tick_current_phase(phase)
            text = set_meta(text, "status", "closed")
            text = del_meta(text, "active", "active-rev")
            transaction({INDEX: index_text, phase['path']: del_meta(text, 'active-spec')})
            print(f"finish close --pass; {phase['meta'].get('phase', '?')} -> closed")
            return 0
        if stage == "close" and failed:
            text = set_meta(text, "status", "draft")
            text = del_meta(text, "ready")

    text = del_meta(text, "active", "active-rev", "active-spec")
    write_phase(phase, text)
    if stage == 'revise' and strict(phase):
        snapshot_path = revise_snapshot_path(phase)
        try:
            if os.path.exists(snapshot_path):
                os.unlink(snapshot_path)
        except OSError as exc:
            print(f'warning: revise finished but temporary snapshot cleanup failed: {exc}',
                  file=sys.stderr)
    outcome = (" --pass" if "--pass" in args else " --fail" if "--fail" in args
               else " --accept-only" if "--accept-only" in args else "")
    print(f"finish {stage}{outcome} at rev {rev}")
    return 0


def task_arg(args, usage):
    """A task ID such as T2. An issue number is never one: Build's contract is
    the approved phase file, and an issue reaches it only through /cs-plan."""
    if not args:
        die(f"usage: {usage}")
    tid = args[0].strip().upper()
    if not re.fullmatch(r"T\d+", tid):
        die(f"{args[0]!r} is not a task ID; pass one such as T1 from the approved "
            "phase. An issue number is never built directly: plan it with "
            "/cs-plan --issue NUMBER, then review and approve the phase.")
    return tid


def cmd_start(phase, args):
    tid = task_arg(args, "plan start T2 [--resume]")
    resume = "--resume" in args[1:]
    if phase["meta"].get("active"):
        _stage_refusal(phase, f"cannot start {tid}; {phase['meta']['active']} is active")
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]
    if phase["meta"].get("status") != "approved":
        _stage_refusal(phase, f"cannot start {tid}; phase is not approved")
    if task["status"] == "in_progress":
        if not resume:
            die(f"{tid} is already in_progress; rerun /cs-build {tid} --resume")
        # A resume is nearly always a new session, and the read gate follows
        # the claim, so the claim has to follow the session. Without this a
        # resumed build would be scoped to the dead session that stamped it.
        write_phase(phase, _set_owner(phase["text"], tid, _owner_id()))
        print(f"resume {tid}")
        return 0
    if resume:
        die(f"cannot resume {tid}; its status is {task['status']}")
    if task["status"] != "pending":
        die(f"cannot start {tid}; its status is {task['status']}")
    unmet = [d for d in task["deps"]
             if phase["tasks"].get(d, {}).get("status") != "done"]
    if unmet:
        die(f"cannot start {tid}; unmet dependencies: {', '.join(unmet)}")
    _set_status(phase, tid, "in_progress")
    return 0


def cmd_bump(phase, _args):
    if phase["meta"].get("active") != "revise":
        die("plan bump is only valid during an active revise pass")
    rev = intof(phase["meta"].get("rev"), 1)
    base = intof(phase["meta"].get("active-rev"), rev)
    if rev == base:
        rev += 1
        write_phase(phase, set_meta(phase["text"], "rev", rev))
        print(f"rev -> {rev}")
    elif rev == base + 1:
        print(f"rev already {rev}; resume did not bump again")
    else:
        die(f"active revise began at rev {base}, but current rev is {rev}")
    return 0


def cmd_reviewed(phase, _args):
    if phase["meta"].get("active") == "review":
        return cmd_finish(phase, ["review"])
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    if modern:
        die("plan reviewed requires an active review; run plan begin review first")
    rev = intof(phase["meta"].get("rev"), 1)
    if intof(phase["meta"].get("reviewed"), 0) >= rev:
        die(f"rev {rev} has already been reviewed")
    write_phase(phase, set_meta(phase["text"], "reviewed", rev))
    print(f"reviewed -> {rev} (legacy phase)")
    return 0


def cmd_done(phase, args):
    tid = task_arg(args, "plan done T2")
    task = phase["tasks"].get(tid)
    if task:
        if task["status"] != "in_progress":
            die(f"{tid} must be in_progress before it can be marked done")
        unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
        if unmet:
            die(f"{tid} depends on {', '.join(unmet)}, which are not done")
    _set_status(phase, tid, "done")
    return 0


def cmd_block(phase, args):
    tid = task_arg(args, 'plan block T2 "reason"')
    task = phase["tasks"].get(tid)
    if not task:
        die(f"{tid} is not in this phase")
    if task["status"] != "in_progress":
        die(f"{tid} must be in_progress before it can be blocked")
    if strict(phase):
        reason = redact(' '.join(args[1:]) or 'unspecified blocker')[:4096].replace('|', '/')
        text = re.sub(r'^(  ' + tid + r':.*?status:\s*)in_progress', r'\g<1>blocked', phase['text'], flags=re.M)
        text = _set_owner(text, tid, None)
        text = set_metas(text, {'status': 'draft'}, remove=('ready', 'ready-spec'))
        fid = 'F' + str(max([num(f) for f in phase['forder']] or [0]) + 1)
        text = append_to_block(text, 'Findings', f'{fid} | High | Blocker | {tid} | open | {reason} | settle workers and replan the blocked contract')
        log = phase['path'][:-3] + '.log.md'
        previous = read_text(log) if os.path.exists(log) else ''
        transaction({phase['path']: text, log: previous + f'\n## {tid} blocked\n{reason}\n'})
        print(f'{tid} -> blocked; phase -> draft; readiness cleared; run plan replan after workers settle')
        return 0
    _set_status(phase, tid, "blocked", " ".join(args[1:]) or "no reason given")
    text = read_text(phase["path"])
    text = set_meta(text, "status", "draft")
    text = del_meta(text, "ready")
    write_phase(phase, text)
    print("phase -> draft; readiness cleared")
    return 0


def cmd_version(_phase, _args):
    print(TOOL_VERSION)
    return 0


# ----------------------------------------------------------------- issue

ISSUE_FIELDS = "number,title,state,url,body,updatedAt"
ISSUE_TIMEOUT = 60
SOURCE_ISSUE_RE = re.compile(r"^issue:\s*(\S+)\s*$", re.M)
SOURCE_SHA_RE = re.compile(r"^body-sha256:\s*([0-9a-f]{64})\s*$", re.M)
SOURCE_UPDATED_RE = re.compile(r"^updated:\s*(\S+)\s*$", re.M)


def issue_body_sha256(body):
    """The snapshot hash: the body exactly as GitHub returned it, LF endings."""
    return digest((body or "").replace("\r\n", "\n").replace("\r", "\n").encode("utf-8"))


def source_issue(phase_text_):
    """(issue url, recorded body hash, recorded update time) from `## Source`."""
    _, body = split_frontmatter(phase_text_)
    source = block(parse_blocks(body), "Source")
    url = SOURCE_ISSUE_RE.search(source)
    sha = SOURCE_SHA_RE.search(source)
    updated = SOURCE_UPDATED_RE.search(source)
    return (url.group(1) if url else None, sha.group(1) if sha else None,
            updated.group(1) if updated else None)


def issue_adoptions(url):
    """Every phase file whose `## Source` records this issue, closed ones included."""
    hits = []
    for path in _phase_files():
        try:
            text = read_text(path)
        except (OSError, UnicodeDecodeError):
            continue
        cited, sha, _ = source_issue(text)
        if cited and cited.rstrip("/").lower() == url.rstrip("/").lower():
            status = re.search(r"^status:\s*(\S+)", split_frontmatter(text)[0], re.M)
            hits.append({"path": os.path.relpath(path, ROOT).replace(os.sep, "/"),
                         "status": status.group(1) if status else "draft", "sha": sha})
    return hits


def _issue_entry_guard():
    """/cs-plan's entry guard, applied before the network is touched.

    An unclosed current phase is never rewritten from an issue: changed
    requirements there go through replan, review, and human approval.
    Returns (current phase path relative to ROOT or None, PLAN.md has active: plan).
    """
    if not os.path.exists(INDEX):
        return None, False
    fm, _ = split_frontmatter(read_text(INDEX))
    planning = bool(re.search(r"^active:\s*plan\s*$", fm, re.M))
    m = re.search(r"^current:\s*(\S+)", fm, re.M)
    if not m:
        return None, planning
    path = phase_path(m.group(1))
    current = os.path.relpath(path, ROOT).replace(os.sep, "/")
    if not os.path.exists(path):
        return current, planning
    status = read_phase(path)["meta"].get("status", "draft")
    if status != "closed":
        die(f"current phase {m.group(1)} is {status}; an unclosed phase cannot be "
            "replanned from an issue. Finish or close it first, or take changed "
            "requirements through plan replan, review, and human approval. "
            "Nothing was fetched or written.")
    return current, planning


def fetch_issue(number):
    """The issue as `gh` reports it for the checkout's repository, or die."""
    gh = shutil.which("gh")
    if not gh:
        die("GitHub CLI `gh` is not installed or not on PATH; cannot fetch issue "
            f"#{number}. Nothing was written.")
    try:
        proc = subprocess.run([gh, "issue", "view", str(number), "--json", ISSUE_FIELDS],
                              cwd=ROOT, capture_output=True, timeout=ISSUE_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as exc:
        die(f"gh could not fetch issue #{number}: {redact(str(exc))}. Nothing was written.")
    out = proc.stdout.decode("utf-8", "replace")
    err = proc.stderr.decode("utf-8", "replace").strip()
    if proc.returncode != 0:
        die(f"gh could not fetch issue #{number} (exit {proc.returncode}): "
            f"{redact(err)[:2000] or 'no error output'}. Check `gh auth status` and "
            "that this checkout has a GitHub remote. Nothing was written.")
    try:
        issue = json.loads(out)
    except ValueError:
        die(f"gh returned unreadable output for issue #{number}. Nothing was written.")
    if not isinstance(issue, dict):
        die(f"gh returned unexpected output for issue #{number}. Nothing was written.")
    missing = [k for k in ISSUE_FIELDS.split(",") if k not in issue]
    if missing:
        die(f"gh output for issue #{number} lacks {', '.join(missing)}. Nothing was written.")
    if intof(issue.get("number"), -1) != number:
        die(f"gh returned issue {issue.get('number')!r}, not #{number}. Nothing was written.")
    if not re.match(r"^https://[^/\s]+/[^/\s]+/[^/\s]+/issues/\d+$", str(issue["url"])):
        die(f"gh returned an unexpected issue URL {issue['url']!r}. Nothing was written.")
    return issue


def cmd_issue(_phase, args):
    """Read-only intake for /cs-plan --issue. Writes nothing, ever.

    Order matters: the entry guard runs before the network, and every
    refusal happens before /cs-plan claims `active: plan` or writes a phase.
    """
    resume = "--resume" in args
    rest = [a for a in args if a != "--resume"]
    raw = rest[0].lstrip("#") if len(rest) == 1 else ""
    if not re.fullmatch(r"[1-9]\d*", raw):
        die("usage: plan issue NUMBER [--resume]  (an issue in this checkout's GitHub repository)")
    number = int(raw)
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass
    current, planning = _issue_entry_guard()
    if planning and not resume:
        die("PLAN.md has active: plan; rerun /cs-plan --issue "
            f"{number} --resume to continue the interrupted planning pass. "
            "Nothing was fetched or written.")
    issue = fetch_issue(number)
    state = str(issue["state"]).upper()
    if state != "OPEN":
        die(f"issue #{number} is {state.lower()}; only an open issue can be planned. "
            "Nothing was written.")
    url = issue["url"]
    sha = issue_body_sha256(issue["body"])
    adopted = issue_adoptions(url)
    # An interrupted /cs-plan --issue pass writes its draft phase before it
    # moves `current:`. Resuming that pass is not a second adoption.
    resuming = [h for h in adopted if resume and planning and
                h["status"] == "draft" and h["path"] != current]
    adopted = [h for h in adopted if h not in resuming]
    if adopted:
        lines = []
        for hit in adopted:
            same = "same body" if hit["sha"] == sha else "issue body changed since"
            lines.append(f"  {hit['path']} (status {hit['status']}, {same})")
        die(f"issue #{number} is already adopted by a phase; it is not planned twice:\n"
            + "\n".join(lines) + "\n"
            f"  current snapshot: updated {issue['updatedAt']}, body-sha256 {sha}\n"
            "  An open phase takes changed requirements only through plan replan, "
            "review, and human approval. A closed phase is history: capture remaining "
            "or new work as a new issue. Nothing was written.")
    title = " ".join(str(issue["title"]).split())
    print(f"issue       {url}")
    print(f"state       {state.lower()}")
    print(f"title       {title}")
    print(f"updated     {issue['updatedAt']}")
    print(f"body-sha256 {sha}")
    print("adopted-by  " + (", ".join(h["path"] + " (resuming this draft)"
                                       for h in resuming) or "none"))
    print()
    print("Copy this block into the new phase as its `## Source` section:")
    print()
    print("## Source")
    print()
    print(f"issue: {url}")
    print(f"title: {title}")
    print(f"updated: {issue['updatedAt']}")
    print(f"body-sha256: {sha}")
    print()
    print("Provenance only. This phase, not the issue, is the Build contract; later")
    print("issue edits change nothing here without replan, review, and human approval.")
    print()
    print("----- issue body: proposed requirements, not an approved plan -----")
    print(str(issue["body"]).replace("\r\n", "\n").rstrip("\n"))
    print("----- end issue body -----")
    return 0


# --------------------------------------------------------------- metrics

def _phase_files():
    """Every phase file on disk, `.log.md` handoffs excluded."""
    plans_dir = os.path.join(ROOT, "docs", "plans")
    try:
        paths = glob.glob(os.path.join(plans_dir, "*.md"))
    except OSError:
        return []
    return sorted(p for p in paths if not p.endswith(".log.md"))


def _load_phases():
    """Every phase file that parses, skipping any that don't.

    Unlike every other subcommand, metrics has no single `current:` phase to
    trust: it reads the whole `docs/plans/` directory, so one unreadable or
    malformed file must not take the rest of the report down with it.
    """
    phases = []
    for path in _phase_files():
        try:
            phases.append(read_phase(path))
        except Exception:
            continue
    return phases


def _git_cycle_days(path):
    """Days between a phase file's first and most recent commit, or None.

    None covers every way this can't be answered -- git missing, the path
    outside a repo, the file never committed -- so metrics degrades to "n/a"
    for that phase rather than failing the whole report.
    """
    rel = os.path.relpath(path, ROOT)
    try:
        result = subprocess.run(
            ["git", "-C", ROOT, "log", "--follow", "--format=%aI", "--", rel],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    stamps = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(stamps) < 2:
        return None
    try:
        parsed = sorted(datetime.fromisoformat(s) for s in stamps)
    except ValueError:
        return None
    return (parsed[-1] - parsed[0]).total_seconds() / 86400.0


def _fmt_avg(values, unit=""):
    if not values:
        return "n/a"
    return f"avg {sum(values) / len(values):.1f}{unit} ({len(values)} phase(s))"


def cmd_metrics(_phase, _args):
    """Deterministic metrics over every phase file, for the Stage 6 loopback.

    Scans docs/plans/*.md directly rather than the current phase, so -- like
    guard -- it must fail open: no docs/plans directory, no PLAN.md, or a
    repo that hasn't adopted coldsession yet all exit 0 with nothing to
    report, never a traceback.
    """
    try:
        phases = _load_phases()
    except Exception:
        return 0
    if not phases:
        print("no phase files under docs/plans/; nothing to report")
        return 0

    closed = [p for p in phases if p["meta"].get("status") == "closed"]
    approved = [p for p in phases if p["meta"].get("status") == "approved"]
    draft = len(phases) - len(closed) - len(approved)

    print(f"phases   {len(phases)} scanned "
          f"({len(closed)} closed, {len(approved)} approved, {draft} draft)")

    print("\nleading indicators")

    revisions = [intof(p["meta"].get("ready"), 0) - 1
                 for p in phases if p["meta"].get("ready") is not None]
    print(f"  revisions to approval   {_fmt_avg(revisions)}")

    if revisions:
        first_pass = sum(1 for r in revisions if r == 0)
        rate = 100.0 * first_pass / len(revisions)
        print(f"  first-pass approve rate {rate:.0f}% ({first_pass} of {len(revisions)})")
    else:
        print("  first-pass approve rate n/a (no phase has an approved revision yet)")

    blocked_counts = [sum(1 for t in p["tasks"].values() if t["status"] == "blocked")
                       for p in phases]
    phases_with_blocked = sum(1 for c in blocked_counts if c)
    print(f"  tasks blocked           {sum(blocked_counts)} total across "
          f"{phases_with_blocked} of {len(phases)} phase(s)")

    rounds = [intof(p["meta"].get("rev"), 1) for p in phases]
    print(f"  review rounds           {_fmt_avg(rounds)}")

    task_tokens, over_budget = [], 0
    for p in phases:
        for tid in p["order"]:
            # metrics scans every phase file on disk, including ones this
            # tool never validated the shape of, so -- like _load_phases()
            # skipping a phase that doesn't parse -- one task whose
            # dependency graph is pathological (deep enough to blow the
            # recursion limit) must not take the rest of the report down.
            try:
                tokens = _context_budget(p, tid)['task']
            except Exception:
                continue
            task_tokens.append(tokens)
            if tokens > BRIEF_TOKEN_BUDGET:
                over_budget += 1
    if task_tokens:
        avg = sum(task_tokens) / len(task_tokens)
        print(f"  task context budget     avg ~{avg:,.0f} tokens/task, task files/supporting reads "
              f"({over_budget} of {len(task_tokens)} over the "
              f"{BRIEF_TOKEN_BUDGET:,}-token budget)")
    else:
        print("  task context budget     n/a (no tasks found)")

    print("\nlagging indicators")

    by_sev = {}
    for p in phases:
        for f in p["findings"].values():
            by_sev[f["severity"]] = by_sev.get(f["severity"], 0) + 1
    total_findings = sum(by_sev.values())
    if total_findings:
        sev_line = ", ".join(f"{sev} {by_sev[sev]}" for sev in SEVERITIES if sev in by_sev)
        print(f"  findings by severity    {sev_line} ({total_findings} total)")
    else:
        print("  findings by severity    none recorded")

    reopened = sum(finding_reopens(p, fid) for p in closed for fid in p['forder'])
    print(f"  findings reopened       {reopened} (across {len(closed)} closed phase(s))")
    repeated = [f"{p['meta'].get('phase', '?')}/{fid} ({finding_reopens(p, fid)})"
                for p in phases for fid in open_findings(p) if finding_reopens(p, fid) >= 2]
    print(f"  repeated open findings  {', '.join(repeated) if repeated else 'none'}")

    resolved = sum(1 for p in phases for f in p["findings"].values()
                   if f["status"] == "resolved")
    accepted = sum(1 for p in phases for f in p["findings"].values()
                   if f["status"] == "accepted")
    if resolved + accepted:
        share = 100.0 * resolved / (resolved + accepted)
        print(f"  resolved vs accepted    {resolved} resolved, {accepted} accepted "
              f"({share:.0f}% resolved)")
        low_resolved = sum(1 for p in phases for f in p['findings'].values()
                           if f['severity'] == 'Low' and f['status'] == 'resolved')
        if not accepted and low_resolved:
            print('  acceptance use          no acceptances despite resolved Lows; inspect '
                  'for avoidable prose churn (there is no target acceptance rate)')
    else:
        print("  resolved vs accepted    n/a (no closed findings yet)")

    cycle_days = [d for d in (_git_cycle_days(p["path"]) for p in closed) if d is not None]
    if cycle_days:
        print(f"  phase cycle time        {_fmt_avg(cycle_days, 'd')} (git-tracked, closed)")
    else:
        print("  phase cycle time        n/a (no closed phase is tracked in git history)")

    return 0


# ----------------------------------------------------------------- guard

# Advisory prompt text asks a model to honour these rules; `plan guard` is the
# deterministic layer behind it, called from .claude/hooks/ on the Claude
# surface. Codex has no hook mechanism, so there the same rules stay advisory.
#
# Every path through guard fails open. It runs on every prompt and every file
# tool call in whatever repository the user happens to be in, including one
# that has never heard of coldsession, so absent, unreadable, or ambiguous
# plan state must exit 0 in silence. Deny only on a positive match.

GUARD_KINDS = ("read", "write", "lint", "stage")
AUTHORING_COMMANDS = ("cs-plan", "cs-revise")
JUDGING_COMMANDS = ("cs-review", "cs-approve", "cs-close")
# Typed by the human; the prompt hook, not the agent, writes the approval.
GRANT_COMMAND = "cs-grant"
# A 2.x compatibility alias runs the stage it aliases, so it has to face the
# same gate. Resolved to the canonical name before anything is checked or
# recorded: a gate that named only the canonical commands was one rename away
# from bypassable, and a session log that recorded both spellings would leave
# the same hole for whatever consults it next.
COMMAND_ALIASES = {"cs-recheck": "cs-review"}
CS_COMMAND_RE = re.compile(r"^[/$]?(cs-[a-z-]+)\b")
APPROVED_RE = re.compile(r"^status:\s*approved\s*$", re.M)


def _guard_deny(code, message, hint=""):
    """Exit 2 with the reason on stderr, which is what a hook feeds back."""
    print(f"{code} {message}", file=sys.stderr)
    if hint:
        print(f"  {hint}", file=sys.stderr)
    return 2


def _guard_phase():
    """The current phase, or None the moment anything is unclear.

    Deliberately not read_index(): that calls die() on a missing PLAN.md or a
    dangling `current:` pointer, and a guard that exits 1 there would break
    every session in every repository that does not use coldsession.
    """
    try:
        if not os.path.exists(INDEX):
            return None
        fm, _ = split_frontmatter(read_text(INDEX))
        m = re.search(r"^current:\s*(\S+)", fm, re.M)
        if not m:
            return None
        path = scope_path(m.group(1))
        plans = os.path.normcase(os.path.realpath(os.path.join(ROOT, 'docs', 'plans')))
        if not path.startswith(plans + os.sep) or not path.endswith('.md') or path.endswith('.log.md'):
            return None
        if not os.path.exists(path):
            return None
        return read_phase(path)
    except Exception:
        return None


def _guard_payload():
    """The hook event JSON on stdin, or {} when there is none.

    Hooks pipe the event in rather than passing arguments, so the shell
    wrappers stay trivial and every field is parsed in one place. The
    argument forms (`plan guard read src/a.py`) exist for humans and tests,
    and take precedence over anything on stdin.

    Decoded from bytes as utf-8-sig rather than read as text, for the reason
    read_text() gives: Windows PowerShell prepends a BOM when it pipes to a
    native command, and a BOM ahead of the opening brace makes json.loads
    raise -- which, because guard fails open, would turn every gate on that
    platform into a silent no-op. Reading bytes also keeps a non-ASCII path
    intact when the console codepage is not UTF-8.
    """
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        stream = getattr(sys.stdin, "buffer", None)
        raw = stream.read().decode("utf-8-sig", "replace") if stream else sys.stdin.read()
    except Exception:
        return {}
    raw = raw.strip()
    if not raw:
        return {}
    try:
        data = json.loads(raw)
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def _guard_norm(path):
    """One comparable form for a path: absolute against ROOT, case-folded."""
    if not path or not isinstance(path, str):
        return None
    try:
        p = os.path.expanduser(path.replace('\\', os.sep))
        if not os.path.isabs(p):
            p = os.path.join(ROOT, p)
        return os.path.normcase(os.path.realpath(p))
    except Exception:
        return None


def _guard_scope(phase, owner=None):
    """(in-progress task ids, allowed paths), or None when no build is running.

    `plan start` stamps the calling session onto the task it claims, so when
    the caller owns exactly the tasks it started, the gate scopes to those and
    the bounded-read contract stays as tight with six build sessions running
    as with one.

    Everything else falls back to the union of every in-progress task's read
    set: an unstamped claim from a pre-1.5 phase file, a Codex session that
    has no id to stamp, or a caller Orca and Claude Code both declined to
    name. The union is looser but never wrong, which is the trade guard makes
    everywhere -- it denies only on a positive match.

    PLAN.md and the phase handoff log join the set because a build session
    legitimately reads the index and appends to the log, and neither appears
    in any task's `files`.
    """
    if phase is None:
        return None
    active = [t for t in phase["order"] if phase["tasks"][t]["status"] == "in_progress"]
    if not active:
        return None
    if owner:
        mine = [t for t in active if phase["tasks"][t].get("owner") == owner]
        if mine:
            active = mine
    paths = {_guard_norm(INDEX), _guard_norm(phase["path"]),
             _guard_norm(phase["path"][:-3] + ".log.md")}
    for tid in active:
        for entry in read_set(phase, tid):
            paths.add(_guard_norm(entry))
    paths.discard(None)
    return active, paths


def _guard_read(phase, path, owner=None):
    scope = _guard_scope(phase, owner)
    if scope is None:
        return 0
    active, allowed = scope
    target = _guard_norm(path)
    root = _guard_norm(ROOT)
    if target is None or root is None or target in allowed:
        return 0
    if not target.startswith(root + os.sep):
        # Outside the project. What this gate enforces is "the files of this
        # repository, as listed in the brief"; a path outside it is not
        # something a phase file can describe, so it is not guard's to refuse.
        # Denying here buys little and false-positives on scratch space, and a
        # false positive on the happy path is the worse failure.
        return 0
    return _guard_deny(
        "E23",
        f"{os.path.relpath(target, root)} is not in the brief for "
        f"{', '.join(active)}",
        f"run `plan brief {active[0]}` for the read list. A file the task "
        "needs and the brief omits is a plan finding, not permission to "
        "widen context.")


def _guard_write(phase, path, payload):
    """Refuse the edit that sets `status: approved`.

    /cs-approve deliberately cannot approve: a clean pass writes `ready:
    <rev>` and the human sets the status. That is the one line in the
    workflow no agent may write, so it is checked rather than requested.

    Only an edit that *introduces* the line is refused. An edit that carries
    an already-approved status line through untouched is not an approval.
    """
    if phase is None:
        return 0
    root = _guard_norm(ROOT)
    target = _guard_norm(path)
    plans = _guard_norm(os.path.join(ROOT, "docs", "plans"))
    if target is None or plans is None or not target.startswith(plans + os.sep):
        return 0

    tool_input = payload.get("tool_input")
    tool_input = tool_input if isinstance(tool_input, dict) else {}
    try:
        before = read_text(target) if os.path.exists(target) else ""
    except Exception:
        before = ""

    edits = []
    if isinstance(tool_input.get("content"), str):
        edits.append((before, tool_input["content"]))
    if isinstance(tool_input.get("new_string"), str):
        edits.append((tool_input.get("old_string") or "", tool_input["new_string"]))
    for item in tool_input.get("edits") or []:
        if isinstance(item, dict) and isinstance(item.get("new_string"), str):
            edits.append((item.get("old_string") or "", item["new_string"]))

    for old, new in edits:
        if APPROVED_RE.search(new) and not APPROVED_RE.search(old):
            return _guard_deny(
                "E24",
                "an agent may not set `status: approved` in "
                f"{os.path.relpath(target, root)}",
                "/cs-approve writes `ready: <rev>` and stops. The human sets "
                "the status; that separation is the point of the checklist.")
    return 0


def _guard_phase_at(path):
    """The phase file just written, or None when it is not one of ours.

    Deliberately not `current:`. The hook fires on every Edit|Write, and the
    write that most needs linting is the next phase file -- /cs-plan writes
    it and only then moves the pointer, so keying on the pointer left the
    freshly authored file as the one file the gate could not see. The first
    /cs-plan of a project writes a phase file before PLAN.md exists at all.

    Widening past the pointer must not widen past coldsession, so the match
    is positive and made on the file itself: a `.md` under docs/plans/, not a
    `.log.md` handoff, that parses and declares a `phase:` in its
    frontmatter. A repository keeping unrelated markdown there gets nothing.
    """
    target = _guard_norm(path)
    plans = _guard_norm(os.path.join(ROOT, "docs", "plans"))
    if target is None or plans is None:
        return None
    if not target.startswith(plans + os.sep):
        return None
    if not target.endswith(".md") or target.endswith(".log.md"):
        return None
    try:
        phase = read_phase(target)
    except Exception:
        return None
    return phase if phase["meta"].get("phase") else None


def _guard_lint(path):
    """Surface a shape error on the write that caused it.

    Errors only -- `plan lint` exits non-zero on E-codes alone -- so a phase
    still being drafted does not fire on every intermediate save.
    """
    phase = _guard_phase_at(path)
    if phase is None:
        return 0
    target = phase["path"]
    try:
        errs, _ = lint_issues(phase)
    except Exception:
        return 0
    if not errs:
        return 0
    print(f"E-codes in {os.path.relpath(target, _guard_norm(ROOT))}:", file=sys.stderr)
    for line in errs:
        print(f"  {line}", file=sys.stderr)
    print("  fix these now rather than spending a review round on them.",
          file=sys.stderr)
    return 2


def _session_dir():
    base = os.environ.get("PLAN_SESSION_DIR")
    if base:
        return base
    return os.path.join(tempfile.gettempdir(), "coldsession-sessions")


def _session_log(session):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(session))[:120]
    return os.path.join(_session_dir(), safe + ".txt")


def _session_ran(session):
    try:
        with open(_session_log(session), encoding="utf-8") as handle:
            return [line.strip() for line in handle if line.strip()]
    except OSError:
        return []


def _session_record(session, command):
    try:
        os.makedirs(_session_dir(), exist_ok=True)
        with open(_session_log(session), "a", encoding="utf-8") as handle:
            handle.write(command + "\n")
    except OSError:
        pass


def _split_session(args):
    """(session id or None, the remaining arguments)."""
    rest = list(args)
    if "--session" not in rest:
        return None, rest
    i = rest.index("--session")
    session = rest[i + 1] if i + 1 < len(rest) else None
    return session, rest[:i] + rest[i + 2:]


def _guard_stage(args, payload):
    """Keep the judging commands cold.

    A review written in the session that wrote the plan has the right wording
    and none of the independence, which is worse than no review: it looks like
    one. The rule is the product's core claim, and until now was only ever
    asked for in prose.

    State is one line per command in a temp file keyed on the session id --
    sessions are ephemeral and so is this. No session id, and no readable
    plan state to judge against, both mean no basis to refuse, so both exit 0.
    """
    session, rest = _split_session(args)
    if session is None:
        session = payload.get("session_id")
    prompt = rest[0] if rest else payload.get("prompt")
    if not isinstance(prompt, str):
        return 0

    m = CS_COMMAND_RE.match(prompt.strip())
    if not m:
        return 0
    command = COMMAND_ALIASES.get(m.group(1), m.group(1))

    # Before the session check: a grant needs a human prompt, not a session id.
    # Only the hook's event on stdin counts; the argument form is not an
    # approve button for anything that can run `plan`.
    if command == GRANT_COMMAND:
        return _grant_approval() if not rest else 0
    if not session:
        return 0

    if command in JUDGING_COMMANDS:
        authored = [c for c in _session_ran(session) if c in AUTHORING_COMMANDS]
        # Session history alone is not grounds to refuse. Everything else in
        # guard reads plan state before it denies; this did not, so a stray
        # session log was enough to gate /cs-review in a repository that has
        # no PLAN.md and never adopted coldsession. Checked here rather than
        # at the top of the function because /cs-plan legitimately runs
        # *before* PLAN.md exists -- it is the command that writes it -- so
        # the command still has to be recorded, and only the denial waits for
        # state that can justify it.
        if authored and _guard_phase() is not None:
            return _guard_deny(
                "E25",
                f"/{command} cannot run in the session that ran /{authored[0]}",
                "every step that judges the previous one runs cold. Exit this "
                f"session and run /{command} in a new one; the phase file "
                "carries everything it needs.")
    _session_record(session, command)
    return 0


def _grant_approval():
    """Set `status: approved` because the human typed /cs-grant.

    The approval line is the one edit no agent may make, which strands a human
    who cannot reach an editor -- on a phone, in a remote session, or with the
    file open only inside an agent's worktree. A UserPromptSubmit hook is the
    one place the product can tell the human apart from the agent: it sees the
    prompt the human submitted, before any model turn, and no tool call can
    produce one. So the hook writes the line itself and the agent never does.

    It approves exactly what /cs-approve marked ready and nothing newer, so a
    grant can never stand in for a check that did not run. Refusals exit 2,
    which blocks the prompt and shows the reason to the human who typed it.
    """
    if _guard_phase() is None:
        return 0
    if os.environ.get('CS_WORKER_ASSIGNMENT'):
        return _guard_deny('E34', '/cs-grant cannot run in a worker session',
                           'grant approval from your own session')
    lock = _lock_acquire(INDEX)
    try:
        phase = _guard_phase()
        if phase is None:
            return _guard_deny('E34', '/cs-grant cannot read the current phase',
                               'run plan doctor, then retry')
        meta = phase['meta']
        name = meta.get('phase', '?')
        rev = intof(meta.get('rev'), 1)
        status = meta.get('status', 'draft')
        if status == 'approved':
            print(f"coldsession: {name} rev {rev} is already approved; nothing to grant.")
            return 0
        reason = None
        if status != 'draft':
            reason = f"{name} is {status}, not a draft awaiting approval"
        elif meta.get('active'):
            reason = f"{meta['active']} is still active; finish it first"
        elif intof(meta.get('ready'), 0) != rev:
            reason = f"rev {rev} has not passed /cs-approve; run it in a new session first"
        elif strict(phase) and meta.get('ready-spec') != specification(phase):
            reason = 'the specification changed after /cs-approve; run plan replan'
        elif open_findings(phase):
            reason = f"open findings remain: {', '.join(open_findings(phase))}"
        elif lint_issues(phase)[0]:
            reason = 'plan lint reports errors; fix them first'
        if reason:
            return _guard_deny('E34', f'/cs-grant refused: {reason}',
                               'nothing was approved.')
        write_phase(phase, set_meta(phase['text'], 'status', 'approved'))
    finally:
        _lock_release(lock)
    print(f"coldsession: the human approved {name} rev {rev} with /cs-grant; "
          "status is now approved. Do not edit the phase file.")
    return 0


def cmd_guard(_phase, args):
    """Deterministic gates behind the workflow's advisory rules.

      plan guard read  [PATH]                 bounded reads
      plan guard write [PATH]                 human-only approval
      plan guard lint  [PATH]                 lint on write
      plan guard stage [CMD] [--session ID]   cold judging sessions

    With no PATH or CMD the event is read as hook JSON on stdin.
    """
    if not args or args[0] not in GUARD_KINDS:
        # Silently. Guard has no caller but a hook, and a hook's stderr is
        # fed back to the model -- on UserPromptSubmit and PreToolUse it
        # arrives mid-turn, in whatever the user was actually doing. Usage
        # text belongs in `plan --help`, which lists the kinds, and not in
        # someone else's conversation.
        return 0
    kind, rest = args[0], args[1:]

    # Read stdin only when the arguments do not already answer the question.
    # A hook passes everything on stdin; a human passes it on the command
    # line and should not have the call block waiting for input that is
    # never coming.
    if kind == "stage":
        session, tail = _split_session(rest)
        needs_stdin = not (session and tail)
    else:
        needs_stdin = not rest or kind == "write"
    payload = _guard_payload() if needs_stdin else {}

    if kind != 'stage':
        normalized = normalize_event(payload)
        phase = _guard_phase()
        if phase and strict(phase):
            try:
                return strict_guard(phase, kind, rest, normalized)
            except (OSError, ValueError, TypeError, KeyError, AttributeError):
                return _guard_deny('E31', 'cannot validate hook payload or workflow state', 'run plan doctor and repair state before mutation')
        if phase is None and os.path.exists(INDEX) and kind == 'write':
            return _guard_deny('E31', 'cannot validate current workflow state', 'run plan doctor; repair PLAN.md before mutations')

    if kind == "stage":
        try:
            return _guard_stage(rest, payload)
        except Exception:
            return 0

    path = rest[0] if rest else None
    if path is None:
        tool_input = payload.get("tool_input")
        if isinstance(tool_input, dict):
            path = tool_input.get("file_path") or tool_input.get("path")
    if not path:
        return 0

    try:
        # lint decides from the written file alone, so it never pays for the
        # index read -- and this hook fires on every Edit and Write.
        if kind == "lint":
            return _guard_lint(path)
        phase = _guard_phase()
        if kind == "read":
            # The environment first, so the gate resolves the caller exactly
            # the way `plan start` did when it stamped the claim. The event's
            # session_id is the backstop for a surface that hands a hook the
            # id without also exporting it.
            owner = _owner_id() or payload.get("session_id")
            return _guard_read(phase, path, owner if isinstance(owner, str) else None)
        return _guard_write(phase, path, payload)
    except Exception:
        return 0


# ------------------------------------------------------------------ locking

# Every mutation is a read-modify-write of the whole phase file: main() parses
# it, the command edits that text, write_phase puts it back. Two commands whose
# spans overlap therefore lose one of the two writes, and `plan done T2` racing
# `plan done T3` from two build sessions is exactly the shape parallel builds
# produce. The lock spans the whole command rather than write_phase alone,
# because by the time write_phase runs the stale read has already happened.
#
# Read-only commands take no lock, and `guard` above all: it runs on every file
# tool call, and a gate that can block or fail is worse than no gate.

LOCK_TIMEOUT = 10.0
LOCK_STALE = 60.0


def _lock_dir():
    base = os.environ.get("PLAN_LOCK_DIR")
    if base:
        return base
    return os.path.join(tempfile.gettempdir(), "coldsession-locks")


def _lock_path(phase_path):
    """One lock file per phase file, keyed on its absolute path.

    Hashed and kept out of the repository: a lock is per-machine and
    ephemeral, so it has no business being a file the project can commit.
    """
    key = hashlib.sha256(os.path.normcase(os.path.realpath(phase_path)).encode("utf-8")).hexdigest()
    return os.path.join(_lock_dir(), key[:32] + ".lock")


def _lock_age(path):
    """Seconds since the lock was taken, or None if it is already gone.

    Deliberately os.stat rather than reading the file. On Windows CPython
    opens a file for reading without FILE_SHARE_DELETE, so a waiter that
    read the lock on every retry would make the holder's own unlink fail with
    a sharing violation -- orphaning the lock and stalling every waiter until
    the stale threshold. os.stat shares delete access and never blocks it.
    """
    try:
        return max(0.0, time.time() - os.stat(path).st_mtime)
    except OSError:
        return None


def _lock_pid(path):
    """The holder's pid, for the refusal message only. Best effort."""
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().split(" ")[0] or None
    except OSError:
        return None


def _lock_acquire(phase_path):
    """Claim one phase file for the length of one command.

    O_EXCL is the portable primitive: atomic on both platforms, no third-party
    file locking, and it leaves the holder's pid on disk for the error message.

    Returns the lock path. Unavailable locking refuses mutation. Locks never
    expire by age; interrupted processes require explicit operator recovery.
    """
    path = _lock_path(phase_path)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError as exc:
        die(f'cannot establish mutation lock: {exc}')
    deadline = time.monotonic() + LOCK_TIMEOUT
    while True:
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            pass
        except OSError as exc:
            die(f'cannot establish mutation lock: {exc}')
        else:
            try:
                os.write(fd, f"{os.getpid()} {time.time():.0f}".encode("utf-8"))
            finally:
                os.close(fd)
            return path

        if time.monotonic() >= deadline:
            die(f"another plan command is holding this phase "
                f"(pid {_lock_pid(path) or '?'}).\n"
                "  Wait for it to finish and rerun this command.\n"
                f"  If nothing is running, delete {path}.")
        time.sleep(0.05)


def _lock_release(path):
    """Drop the claim, retrying briefly.

    A single swallowed failure here is not a lost write but a lock nobody
    holds and nobody can take, which stalls every waiter until the stale
    threshold. Windows can still refuse the unlink if something has the file
    open for the moment, so give it a few tries before giving up.
    """
    if not path:
        return
    for _ in range(20):
        try:
            os.unlink(path)
            return
        except FileNotFoundError:
            return
        except OSError:
            time.sleep(0.01)


# -------------------------------------------------------- version 2 contract

def strict(phase):
    return phase['meta'].get('workflow-rev', '1').split('.')[0] == '2'


def normalize_event(payload):
    data = payload.get('tool_input', payload.get('input', payload.get('arguments', {})))
    if isinstance(data, str):
        try:
            data = json.loads(data)
        except ValueError:
            data = {'patch': data}
    if not isinstance(data, dict):
        data = {}
    return {'tool_name': payload.get('tool_name', payload.get('name', '')),
            'tool_input': data, 'session_id': payload.get('session_id', payload.get('thread_id'))}


def sensitive(path):
    parts = path.replace('\\', '/').lower().split('/')
    leaf = parts[-1]
    return ('.git' in parts or '.ssh' in parts or leaf == '.env' or
            (leaf.startswith('.env.') and leaf not in ('.env.example', '.env.sample')) or
            leaf.endswith(('.pem', '.key', '.p12')) or leaf in ('credentials', 'credentials.json'))


def temporary_scratch_path(path):
    """Whether PATH is inside Claude's harness-provided temporary scratchpad."""
    target = _guard_norm(path)
    temp = _guard_norm(tempfile.gettempdir())
    if not target or not temp or not target.startswith(temp + os.sep):
        return False
    parts = os.path.relpath(target, temp).replace('\\', '/').lower().split('/')
    try:
        scratch = parts.index('scratchpad')
    except ValueError:
        return False
    return scratch < len(parts) - 1 and any(
        part == 'claude' or part.startswith('claude-') for part in parts[:scratch])


def strict_guard(phase, kind, args, payload):
    data = payload['tool_input']
    tool_name = str(payload.get('tool_name') or '').lower()
    if kind == 'lint':
        return _guard_lint(args[0] if args else data.get('file_path', data.get('path')))
    # Shell payloads are programs, not path declarations. Inferring every file
    # they may touch made Build unusable without creating a security boundary.
    # Native harness permissions remain authoritative for shell execution.
    if kind == 'write' and tool_name in ('bash', 'powershell', 'exec_command', 'shell_command'):
        return 0
    paths = [args[0]] if args else [data.get('file_path', data.get('path'))]
    patch = data.get('patch', data.get('input', ''))
    if isinstance(patch, str) and '*** Begin Patch' in patch:
        paths = re.findall(r'^\*\*\* (?:Update File|Add File|Delete File|Move to): (.+)$', patch, re.M)
        if re.search(r'^\+status:\s*approved\s*$', patch, re.M):
            return _guard_deny('E24', 'an agent may not approve a phase', 'human approval is required')
    tasks = [tid for tid, t in phase['tasks'].items() if t['status'] == 'in_progress']
    if tasks and kind == 'write' and phase['meta'].get('ready-spec') != specification(phase):
        return _guard_deny('E29', 'approved specification changed, including resolved scope paths', 'settle work and run plan replan')
    owner = os.environ.get('CS_WORKER_ASSIGNMENT') or _owner_id() or payload.get('session_id')
    if owner:
        assignments = load_json(assignment_path(phase), {})
        mine = [tid for tid in tasks if phase['tasks'][tid].get('owner') == owner or
                owner in (assignments.get(tid, {}).get('assignment'), assignments.get(tid, {}).get('worker'))]
        if mine:
            tasks = mine
        elif tasks and not (len(tasks) == 1 and not phase['tasks'][tasks[0]].get('owner')) and not any(
                a.get('coordinator') == owner for a in assignments.values()):
            return _guard_deny('E32', 'session does not own an active task', 'use the coordinator or explicitly resume the correct claim')
    if kind == 'write' and not any(paths):
        return _guard_deny('E31', 'write payload has no verifiable paths', 'use a supported scoped file tool')
    if kind == 'read' and tasks and tool_name in ('read', 'read_file', 'grep') and not any(paths):
        return _guard_deny('E31', 'read payload has no verifiable path',
                           'name one file from the task brief; filename-only discovery remains available')
    for path in filter(None, paths):
        if sensitive(path):
            return _guard_deny('E33', 'sensitive file access is restricted', 'use project-approved secret handling')
        target = _guard_norm(path)
        root = _guard_norm(ROOT)
        if not target or not target.startswith(root + os.sep):
            if kind == 'write' and temporary_scratch_path(path):
                continue
            return _guard_deny('E26', 'path escapes repository after resolving links', 'use repository file paths')
        if kind == 'write':
            denied = _guard_write(phase, path, payload)
            if denied:
                return denied
        if tasks:
            allowed = set()
            for tid in tasks:
                entries = phase['tasks'][tid]['files'] if kind == 'write' else read_set(phase, tid)
                allowed.update(_guard_norm(p) for p in entries)
            if kind == 'read':
                allowed.add(_guard_norm(INDEX))
            if target not in allowed:
                return _guard_deny('E23', f'{kind} outside task scope: {path}',
                                   'correct an insufficient brief through replan before implementation')
    return 0


def scope_path(value):
    """Exact repository file, with links/junctions resolved before authorization."""
    value = value.replace('\\', '/')
    if (not value or value.startswith('/') or re.match(r'^[A-Za-z]:', value)
            or any(p in ('..', '.', '') for p in value.split('/'))
            or any(c in value for c in '*?[]:')):
        raise ValueError(f'invalid repository file path {value!r}')
    path = os.path.normcase(os.path.realpath(os.path.join(ROOT, value)))
    root = os.path.normcase(os.path.realpath(ROOT))
    if not path.startswith(root + os.sep):
        raise ValueError(f'path escapes repository: {value}')
    if os.path.isdir(path):
        raise ValueError(f'scope must name a file, not a directory: {value}')
    return path


def phase_path(value):
    try:
        path = scope_path(value)
        plans = os.path.normcase(os.path.realpath(os.path.join(ROOT, 'docs', 'plans')))
        if not path.startswith(plans + os.sep) or not path.endswith('.md') or path.endswith('.log.md'):
            raise ValueError('current must name a phase .md file under docs/plans')
        return path
    except ValueError as exc:
        die(str(exc))


def digest(value):
    return hashlib.sha256(value).hexdigest()


def specification(phase):
    """Hash requirements, including headings and unknown prose, excluding bookkeeping."""
    fm, body = split_frontmatter(phase['text'])
    chunks = re.split(r'(?=^##\s)', COMMENT_RE.sub('', body), flags=re.M)
    prose = []
    for chunk in chunks:
        head = chunk.splitlines()[0].strip() if chunk.splitlines() else ''
        if head.lower() in ('## findings', '## changelog', '## migration', '## history'):
            continue
        prose.append('\n'.join(line.rstrip() for line in chunk.strip().splitlines()))
    def canonical(key, values):
        if key == 'deps':
            return sorted(values)
        result = []
        for value in values:
            try:
                result.append(os.path.relpath(scope_path(value), ROOT).replace(os.sep, '/'))
            except ValueError:
                result.append('invalid:' + value)
        return sorted(result)
    contract = {'phase': phase['meta'].get('phase'), 'prose': prose,
                'tasks': {tid: {key: canonical(key, task.get(key, [])) for key in ('deps', 'files', 'reads')}
                          for tid, task in phase['tasks'].items()}}
    return digest(json.dumps(contract, sort_keys=True, ensure_ascii=True).encode())


def task_specification(phase, tid):
    """Hash only the contract that can affect one task's verification.

    Review and approval deliberately use the phase-wide ``specification``. Evidence
    has a narrower lifetime: shared constraints, this task, and its transitive
    dependencies can invalidate it, while an unrelated later task cannot.
    """
    _, body = split_frontmatter(phase['text'])
    relevant = set(_transitive_deps(phase, tid) + [tid])
    chunks = re.split(r'(?=^##\s)', COMMENT_RE.sub('', body), flags=re.M)
    prose = []
    for chunk in chunks:
        lines = chunk.splitlines()
        head = lines[0].strip() if lines else ''
        if head.lower() in ('## findings', '## changelog', '## migration', '## history'):
            continue
        task_head = re.match(r'^##\s+(T\d+)\b', head)
        if task_head and task_head.group(1) not in relevant:
            continue
        prose.append('\n'.join(line.rstrip() for line in chunk.strip().splitlines()))

    def canonical(key, values):
        if key == 'deps':
            return sorted(values)
        result = []
        for value in values:
            try:
                result.append(os.path.relpath(scope_path(value), ROOT).replace(os.sep, '/'))
            except ValueError:
                result.append('invalid:' + value)
        return sorted(result)

    contract = {
        'phase': phase['meta'].get('phase'),
        'prose': prose,
        'tasks': {
            task_id: {
                key: canonical(key, phase['tasks'][task_id].get(key, []))
                for key in ('deps', 'files', 'reads')
            }
            for task_id in phase['order'] if task_id in relevant
        },
    }
    return digest(json.dumps(contract, sort_keys=True, ensure_ascii=True).encode())


def atomic_write(path, text):
    path = os.path.abspath(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.cs-', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8', newline='\n') as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            os.chmod(temporary, os.stat(path).st_mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def state_path(name):
    return os.path.join(ROOT, '.coldsession-state', name)


def json_digest(value):
    return digest(json.dumps(value, sort_keys=True, ensure_ascii=True).encode())


def revise_snapshot_path(phase):
    key = os.path.relpath(phase['path'], ROOT).replace(os.sep, '/')
    return state_path('revise-' + digest(key.encode()) + '.json')


def load_json(path, default=None):
    if not os.path.exists(path):
        return default
    return json.loads(read_text(path))


def save_json(path, value):
    atomic_write(path, json.dumps(value, sort_keys=True, indent=2) + '\n')


def json_input(value):
    """Accept a JSON object, stdin, or an existing file without forcing scratch writes."""
    if value == '--stdin':
        return json.loads(sys.stdin.read(16385))
    if value.lstrip().startswith('{'):
        if len(value) > 16384:
            die('JSON input exceeds 16384 characters')
        return json.loads(value)
    return load_json(scope_path(value))


def transaction(changes):
    journal = state_path('transaction.json')
    entries = [{'path': os.path.relpath(path, ROOT).replace(os.sep, '/'),
                'before': read_text(path) if os.path.exists(path) else None, 'after': text}
               for path, text in changes.items()]
    save_json(journal, entries)
    recover_transaction()


def recover_transaction():
    journal = state_path('transaction.json')
    entries = load_json(journal)
    if entries is None:
        return
    # Validate all inputs before writing any; replay is safe after any prefix.
    for entry in entries:
        path = scope_path(entry['path'])
        current = read_text(path) if os.path.exists(path) else None
        if current not in (entry['before'], entry['after']):
            die(f'incomplete transaction conflicts with {entry["path"]}; preserve changes and recover from {journal}')
    for entry in entries:
        atomic_write(scope_path(entry['path']), entry['after'])
    os.unlink(journal)


def evidence_path(phase):
    return phase['path'][:-3] + '.evidence.json'


def verification_checks(phase, tid):
    checks = []
    for line in phase['sections'].get(tid, '').splitlines():
        line = line.strip().lstrip('-* ').strip()
        if not line.startswith('Verify:'):
            continue
        raw = line[7:].strip()
        match = re.fullmatch(r'`([^`\n]+)`(?: exits 0)?', raw)
        if match:
            checks.append({'kind': 'automated', 'command': match.group(1)})
        elif re.match(r'^(manual|visual):\s*\S', raw):
            kind, description = raw.split(':', 1)
            checks.append({'kind': kind, 'command': description.strip()})
        else:
            raise ValueError('Verify must be `exact command` exits 0, manual: action, or visual: action; one per line')
    if not checks:
        raise ValueError('no declared verification')
    return checks


def working_fingerprint(phase, tid):
    paths = set(phase['tasks'][tid]['files'] + phase['tasks'][tid].get('reads', []))
    for dep in _transitive_deps(phase, tid):
        paths.update(phase['tasks'][dep]['files'])
    values = []
    for entry in sorted(paths):
        path = scope_path(entry)
        if os.path.exists(path):
            with open(path, 'rb') as handle:
                h = hashlib.sha256()
                for chunk in iter(lambda: handle.read(65536), b''):
                    h.update(chunk)
            value = h.hexdigest()
        else:
            value = 'missing'
        values.append((entry, os.path.relpath(path, ROOT).replace(os.sep, '/'), value))
    return digest(json.dumps(values).encode())


def phase_working_fingerprint(phase):
    """Fingerprint every declared implementation input for the current phase."""
    return json_digest({tid: working_fingerprint(phase, tid) for tid in phase['order']})


def task_conflict(phase, left, right):
    a, b = phase['tasks'][left], phase['tasks'][right]
    aw = {scope_path(p) for p in a['files']}
    bw = {scope_path(p) for p in b['files']}
    ar = {scope_path(p) for p in a.get('reads', [])}
    br = {scope_path(p) for p in b.get('reads', [])}
    return bool(aw & (bw | br) or bw & ar)


def evidence_failure_reasons(phase, tid):
    record = (load_json(evidence_path(phase), {}) or {}).get(tid, {})
    if not record:
        return ['evidence_missing']
    reasons = []
    spec_kind = record.get('spec-kind')
    expected_spec = task_specification(phase, tid) if spec_kind == 'task' else specification(phase)
    if spec_kind not in (None, 'task') or record.get('spec') != expected_spec:
        reasons.append('spec_changed')
    if record.get('files') != working_fingerprint(phase, tid):
        reasons.append('inputs_changed')
    if record.get('checks-hash') != digest(json.dumps(verification_checks(phase, tid), sort_keys=True).encode()):
        reasons.append('checks_changed')
    if record.get('success') is not True:
        reasons.extend(record.get('failure-reasons') or ['verification_failed'])
    return list(dict.fromkeys(reasons))


def evidence_valid(phase, tid):
    return not evidence_failure_reasons(phase, tid)


def redact(text):
    text = re.sub(r'-----BEGIN [^-]*PRIVATE KEY-----.*?(?:-----END [^-]*PRIVATE KEY-----|\Z)',
                  '[REDACTED PRIVATE KEY]', text, flags=re.S)
    text = re.sub(r'(?i)\b(authorization|api[_-]?key|token|secret|password)\s*[:=]\s*[^\r\n]+',
                  r'\1=[REDACTED]', text)
    return re.sub(r'\b(?:sk-[\w-]{12,}|gh[pousr]_[\w]{15,}|AKIA[A-Z0-9]{16})\b', '[REDACTED]', text)


def bounded_run(command, timeout=300, env=None, shell=True, cwd=None, limit=16384, stdin=None, split=False,
                clean=redact):
    """Drain continuously with bounded memory. Never persist an environment dump.

    With SPLIT, stderr is kept apart, bounded, as 'errors' (its last 4 KiB).
    CLEAN filters credentials; a caller that parses the output must pass None
    and filter whatever it keeps or shows.
    """
    clean = clean or (lambda text: text)
    output = bytearray()
    errors = bytearray()
    total = [0]
    try:
        process = subprocess.Popen(command, cwd=cwd or ROOT, shell=shell, env=env, stdin=stdin,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE if split else subprocess.STDOUT,
                                   start_new_session=os.name != 'nt')
    except OSError as exc:
        return {'exit': 127, 'output': clean(str(exc)), 'errors': '', 'truncated': False, 'timeout': False}
    def drain():
        while True:
            chunk = process.stdout.read(4096)
            if not chunk:
                break
            total[0] += len(chunk)
            output.extend(chunk[:max(0, limit - len(output))])
    def drain_errors():
        while True:
            chunk = process.stderr.read(4096)
            if not chunk:
                break
            errors.extend(chunk)
            del errors[:max(0, len(errors) - 4096)]
    reader = threading.Thread(target=drain, daemon=True)
    reader.start()
    error_reader = threading.Thread(target=drain_errors, daemon=True) if split else None
    if error_reader:
        error_reader.start()
    timed_out = False
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        if os.name == 'nt':
            subprocess.run(['taskkill', '/PID', str(process.pid), '/T', '/F'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            import signal
            os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    reader.join(timeout=2)
    if not reader.is_alive():
        process.stdout.close()
    if error_reader:
        error_reader.join(timeout=2)
        if not error_reader.is_alive():
            process.stderr.close()
    return {'exit': process.returncode, 'output': clean(output.decode('utf-8', 'replace')),
            'errors': clean(errors.decode('utf-8', 'replace')),
            'truncated': total[0] > len(output) or reader.is_alive(), 'timeout': timed_out}


def validate_transition(phase, name, args):
    """Single entry gate for the strict workflow, including resume and completion."""
    if phase['malformed']:
        die('invalid task graph; run plan lint and repair duplicate/malformed IDs')
    if not strict(phase):
        return
    if phase['meta'].get('status') == 'closed':
        die('historical closed phase is read-only; run /cs-plan')
    assignments = load_json(assignment_path(phase), {})
    actor = _owner_id() or 'local operator'
    if assignments and any(a.get('coordinator') != actor for a in assignments.values()):
        die('shared workflow state belongs to the assignment coordinator')
    if name == 'done' and args and args[0].upper() in assignments:
        die('assigned tasks must complete through plan integrate with the current result receipt')
    if name in ('replan', 'block', 'resolve', 'bump', 'handoff'):
        return
    if name == 'finish' and '--fail' in args:
        return  # cmd_finish requires a persisted finding/error and the matching claim
    errs, _ = lint_issues(phase)
    if errs:
        die('workflow state is invalid: ' + '; '.join(errs) + '; run plan replan for recovery')
    if phase['meta'].get('status') == 'closed':
        die('historical closed phase is read-only; run /cs-plan')
    if name in ('start', 'done', 'verify', 'assign', 'integrate'):
        if phase['meta'].get('status') != 'approved' or phase['meta'].get('active'):
            die('execution requires an approved phase with no active review stage')
        if open_findings(phase):
            die('open findings prevent execution; run plan replan')
        if name in ('start', 'done', 'verify'):
            tid = task_arg(args, f'plan {name} T2')
            if tid not in phase['tasks']:
                die('supply a valid task ID')
            task = phase['tasks'][tid]
            if any(phase['tasks'][d]['status'] != 'done' for d in task['deps']):
                die(f'{tid} has unfinished dependencies')
            for dep in task['deps']:
                reasons = evidence_failure_reasons(phase, dep)
                if reasons:
                    die(f'{tid} dependency evidence is missing or stale '
                        f'({", ".join(reasons)}); run plan verify {dep}')
            if name == 'start':
                for other, candidate in phase['tasks'].items():
                    if other != tid and candidate['status'] == 'in_progress' and task_conflict(phase, tid, other):
                        die(f'{tid} conflicts with running task {other}')
            elif task['status'] not in (('in_progress', 'done') if name == 'verify' else ('in_progress',)):
                die(f'{tid} must be in_progress before {name}')
            if name == 'done':
                reasons = evidence_failure_reasons(phase, tid)
                if reasons:
                    die(f'{tid} needs matching successful evidence '
                        f'({", ".join(reasons)}); run plan verify {tid}')
    if name in ('begin', 'finish') and args and args[0] == 'close':
        for tid in phase['order']:
            reasons = evidence_failure_reasons(phase, tid)
            if reasons:
                die(f'{tid} completion is historical or verification is stale '
                    f'({", ".join(reasons)}); run plan verify {tid}')
    if name == 'begin' and args and args[0] in ('review', 'approve'):
        if any(t['status'] == 'in_progress' for t in phase['tasks'].values()):
            die('running work must settle before review')
        if args[0] == 'approve' and phase['meta'].get('reviewed-spec') != specification(phase):
            die('reviewed specification changed; run plan replan')


def _attestation_checks(checks):
    """Return stable human-facing labels for the non-automated checks."""
    counts, result = {}, []
    for check in checks:
        if check['kind'] == 'automated':
            continue
        counts[check['kind']] = counts.get(check['kind'], 0) + 1
        label = f"{check['kind']}:{counts[check['kind']]}"
        result.append((label, check))
    return result


def _verify_options(args, checks):
    timeout, supplied, index = 300, [], 1
    while index < len(args):
        option = args[index]
        if option not in ('--attest', '--timeout') or index + 1 >= len(args):
            die('usage: plan verify T1 [--attest kind:N="observed result"]... [--timeout SECONDS]')
        value = args[index + 1]
        if option == '--timeout':
            if not re.fullmatch(r'\d+', value):
                die('verification timeout must be an integer between 1 and 3600 seconds')
            timeout = int(value)
        else:
            supplied.append(value)
        index += 2

    if timeout < 1 or timeout > 3600:
        die('verification timeout must be between 1 and 3600 seconds')

    required = _attestation_checks(checks)
    known = {label: check for label, check in required}
    attestations = {}
    for value in supplied:
        if '=' in value:
            label, observation = value.split('=', 1)
            label = label.strip().lower()
        elif len(required) == 1 and len(supplied) == 1:
            label, observation = required[0][0], value
        else:
            die('each attestation must name its check, for example '
                '--attest visual:1="observed result"')
        if label not in known:
            die(f'unknown attestation check {label!r}; expected one of: '
                + (', '.join(known) if known else 'none'))
        if label in attestations:
            die(f'duplicate attestation for {label}')
        if not observation.strip():
            die(f'attestation for {label} is blank')
        attestations[label] = observation

    missing = [(label, check) for label, check in required if label not in attestations]
    if missing:
        detail = '\n'.join(
            f'  --attest {label}="observed result"  # {check["command"]}'
            for label, check in missing)
        die('missing_attestation: perform each missing check and rerun with:\n' + detail)
    return timeout, attestations


def _attempt_history(record):
    """Read new history or promote one legacy latest-record into history."""
    if isinstance(record.get('attempts'), list):
        return list(record['attempts'])
    if not record:
        return []
    legacy = {key: value for key, value in record.items()
              if key not in ('attempts', 'latest-success')}
    legacy.setdefault('id', 'legacy-' + digest(json.dumps(
        legacy, sort_keys=True, ensure_ascii=True).encode())[:16])
    legacy.setdefault('state', 'complete' if 'results' in legacy else record.get('state', 'unknown'))
    return [legacy]


def _evidence_record(attempt, attempts, latest_success=None):
    record = dict(attempt)
    record['attempts'] = attempts
    if latest_success:
        record['latest-success'] = latest_success
    return record


def cmd_verify(phase, args):
    tid = task_arg(args, 'plan verify T1 [--attest kind:N="observed result"]... [--timeout SECONDS]')
    if tid not in phase['tasks']:
        die(f'{tid} is not in this phase')
    checks = verification_checks(phase, tid)
    timeout, attestations = _verify_options(args, checks)
    refuse_scout_evidence([check['command'] for check in checks] + list(attestations.values()), 'verification')
    spec, phase_spec = task_specification(phase, tid), specification(phase)
    before = working_fingerprint(phase, tid)
    records = load_json(evidence_path(phase), {})
    prior = records.get(tid, {})
    attempts = _attempt_history(prior)
    latest_success = prior.get('latest-success')
    if not latest_success and prior.get('success') is True and attempts:
        latest_success = attempts[-1]['id']
    attempt = {'id': uuid.uuid4().hex, 'spec-kind': 'task', 'spec': spec,
               'phase-spec': phase_spec, 'files': before, 'success': False,
               'state': 'running', 'at': datetime.now().isoformat()}
    attempts.append(attempt)
    records[tid] = _evidence_record(attempt, attempts, latest_success)
    save_json(evidence_path(phase), records)
    results = []
    attestation_labels = iter(_attestation_checks(checks))
    for check in checks:
        if check['kind'] == 'automated':
            result = bounded_run(check['command'], timeout=timeout)
        else:
            label, _ = next(attestation_labels)
            observation = attestations[label]
            result = {'exit': 0, 'attestation': redact(observation)[:4096],
                      'check-id': label,
                      'check-hash': digest(json.dumps(check, sort_keys=True).encode()),
                      'actor': _owner_id() or 'local operator',
                      'truncated': len(observation) > 4096}
        results.append(result)
    fresh = read_phase(phase['path'])
    after = working_fingerprint(fresh, tid)
    current_spec = spec == task_specification(fresh, tid)
    current_phase = phase_spec == specification(fresh)
    success = (current_spec and current_phase and
               all(r['exit'] == 0 and not r.get('timeout') for r in results))
    failure_reasons = []
    if any(r['exit'] != 0 for r in results if r.get('exit') is not None):
        failure_reasons.append('automated_failed')
    if any(r.get('exit') is None for r in results):
        failure_reasons.append('missing_attestation')
    if not current_spec or not current_phase:
        failure_reasons.append('spec_changed')
    records = load_json(evidence_path(phase), {})
    attempt = {'id': attempt['id'], 'spec-kind': 'task', 'spec': spec,
               'phase-spec': phase_spec, 'files': after, 'files-before': before,
               'checks': [{**check, 'command': redact(check['command'])} for check in checks],
               'checks-hash': digest(json.dumps(checks, sort_keys=True).encode()),
               'results': results, 'success': success, 'state': 'complete',
               'failure-reasons': failure_reasons, 'at': datetime.now().isoformat()}
    current = records.get(tid, {})
    attempts = _attempt_history(current)
    for index, previous in enumerate(attempts):
        if previous.get('id') == attempt['id']:
            attempts[index] = attempt
            break
    else:
        attempts.append(attempt)
    latest_success = attempt['id'] if success else current.get('latest-success')
    records[tid] = _evidence_record(attempt, attempts, latest_success)
    save_json(evidence_path(phase), records)
    print(json.dumps(records[tid], indent=2))
    if not success:
        print('verification failed: ' + ', '.join(failure_reasons) + '; rerun before done', file=sys.stderr)
    return 0 if success else 1


def cmd_replan(phase, args):
    if phase['meta'].get('status') == 'closed':
        die('closed history cannot be replanned; run /cs-plan for a new phase')
    active = phase['meta'].get('active') or any(t['status'] == 'in_progress' for t in phase['tasks'].values())
    if active and '--recover-claims' not in args:
        die('claims remain; settle workers, then explicitly run plan replan --recover-claims; age alone is not abandonment')
    text = phase['text']
    for tid, task in phase['tasks'].items():
        if task['status'] != 'done':
            text = re.sub(r'^(  ' + tid + r':.*?status:\s*)\w+', r'\g<1>pending', text, flags=re.M)
            text = _set_owner(text, tid, None)
    text = set_metas(text, {'status': 'draft', 'rev': intof(phase['meta'].get('rev'), 1) + 1},
                     remove=('ready', 'ready-spec', 'reviewed', 'reviewed-spec', 'active', 'active-rev', 'active-spec'))
    text = append_to_block(text, 'History', f"Replan from rev {phase['meta'].get('rev')}; completed work and findings retained.")
    transaction({phase['path']: text, assignment_path(phase): '{}\n'})
    print('unfinished work -> draft; findings and completion history retained; next /cs-review in a fresh session')


def relevant_handoffs(phase, tid):
    records = load_json(phase['path'][:-3] + '.handoffs.json', [])
    superseded = {key for entry in records for key in entry.get('supersedes', [])}
    log = phase['path'][:-3] + '.log.md'
    legacy = []
    if os.path.exists(log):
        for heading, content in parse_blocks(read_text(log)).items():
            tasks = re.findall(r'\bT\d+\b', heading)
            if tasks:
                legacy.append({'id': 'legacy-' + digest((heading + content).encode())[:16],
                                   'task': tasks[0], 'affects': tasks, 'decisions': redact(content)[:2048],
                                   'provenance': os.path.relpath(log, ROOT) + '#' + heading,
                                   'limitations': 'Legacy narrative; not automated verification evidence.'})
    records = legacy + records
    relevant = set(_transitive_deps(phase, tid) + [tid])
    return [e for e in records if e['id'] not in superseded and
            (e.get('task') in relevant or tid in e.get('affects', []))][-8:]


def cmd_handoff(phase, args):
    if len(args) != 2 or args[0] not in phase['tasks']:
        die('usage: plan handoff T1 <JSON-file> (decisions, evidence, limitations, affects, provenance, supersedes)')
    refuse_scout_evidence(args[1], 'completion')
    entry = json_input(args[1])
    refuse_scout_evidence(entry, 'completion')
    required = ('decisions', 'evidence', 'limitations', 'affects', 'provenance', 'supersedes')
    if not isinstance(entry, dict) or any(key not in entry for key in required):
        die('handoff is missing required fields')
    if len(json.dumps(entry)) > 4096:
        die('handoff exceeds 4096 characters')
    if not isinstance(entry['affects'], list) or any(t not in phase['tasks'] for t in entry['affects']):
        die('handoff affects must contain known task IDs')
    path = phase['path'][:-3] + '.handoffs.json'
    entries = load_json(path, [])
    known = {e['id'] for e in entries}
    known.update(e['id'] for tid in phase['order'] for e in relevant_handoffs(phase, tid))
    if not isinstance(entry['supersedes'], list) or any(key not in known for key in entry['supersedes']):
        die('supersedes must name existing handoff IDs')
    entry = {key: redact(value) if isinstance(value, str) else value for key, value in entry.items()}
    entry.update(id=uuid.uuid4().hex, task=args[0], spec=specification(phase), at=datetime.now().isoformat())
    entries.append(entry)
    save_json(path, entries)
    print(entry['id'])


def assignment_path(phase):
    return phase['path'][:-3] + '.assignments.json'


def cmd_assign(phase, args):
    if not strict(phase):
        die('team assignments require an explicit format 2 upgrade')
    if len(args) == 3 and args[0] == '--bind':
        tid, worker = args[1].upper(), args[2]
        records = load_json(assignment_path(phase), {})
        if tid not in records or records[tid]['spec'] != specification(phase):
            die('cannot bind an unknown or superseded assignment')
        if records[tid].get('worker') not in (None, worker):
            die('assignment is already bound; settle the worker and explicitly recover claims before replacement')
        if not re.fullmatch(r'[A-Za-z0-9_./:-]+', worker):
            die('worker session identity contains unsupported characters')
        if any(record.get('worker') == worker for key, record in records.items() if key != tid):
            die('worker session already owns another assignment')
        records[tid]['worker'] = worker
        transaction({phase['path']: _set_owner(phase['text'], tid, worker),
                     assignment_path(phase): json.dumps(records, indent=2) + '\n'})
        print(f'{tid} bound to worker session {worker}; assignment ID unchanged')
        return 0
    if not args or args[0] not in ('orca', 'codex', 'claude'):
        die('usage: plan assign orca|codex|claude [--max N], or plan assign --bind T1 WORKER_SESSION')
    if not _owner_id():
        die('team coordination requires a stable harness session identity; use manual builds if none is exported')
    if os.environ.get('CS_WORKER_ASSIGNMENT'):
        die('nested fanout is prohibited')
    maximum = intof(args[args.index('--max') + 1], 2) if '--max' in args else 2
    if maximum < 1 or maximum > 8:
        die('--max must be between 1 and 8')
    records = load_json(assignment_path(phase), {})
    if records:
        die('an assignment group still exists; integrate it or explicitly recover claims before dispatch')
    occupied = {scope_path(p) for t in phase['tasks'].values() if t['status'] == 'in_progress' for p in t['files']}
    text = phase['text']
    for tid in runnable(phase):
        paths = {scope_path(p) for p in phase['tasks'][tid]['files']}
        if paths & occupied or any(task_conflict(phase, tid, other) for other in
                                   list(records) + [t for t, value in phase['tasks'].items() if value['status'] == 'in_progress']):
            continue
        if any(not evidence_valid(phase, dep) for dep in phase['tasks'][tid]['deps']):
            continue
        assignment = uuid.uuid4().hex
        records[tid] = {'task': tid, 'spec': specification(phase), 'assignment': assignment,
                        'backend': args[0], 'coordinator': _owner_id() or 'local operator',
                        'files': phase['tasks'][tid]['files'], 'reads': phase['tasks'][tid]['reads'],
                        'verify': verification_checks(phase, tid),
                        'expected': 'return task, spec, assignment, outcome, decisions, evidence, limitations; no state writes or commits'}
        text = re.sub(r'^(  ' + tid + r':.*?status:\s*)pending', r'\g<1>in_progress', text, flags=re.M)
        text = _set_owner(text, tid, assignment)
        occupied.update(paths)
        if len(records) >= maximum:
            break
    if not records:
        die('no approved nonconflicting tasks; run plan recommend')
    transaction({phase['path']: text, assignment_path(phase): json.dumps(records, indent=2) + '\n'})
    print(json.dumps(records, indent=2))


def cmd_integrate(phase, args):
    if len(args) != 1:
        die('usage: plan integrate <worker-result.json>')
    refuse_scout_evidence(args[0], 'completion')
    result = json_input(args[0])
    refuse_scout_evidence(result, 'completion')
    records = load_json(assignment_path(phase), {})
    tid = result.get('task')
    assignment = records.get(tid)
    if not assignment or any(result.get(key) != assignment[key] for key in ('spec', 'assignment')):
        die('superseded or unknown worker result; preserve source changes and inspect current assignments')
    if result['spec'] != specification(phase):
        die('phase changed during execution; stop integration and run plan replan after workers settle')
    if result.get('outcome') != 'success':
        return cmd_block(phase, [tid, 'worker blocker: ' + str(result.get('limitations', 'unspecified'))])
    if not evidence_valid(phase, tid):
        die(f'coordinator must run plan verify {tid} before integration')
    del records[tid]
    text = re.sub(r'^(  ' + tid + r':.*?status:\s*)in_progress', r'\g<1>done', phase['text'], flags=re.M)
    text = _set_owner(text, tid, None)
    transaction({phase['path']: text, assignment_path(phase): json.dumps(records, indent=2) + '\n'})
    print(f'{tid} integrated; coordinator may record handoff and commit')


def cmd_doctor(_phase, args):
    report = {'release': TOOL_VERSION, 'format': FORMAT_VERSION,
              'python': sys.version.split()[0], 'runtime_compatible': sys.version_info >= (3, 9),
              'adapters': {}, 'hooks': {}, 'trust': 'unknown: confirm in each harness',
              'gaps': ['Hooks do not replace native sandbox, permissions, or hook trust.',
                       'Arbitrary shell/program execution and MCP tools cannot be fully analyzed.',
                       'Codex hook registration depends on installed harness support; inspect its configuration.',
                       'Native team tools must be available in the current session; CLI presence is insufficient.']}
    def diagnostic_json(path):
        try:
            value = load_json(path, {})
            if not isinstance(value, dict):
                raise ValueError('expected an object')
            return value
        except (OSError, ValueError):
            report.setdefault('diagnostic_errors', []).append('unreadable or invalid JSON: ' + os.path.relpath(path, ROOT))
            return {}
    for name, relative in (('claude', '.claude/bin/plan'), ('codex', '.agents/coldsession/bin/plan')):
        report['adapters'][name] = {'installed': os.path.isfile(os.path.join(ROOT, relative)),
                                   'cli_detected': bool(shutil.which(name))}
        if shutil.which(name):
            report['adapters'][name]['version'] = bounded_run([shutil.which(name), '--version'], timeout=5, shell=False)
    settings = diagnostic_json(os.path.join(ROOT, '.claude', 'settings.json'))
    report['hooks']['claude_disabled'] = settings.get('disableAllHooks', False)
    report['hooks']['claude_events'] = sorted(settings.get('hooks', {}).keys())
    report['hooks']['claude_managed'] = 'cs-guard-' in json.dumps(settings.get('hooks', {}))
    report['hooks']['codex_config_present'] = os.path.exists(os.path.join(ROOT, '.codex', 'config.toml'))
    if report['hooks']['codex_config_present']:
        config = read_text(os.path.join(ROOT, '.codex', 'config.toml'))
        report['hooks']['codex_managed'] = '# BEGIN coldsession managed hooks' in config
        try:
            import tomllib
        except ImportError:
            report['gaps'].append('Python <3.11: no stdlib TOML parser; Codex configuration validity is unknown.')
        else:
            try:
                parsed = tomllib.loads(config)
                report['hooks']['codex_events'] = sorted(parsed.get('hooks', {}))
                report['hooks']['codex_config_valid'] = True
            except ValueError:
                report['hooks']['codex_config_valid'] = False
    ownership = diagnostic_json(state_path('installed.json'))
    inconsistent = []
    for relative, expected in ownership.get('files', {}).items():
        try:
            path = scope_path(relative)
            with open(path, 'rb') as handle:
                actual = digest(handle.read())
        except (OSError, ValueError):
            actual = None
        if actual != expected:
            inconsistent.append(relative)
    report['installed_file_changes'] = inconsistent
    report['session_identity_detected'] = bool(_owner_id())
    report['codex_recorded_trust'] = 'unknown'
    try:
        import tomllib
        user_config = os.path.join(os.environ.get('CODEX_HOME', os.path.join(os.path.expanduser('~'), '.codex')), 'config.toml')
        if os.path.isfile(user_config):
            projects = tomllib.loads(read_text(user_config)).get('projects', {})
            for project, entry in projects.items():
                if _guard_norm(project) == _guard_norm(ROOT):
                    trust = entry.get('trust_level')
                    if trust in ('trusted', 'untrusted'):
                        report['codex_recorded_trust'] = trust
    except (ImportError, OSError, ValueError, AttributeError):
        pass  # Recorded trust is a diagnostic hint, never a permission grant.
    report['upgrade'] = diagnostic_json(state_path('upgrade.json')).get('status', 'none')
    report['workflow_transaction_pending'] = os.path.exists(state_path('transaction.json'))
    report['scout'] = scout_doctor()
    if report['scout'].get('provider') == 'agy':
        report['gaps'].append('Scout (agy): agy has no verified read-only mode. Scout runs it without permission '
                              'bypass, plan mode, or sandbox, in a disposable copy of the in-scope files, and '
                              'rejects any working-tree change without reverting it. Ignored files are not '
                              'checked. Behavior on Linux and macOS is unverified.')
    try:
        if os.path.exists(INDEX):
            phase = read_phase(read_index())
            report['workflow_errors'], report['workflow_warnings'] = lint_issues(phase)
            report['next'] = ' '.join(recommend(phase))
    except (OSError, ValueError, SystemExit):
        report['workflow_errors'] = ['invalid PLAN.md/current phase; repair the pointer or document']
    if '--json' in args:
        print(json.dumps(report, indent=2))
    else:
        for key, value in report.items():
            print(f'{key}: {json.dumps(value) if isinstance(value, (dict, list)) else value}')
    return 0


# ------------------------------------------------------------------- orca

# Orca is an editor that runs each checkout as a tracked workspace with a
# status column and a comment on its card. When plan runs inside one, the
# phase's state is worth pushing there, so a board of ten worktrees answers
# "where is this one" without opening a terminal in each. Everything below is
# a convenience: a missing, slow, or unhappy Orca must never change what plan
# does, how long it takes, or what it prints.

ORCA_TIMEOUT = 5
ORCA_STATUS = {"draft": "todo", "approved": "in-progress", "closed": "completed"}
MUTATING = ("start", "done", "block", "begin", "finish", "resolve", "bump",
            "reviewed", "verify", "replan", "handoff", "assign", "integrate", "recover")


def _orca_cli():
    """The Orca CLI for this session, or None when there is nothing to mirror.

    ORCA_WORKTREE_ID gates the whole feature. It is set only inside an
    Orca-managed terminal, so a non-Orca user never pays for a subprocess --
    and, because the terminal is managed, bare `orca` is the Orca CLI on every
    platform. Outside one, on Linux, it would usually be the GNOME screen
    reader, which is why this returns None rather than guessing a name.
    """
    if not os.environ.get("ORCA_WORKTREE_ID"):
        return None
    explicit = os.environ.get("ORCA_CLI_COMMAND")
    if explicit:
        return explicit
    return "orca-dev" if os.environ.get("ORCA_DEV_REPO_ROOT") else "orca"


def _orca(*args):
    """Run one Orca command, best effort. Never raises, never prints.

    Every failure -- no Orca, no binary on PATH, a timeout, a non-zero exit --
    is the same silent no-op, for the reason guard fails open: a side channel
    that breaks the thing it decorates is worse than no side channel.
    """
    cli = _orca_cli()
    if not cli:
        return None
    try:
        proc = subprocess.run([cli, *args], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=ORCA_TIMEOUT)
    except Exception:
        return None
    return proc.stdout if proc.returncode == 0 else None


def _orca_card(phase):
    """(workspace status id, comment) for the phase as it now stands.

    An active stage means the phase is being judged rather than built, which
    is `in-review` whatever the phase status says underneath it.
    """
    meta = phase["meta"]
    if meta.get("active") in STAGES:
        status = "in-review"
    else:
        status = ORCA_STATUS.get(meta.get("status", "draft"), "todo")
    cmd, _ = recommend(phase)
    done = sum(1 for t in phase["order"] if phase["tasks"][t]["status"] == "done")
    comment = (f"{meta.get('phase', '?')} rev {intof(meta.get('rev'), 1)} | "
               f"{done}/{len(phase['order'])} done | next {cmd}")
    return status, comment


def _orca_mirror():
    """Push the phase's state onto its Orca card. Best effort, always silent.

    Called once from main() after a mutating command rather than from each
    command, because only main() knows the command ran to completion -- every
    refusal path dies before returning. The phase is re-read because the
    command edited the file after `phase` was parsed.

    die() raises SystemExit, which is not an Exception, so an unreadable index
    or phase has to be caught explicitly or it would escape a helper whose
    whole contract is that it cannot fail.
    """
    if not _orca_cli():
        return
    try:
        status, comment = _orca_card(read_phase(read_index()))
    except (Exception, SystemExit):
        return
    _orca("worktree", "set", "--worktree", "active",
          "--workspace-status", status, "--comment", comment, "--json")


# -------------------------------------------------------------------- scout
# Delegated read-only exploration. A provider's report reaches the host only
# after its evidence is checked mechanically here, at no host-model cost. A
# report is orientation only: no workflow command accepts one, or anything
# under .coldsession-state/scout/, as verification, review, or completion
# evidence (scout_evidence below).

SCOUT_CONTRACT = 'coldsession-scout/1'
SCOUT_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'scout')
SCOUT_KINDS = ('locate', 'trace', 'inventory')
SCOUT_STATUSES = ('answered', 'partial', 'not_found', 'out_of_scope')
SCOUT_BUDGET = {'evidence': 15, 'snippet_lines': 5, 'answer_sentences': 3}
SCOUT_DRIFT = 3
SCOUT_MAX_FILE = 2 * 1024 * 1024
SCOUT_MAX_HITS = 200
SCOUT_CACHE_LIMIT = 200
# The cache holds verbatim snippets, so scouting it would cite itself.
SCOUT_BUILTIN_EXCLUSIONS = ('.coldsession-state',)
SCOUT_CITE_RE = re.compile(r'\[\s*(E\d+(?:\s*,\s*E\d+)*)\s*\]')
SCOUT_REPORT_KEYS = {'status', 'answer', 'evidence', 'steps', 'searched', 'unknowns', 'read_next', 'meta'}
# Run in a separate interpreter so a pathological pattern can be killed on its
# time bound; `re` cannot be interrupted in-process.
SCOUT_SEARCH = r'''
import json, re, sys
job = json.loads(sys.stdin.buffer.read().decode("ascii"))
rx = re.compile(re.escape(job["pattern"]) if job["fixed"] else job["pattern"])
hits = []
for rel, path in job["files"]:
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError:
        continue
    if b"\0" in data[:8192]:
        continue
    for number, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
        if rx.search(line):
            hits.append([rel, number])
            if len(hits) > job["limit"]:
                break
    if len(hits) > job["limit"]:
        break
sys.stdout.write(json.dumps(hits))
'''


def scout_evidence(value):
    """Whether VALUE names the scout cache or carries a scout report."""
    text = value if isinstance(value, str) else json.dumps(value)
    text = text.replace('\\\\', '/').replace('\\', '/').lower()
    return '.coldsession-state/scout' in text or SCOUT_CONTRACT in text


def refuse_scout_evidence(value, use):
    if scout_evidence(value):
        die(f'E36 a scout report is orientation only and cannot be {use} evidence; '
            'check the files themselves and record what you observed')


def _scout_fold(value):
    return value.lower() if os.name == 'nt' else value


def _scout_under(rel, prefix):
    rel, prefix = _scout_fold(rel), _scout_fold(prefix)
    return prefix == '.' or rel == prefix or rel.startswith(prefix + '/')


def _scout_entry(value):
    """A repository-relative scope entry: '.', a directory, or a file."""
    if not isinstance(value, str):
        raise ValueError(f'scope entry must be a string: {value!r}')
    value = value.strip().replace('\\', '/').rstrip('/') or '.'
    if value == '.':
        return value
    parts = value.split('/')
    if value.startswith('/') or re.match(r'^[A-Za-z]:', value) or any(p in ('', '.', '..') for p in parts):
        raise ValueError(f'scope entry must be a plain repository-relative path: {value!r}')
    return value


def _scout_line(value, limit, what):
    if not isinstance(value, str) or not value.strip() or len(value) > limit or re.search(r'[\r\n]', value):
        raise ValueError(f'{what} must be one non-empty line of at most {limit} characters')
    return ' '.join(value.split())


def _scout_read(name):
    path = os.path.join(SCOUT_DIR, name)
    try:
        return read_text(path)
    except OSError:
        die(f'scout contract file {name} is not installed next to this runtime ({path}); rerun the installer')


def _scout_template(kind):
    if kind not in SCOUT_KINDS:
        die(f"scout kind must be one of {', '.join(SCOUT_KINDS)}")
    text = _scout_read(kind + '.md')
    match = re.match(r'<!-- coldsession-scout template: (\w+) version: (\d+) params: ([\w, ]+) -->\n', text)
    common = _scout_read('common.md')
    head = re.match(r'<!-- coldsession-scout common version: (\d+) -->\n', common)
    if not match or match.group(1) != kind or not head:
        die(f'scout template {kind} has no valid version header; rerun the installer')
    version = {'kind': kind, 'version': int(match.group(2)), 'common': int(head.group(1))}
    return version, csv(match.group(3)), text[match.end():].strip() + '\n\n' + common[head.end():].strip() + '\n'


def _scout_render(body, values):
    # One pass, so a parameter that happens to contain {{name}} stays literal.
    return re.sub(r'\{\{(\w+)\}\}', lambda m: str(values[m.group(1)]), body)


def _scout_git(*args):
    try:
        result = subprocess.run(['git', *args], cwd=ROOT, capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.decode('utf-8', 'replace') if result.returncode == 0 else None


def _scout_rev():
    head = _scout_git('rev-parse', '--verify', 'HEAD')
    status = _scout_git('status', '--porcelain', '--untracked-files=all') if head else None
    if not head or status is None:
        return {'head': None, 'dirty': True}
    return {'head': head.strip(), 'dirty': bool(status.strip())}


def _scout_exclusions():
    config = load_json(state_path(os.path.join('scout', 'config.json')), {}) or {}
    extra = config.get('exclusions', []) if isinstance(config, dict) else []
    if not isinstance(extra, list):
        die('scout config exclusions must be a list of repository paths')
    return list(SCOUT_BUILTIN_EXCLUSIONS) + [_scout_entry(entry) for entry in extra]


def scout_request(kind, params, include=None, exclude=None, known=None, purpose='', rev=None):
    """Build a request from the fixed template for KIND; there is no free-form prompt."""
    version, names, body = _scout_template(kind)
    if sorted(params) != sorted(names):
        raise ValueError(f"{kind} takes exactly: {', '.join(names)}")
    params = {name: _scout_line(params[name], 200, name) for name in names}
    include = [_scout_entry(p) for p in (include or ['.'])]
    exclude = [_scout_entry(p) for p in (exclude or [])]
    known = [_scout_line(k, 200, 'known') for k in (known or [])]
    if len(include) > 20 or len(exclude) > 20 or len(known) > 10:
        raise ValueError('scope takes at most 20 include and 20 exclude paths; known at most 10 facts')
    purpose = _scout_line(purpose, 120, 'purpose')
    values = dict(params, **SCOUT_BUDGET, purpose=purpose, include=', '.join(include),
                  exclude=', '.join(exclude + list(SCOUT_BUILTIN_EXCLUSIONS)) + ', and any credential or secret file',
                  known='; '.join(known) or 'nothing yet')
    return {'contract': SCOUT_CONTRACT, 'kind': kind, 'template': version,
            'params': params, 'scope': {'include': include, 'exclude': exclude}, 'known': known,
            'purpose': purpose, 'budget': dict(SCOUT_BUDGET), 'rev': rev or _scout_rev(),
            'prompt': _scout_render(body, values)}


def _scout_check_request(request):
    """Rebuild the request from its own fields; any drift means it was not produced by the template."""
    try:
        if not isinstance(request, dict) or request.get('contract') != SCOUT_CONTRACT:
            raise ValueError(f'not a {SCOUT_CONTRACT} request')
        rev = request.get('rev')
        if not (isinstance(rev, dict) and set(rev) == {'head', 'dirty'} and isinstance(rev['dirty'], bool)
                and (rev['head'] is None or isinstance(rev['head'], str))):
            raise ValueError('rev must hold head and dirty')
        scope = request.get('scope') or {}
        expected = scout_request(request.get('kind'), request.get('params') or {}, scope.get('include'),
                                 scope.get('exclude'), request.get('known'), request.get('purpose'), rev)
        if request != expected:
            raise ValueError('fields differ from the installed template; regenerate it with plan scout request')
    except ValueError as exc:
        die(f'invalid scout request: {exc}')
    return request


def _scout_int(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def _scout_lines(snippet):
    return snippet.replace('\r\n', '\n').replace('\r', '\n').rstrip('\n').split('\n')


def _scout_shape(report, kind):
    """Schema and budget failures. These are the ones a provider retry may fix."""
    bad = []
    def need(ok, detail):
        if not ok:
            bad.append(detail)
        return ok
    if not need(isinstance(report, dict), 'report must be a JSON object'):
        return bad
    extra = set(report) - SCOUT_REPORT_KEYS
    need(not extra, f"unknown fields: {', '.join(sorted(extra))}")
    missing = SCOUT_REPORT_KEYS - {'steps'} - set(report)
    if not need(not missing, f"missing fields: {', '.join(sorted(missing))}"):
        return bad
    need(report['status'] in SCOUT_STATUSES, f"status must be one of {', '.join(SCOUT_STATUSES)}")
    answer = report['answer']
    if need(isinstance(answer, str) and len(answer) <= 800, 'answer must be a string of at most 800 characters'):
        sentences = [s for s in re.split(r'(?<=[.!?])\s+', answer.strip()) if s.strip()]
        need(len(sentences) <= SCOUT_BUDGET['answer_sentences'],
             f"answer has {len(sentences)} sentences; the budget is {SCOUT_BUDGET['answer_sentences']}")
    evidence = report['evidence']
    if need(isinstance(evidence, list) and len(evidence) <= SCOUT_BUDGET['evidence'],
            f"evidence must be a list of at most {SCOUT_BUDGET['evidence']} items"):
        ids = set()
        for item in evidence:
            if not need(isinstance(item, dict) and set(item) == {'id', 'file', 'line_start', 'line_end', 'snippet', 'why'},
                        'each evidence item has exactly id, file, line_start, line_end, snippet, why'):
                continue
            eid = item['id']
            need(isinstance(eid, str) and re.fullmatch(r'E\d+', eid) and eid not in ids, f'evidence id {eid!r} must be a unique E<number>')
            ids.add(eid)
            need(isinstance(item['file'], str) and item['file'].strip(), f'{eid} file must be a path')
            need(isinstance(item['why'], str) and len(item['why']) <= 200 and not re.search(r'[\r\n]', item['why']),
                 f'{eid} why must be one line of at most 200 characters')
            if need(_scout_int(item['line_start']) and _scout_int(item['line_end']) and item['line_end'] >= item['line_start'],
                    f'{eid} needs line_start <= line_end, both positive integers'):
                count = item['line_end'] - item['line_start'] + 1
                need(count <= SCOUT_BUDGET['snippet_lines'], f"{eid} cites {count} lines; the budget is {SCOUT_BUDGET['snippet_lines']}")
                need(isinstance(item['snippet'], str) and len(_scout_lines(item['snippet'])) == count,
                     f'{eid} snippet must hold exactly the {count} cited lines')
    steps = report.get('steps')
    if kind == 'trace':
        if need(isinstance(steps, list) and len(steps) <= 15, 'trace needs steps: a list of at most 15 items'):
            for step in steps:
                need(isinstance(step, dict) and set(step) == {'text', 'evidence'} and isinstance(step['text'], str)
                     and not re.search(r'[\r\n]', step['text']) and len(step['text']) <= 200
                     and isinstance(step['evidence'], list) and all(isinstance(e, str) for e in step['evidence']),
                     'each step has exactly a one-line text and an evidence list of IDs')
    else:
        need(steps is None, 'steps belongs only to trace')
    searched = report['searched']
    if need(isinstance(searched, list) and len(searched) <= 10, 'searched must be a list of at most 10 items'):
        for item in searched:
            if not need(isinstance(item, dict) and {'pattern', 'paths'} <= set(item) <= {'pattern', 'paths', 'fixed'},
                        'each searched item has pattern, paths, and optional fixed'):
                continue
            pattern, fixed = item['pattern'], item.get('fixed', False)
            if not need(isinstance(pattern, str) and 0 < len(pattern) <= 200 and isinstance(fixed, bool),
                        'searched pattern must be 1-200 characters and fixed a boolean'):
                continue
            need(isinstance(item['paths'], list) and 0 < len(item['paths']) <= 20 and all(isinstance(p, str) for p in item['paths']),
                 f'searched {pattern!r} needs 1-20 paths')
            if not fixed:
                try:
                    re.compile(pattern)
                except (re.error, RecursionError, OverflowError) as exc:
                    need(False, f'searched pattern {pattern!r} is not a valid regular expression: {exc}')
    unknowns = report['unknowns']
    need(isinstance(unknowns, list) and len(unknowns) <= 10 and all(isinstance(u, str) and len(u) <= 300 for u in unknowns),
         'unknowns must be a list of at most 10 strings of at most 300 characters')
    read_next = report['read_next']
    need(isinstance(read_next, list) and len(read_next) <= 10 and all(
        isinstance(r, dict) and set(r) == {'file', 'line_start', 'line_end'} and isinstance(r['file'], str)
        and _scout_int(r['line_start']) and _scout_int(r['line_end']) and r['line_end'] >= r['line_start']
        for r in read_next), 'read_next must be at most 10 {file, line_start, line_end} ranges')
    meta = report['meta']
    need(isinstance(meta, dict) and isinstance(meta.get('provider'), str) and isinstance(meta.get('model'), str),
         'meta must hold provider and model strings')
    return bad


class _ScoutContext:
    def __init__(self, request):
        self.request = request
        self.root = os.path.realpath(ROOT)
        self.include = request['scope']['include']
        self.exclude = request['scope']['exclude']
        self.exclusions = _scout_exclusions()
        # Shell-launched providers bypass the read guard, so an active claim's
        # read set bounds scout evidence here instead.
        scope = _guard_scope(_guard_phase(), _owner_id())
        self.allowed = scope[1] if scope else None
        self.claim = scope[0] if scope else []
        self._files = None

    def rel(self, value):
        """(repository-relative resolved path, absolute path) or a reason code."""
        value = value.strip().replace('\\', '/')
        if value.startswith('/') or re.match(r'^[A-Za-z]:', value) or '..' in value.split('/'):
            return 'outside_repo'
        target = os.path.realpath(os.path.join(self.root, value))
        root = os.path.normcase(self.root)
        if os.path.normcase(target) != root and not os.path.normcase(target).startswith(root + os.sep):
            return 'outside_repo'
        rel = os.path.relpath(target, self.root).replace(os.sep, '/')
        return (rel, target)

    def blocked(self, rel):
        if sensitive(rel):
            return 'sensitive'
        if any(_scout_under(rel, entry) for entry in self.exclusions):
            return 'excluded'
        return None

    def in_scope(self, rel):
        return (any(_scout_under(rel, entry) for entry in self.include) and
                not any(_scout_under(rel, entry) for entry in self.exclude))

    def file(self, value):
        """Check one cited file; return (reason, rel, absolute path)."""
        resolved = self.rel(value)
        if isinstance(resolved, str):
            return resolved, None, None
        rel, target = resolved
        literal = value.strip().replace('\\', '/')
        literal = literal[2:] if literal.startswith('./') else literal
        if not os.path.isfile(target):
            return 'missing_file', rel, target
        reason = self.blocked(literal) or self.blocked(rel)
        if reason:
            return reason, rel, target
        if not (self.in_scope(literal) and self.in_scope(rel)):
            return 'outside_scope', rel, target
        if self.allowed is not None and os.path.normcase(target) not in self.allowed:
            return 'outside_read_set', rel, target
        if os.path.getsize(target) > SCOUT_MAX_FILE:
            return 'file_too_large', rel, target
        return None, rel, target

    def candidates(self):
        if self._files is None:
            listed = _scout_git('ls-files', '-z', '--cached', '--others', '--exclude-standard')
            if listed is not None:
                names = [name for name in listed.split('\0') if name]
            else:
                names = []
                for base, dirs, files in os.walk(self.root):
                    dirs[:] = [d for d in dirs if d != '.git']
                    names += [os.path.relpath(os.path.join(base, f), self.root).replace(os.sep, '/') for f in files]
            self._files = sorted(set(names))
        return self._files


def _scout_match(lines, item):
    """The drift (0, then ±1..±3) at which the snippet matches, or None."""
    want = [re.sub(r'\s+', '', line) for line in _scout_lines(item['snippet'])]
    if not any(want):
        return None
    for drift in sorted(range(-SCOUT_DRIFT, SCOUT_DRIFT + 1), key=lambda d: (abs(d), d)):
        start = item['line_start'] + drift
        if start >= 1 and start - 1 + len(want) <= len(lines) and \
                [re.sub(r'\s+', '', line) for line in lines[start - 1:start - 1 + len(want)]] == want:
            return drift
    return None


def _scout_file_lines(path):
    with open(path, 'rb') as handle:
        return handle.read().decode('utf-8', 'replace').splitlines()


def _scout_rerun(ctx, item, stats):
    """Rerun one searched pattern within scope; return hits or a reason."""
    prefixes = []
    for value in item['paths']:
        resolved = ctx.rel(value)
        if isinstance(resolved, str):
            return resolved, value
        rel = resolved[0]
        if not os.path.exists(resolved[1]):
            return 'missing_file', value
        if ctx.blocked(rel):
            return ctx.blocked(rel), value
        if not (ctx.in_scope(rel) or any(_scout_under(entry, rel) for entry in ctx.include)):
            return 'outside_scope', value
        prefixes.append(rel)
    files = []
    for name in ctx.candidates():
        if not any(_scout_under(name, prefix) for prefix in prefixes):
            continue
        reason, rel, target = ctx.file(name)
        if reason == 'file_too_large':
            stats['skipped_large'] += 1
        if reason is None and rel is not None:
            files.append([rel, target])
    stats['files_searched'] += len(files)
    job = json.dumps({'pattern': item['pattern'], 'fixed': item.get('fixed', False),
                      'files': files, 'limit': SCOUT_MAX_HITS}).encode('ascii')
    timeout = max(1, intof(os.environ.get('CS_SCOUT_PATTERN_TIMEOUT'), 10))
    try:
        result = subprocess.run([sys.executable, '-I', '-c', SCOUT_SEARCH], input=job,
                                capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 'pattern_timeout', f'{item["pattern"]!r} exceeded {timeout}s'
    if result.returncode != 0:
        return 'pattern_failed', repr(item['pattern'])
    return None, json.loads(result.stdout.decode('ascii'))


def scout_validate(report, request):
    """Deterministic acceptance. Returns (result, accepted)."""
    kind = request['kind']
    outcome = {'contract': SCOUT_CONTRACT, 'orientation_only': True, 'kind': kind}
    shape = _scout_shape(report, kind)
    if shape:
        return dict(outcome, accepted=False, shape_valid=False,
                    reasons=[{'code': 'invalid_shape', 'detail': detail} for detail in shape]), False
    ctx = _ScoutContext(request)
    reasons = []
    def reject(code, detail):
        reasons.append({'code': code, 'detail': detail})
    stats = {'evidence_checked': 0, 'max_drift': 0, 'patterns_rerun': 0, 'hits_checked': 0,
             'files_searched': 0, 'skipped_large': 0}
    current = _scout_rev()
    if request['rev']['head'] != current['head']:
        reject('rev_changed', f"request was made at {request['rev']['head']}, HEAD is now {current['head']}")

    located = {}
    for item in report['evidence']:
        reason, rel, target = ctx.file(item['file'])
        if reason:
            reject(reason, f"{item['id']} {item['file']}")
            continue
        drift = _scout_match(_scout_file_lines(target), item)
        if drift is None:
            reject('snippet_mismatch', f"{item['id']} {item['file']}:{item['line_start']}-{item['line_end']}")
            continue
        stats['evidence_checked'] += 1
        stats['max_drift'] = max(stats['max_drift'], abs(drift))
        located[item['id']] = (_scout_fold(rel), item['line_start'] + drift, item['line_end'] + drift)
    for entry in report['read_next']:
        reason, _rel, target = ctx.file(entry['file'])
        if reason:
            reject(reason, f"read_next {entry['file']}")
        elif entry['line_start'] > len(_scout_file_lines(target)):
            reject('line_out_of_range', f"read_next {entry['file']}:{entry['line_start']}")

    ids = {item['id'] for item in report['evidence']}
    status, steps = report['status'], report.get('steps') or []
    cited = SCOUT_CITE_RE.findall(report['answer'])
    for group in cited + [', '.join(step['evidence']) for step in steps]:
        for eid in csv(group):
            if eid not in ids:
                reject('unknown_evidence_id', eid)
    if status in ('answered', 'partial'):
        for sentence in re.split(r'(?<=[.!?])\s+', report['answer'].strip()):
            if sentence.strip() and not SCOUT_CITE_RE.search(sentence):
                reject('uncited_claim', sentence[:120])
        if not report['answer'].strip():
            reject('uncited_claim', 'answer is empty')
    if kind == 'locate' and status == 'answered' and not report['evidence']:
        reject('locate_without_evidence', 'answered requires at least one evidence item')
    if kind == 'trace' and status in ('answered', 'partial'):
        bare = [index for index, step in enumerate(steps) if not step['evidence']]
        if not steps:
            reject('trace_step_without_evidence', 'no steps')
        elif status == 'answered' and bare:
            reject('trace_step_without_evidence', f'step {bare[0] + 1} has no evidence; status must be partial')
        elif bare and bare[0] != len(steps) - 1:
            reject('trace_step_without_evidence', f'step {bare[0] + 1} has no evidence but the chain continues')

    rerun = kind == 'inventory' or status == 'not_found'
    if rerun and not report['searched']:
        reject('searched_missing', f'{kind} {status} requires searched patterns')
    if rerun:
        for item in report['searched']:
            reason, hits = _scout_rerun(ctx, item, stats)
            if reason:
                reject(reason, hits)
                continue
            stats['patterns_rerun'] += 1
            stats['hits_checked'] += len(hits)
            if len(hits) > SCOUT_MAX_HITS:
                reject('uncited_hit', f'{item["pattern"]!r} matches more than {SCOUT_MAX_HITS} lines')
                continue
            uncovered = [f'{rel}:{line}' for rel, line in hits
                         if not any(where == _scout_fold(rel) and start <= line <= end
                                    for where, start, end in located.values())]
            for hit in uncovered[:10]:
                reject('uncited_hit', f'{item["pattern"]!r} matches {hit}')
            if len(uncovered) > 10:
                reject('uncited_hit', f'{len(uncovered) - 10} more uncited matches')
    if ctx.claim:
        stats['read_set_of'] = ctx.claim
    if reasons:
        return dict(outcome, accepted=False, shape_valid=True, reasons=reasons, verification=stats), False
    return dict(outcome, accepted=True, report=report, verification=stats), True


def _scout_cache_key(request):
    return json_digest({'contract': SCOUT_CONTRACT, 'kind': request['kind'], 'params': request['params'],
                        'scope': {k: sorted(v) for k, v in request['scope'].items()},
                        'head': request['rev']['head']})


def _scout_cache_path(request):
    return state_path(os.path.join('scout', 'reports', _scout_cache_key(request) + '.json'))


def _scout_cacheable(request):
    """Reuse needs an exact rev with a clean tree at both requests; else a miss."""
    if request['rev']['dirty'] or not request['rev']['head']:
        return 'tree was dirty or unversioned at request'
    current = _scout_rev()
    if current['head'] != request['rev']['head']:
        return 'HEAD changed'
    if current['dirty']:
        return 'tree is dirty now'
    return None


def _scout_home():
    base = state_path('scout')
    os.makedirs(base, exist_ok=True)
    # Cache, configuration, and stats are local to this user and project: keep
    # them out of commits even where .coldsession-state/ itself is tracked for
    # the installation ownership record, so one opt-in never opts in teammates.
    ignore = os.path.join(base, '.gitignore')
    if not os.path.exists(ignore):
        atomic_write(ignore, '# coldsession scout: local only, never committed\n*\n')
    return base


def _scout_store(request, report):
    base = _scout_home()
    save_json(_scout_cache_path(request), {
        'contract': SCOUT_CONTRACT, 'orientation_only': True, 'rev': request['rev']['head'],
        'request': {k: request[k] for k in ('kind', 'params', 'scope')},
        'report': report, 'at': datetime.now().isoformat()})
    stored = sorted(glob.glob(os.path.join(base, 'reports', '*.json')), key=os.path.getmtime)
    for path in stored[:-SCOUT_CACHE_LIMIT]:
        try:
            os.unlink(path)
        except OSError:
            pass


def _scout_load(path, what):
    try:
        if path == '-':
            raw = sys.stdin.buffer.read(262145).decode('utf-8-sig', 'replace')
        else:
            if os.path.getsize(path) > 262144:
                raise ValueError(f'{what} exceeds 256 KiB')
            raw = read_text(path)
        if len(raw) > 262144:
            raise ValueError(f'{what} exceeds 256 KiB')
        return json.loads(raw)
    except (OSError, ValueError) as exc:
        return ValueError(f'{what} is not readable JSON: {exc}')


def _scout_print(result, as_json):
    if as_json:
        print(json.dumps(result, indent=2))
        return
    kind = result['kind']
    if not result['accepted']:
        print(f'scout {kind} report rejected:')
        for reason in result['reasons']:
            print(f"  {reason['code']}: {reason['detail']}")
        return
    report, stats = result['report'], result['verification']
    print(f"scout {kind}: {report['status']} (orientation only; never verification, review, or completion evidence)")
    if report['answer'].strip():
        print(report['answer'].strip())
    for item in report['evidence']:
        print(f"  {item['id']} {item['file']}:{item['line_start']}-{item['line_end']}  {item['why']}")
    for index, step in enumerate(report.get('steps') or [], 1):
        print(f"  step {index}: {step['text']} [{', '.join(step['evidence']) or 'no evidence'}]")
    for item in report['unknowns']:
        print(f'  unknown: {item}')
    for item in report['read_next']:
        print(f"  read next: {item['file']}:{item['line_start']}-{item['line_end']}")
    meta = report['meta']
    source = f"; {meta['provider']} ({meta['model']}), attempts {result['attempts']}" if 'attempts' in result else ''
    print(f"verified: snippets {stats['evidence_checked']} (max drift {stats['max_drift']}), "
          f"patterns rerun {stats['patterns_rerun']}; cache {result.get('cache', 'not stored')}{source}")


# Opt-in setup. Scout is off until a user runs `plan scout setup` and accepts
# the data-sharing disclosure; installers and upgrades never write this. The
# configuration and counters live beside the cache and share its ignore file.

SCOUT_PROVIDERS = {
    'agy': {'name': 'Antigravity CLI', 'recipient': 'Google',
            'version': ['--version'], 'models': ['models'],
            # Appended to every agy prompt: headless agy denies shell commands,
            # and a denied command ends the turn with no report.
            'note': 'Shell and terminal commands are unavailable in this session; any attempt ends it '
                    'without a report. Use only your file viewing, listing, and search tools.'},
}
SCOUT_DEFAULT_TIMEOUT = 180
SCOUT_ALWAYS_EXCLUDED = ['sensitive()'] + list(SCOUT_BUILTIN_EXCLUSIONS)
SCOUT_CONFIG_KEYS = {'experimental', 'enabled', 'provider', 'model', 'timeout_seconds',
                     'exclusions', 'threshold', 'disclosure'}
SCOUT_COUNTERS = ('runs', 'accepted', 'fallbacks', 'cache_hits', 'retries', 'timeouts', 'tree_changes')
SCOUT_MAX_REASONS = 32


def _scout_config_path():
    return state_path(os.path.join('scout', 'config.json'))


def _scout_config():
    """The saved configuration, None when scout was never set up. Raises ValueError when invalid."""
    config = load_json(_scout_config_path())
    if config is None:
        return None
    if not isinstance(config, dict) or set(config) - SCOUT_CONFIG_KEYS:
        raise ValueError('scout config must be an object with only ' + ', '.join(sorted(SCOUT_CONFIG_KEYS)))
    if not isinstance(config.get('enabled'), bool) or config.get('provider') not in SCOUT_PROVIDERS:
        raise ValueError('scout config needs enabled true/false and a supported provider')
    if not isinstance(config.get('model', ''), str) or not isinstance(config.get('exclusions', []), list):
        raise ValueError('scout config model must be a string and exclusions a list')
    timeout = config.get('timeout_seconds', SCOUT_DEFAULT_TIMEOUT)
    if not isinstance(timeout, int) or isinstance(timeout, bool) or not 10 <= timeout <= 3600:
        raise ValueError('scout config timeout_seconds must be an integer from 10 to 3600')
    return config


def _scout_config_or_die(required=False):
    try:
        config = _scout_config()
    except ValueError as exc:
        die(f'{exc}; rerun plan scout setup')
    if required and config is None:
        die('scout is not set up; run plan scout setup first')
    return config


def _scout_stats():
    stats = load_json(state_path(os.path.join('scout', 'stats.json')), {})
    stats = stats if isinstance(stats, dict) else {}
    counters = {key: stats[key] if isinstance(stats.get(key), int) else 0 for key in SCOUT_COUNTERS}
    rejected = stats.get('rejected') if isinstance(stats.get('rejected'), dict) else {}
    counters['rejected'] = {str(k): v for k, v in rejected.items() if isinstance(v, int)}
    counters['last_check'] = stats.get('last_check') if isinstance(stats.get('last_check'), dict) else None
    return counters


def _scout_record(**change):
    """Update the bounded counters. Diagnostic only: a lost update is tolerable, a torn file is not."""
    try:
        stats = _scout_stats()
        for key in SCOUT_COUNTERS:
            stats[key] += change.get(key, 0)
        for code in change.get('rejected', ()):
            code = code if code in stats['rejected'] or len(stats['rejected']) < SCOUT_MAX_REASONS else 'other'
            stats['rejected'][code] = stats['rejected'].get(code, 0) + 1
        if 'last_check' in change:
            stats['last_check'] = change['last_check']
        _scout_home()
        save_json(state_path(os.path.join('scout', 'stats.json')), stats)
    except (OSError, ValueError):
        pass  # Counters never change what a scout command decides or prints.


def _scout_counting():
    try:
        return _scout_config() is not None
    except (OSError, ValueError):
        return False


def _scout_tail(output):
    lines = [line.strip() for line in redact(output).splitlines() if line.strip()]
    return (lines[-1] if lines else 'no output')[:200]


def _scout_check(provider, models=True):
    """Bounded health check. Authentication and quota are never claimed: they stay unknown."""
    spec = SCOUT_PROVIDERS[provider]
    check = {'provider': provider, 'at': datetime.now().isoformat(timespec='seconds'),
             'cli': shutil.which(provider), 'result': 'ok', 'detail': '', 'version': None,
             'models': None, 'auth': 'unknown', 'quota': 'unknown'}
    if not check['cli']:
        check.update(result='missing', detail=f'{provider} ({spec["name"]}) is not on PATH')
        return check
    ran = bounded_run([check['cli'], *spec['version']], timeout=15, shell=False)
    if ran['exit'] != 0 or ran['timeout']:
        why = 'timed out' if ran['timeout'] else f"exited {ran['exit']}: {_scout_tail(ran['output'])}"
        check.update(result='failing', detail=f'{provider} {" ".join(spec["version"])} {why}')
        return check
    check['version'] = _scout_tail(ran['output'])
    if models and spec.get('models'):
        ran = bounded_run([check['cli'], *spec['models']], timeout=60, shell=False)
        if ran['exit'] == 0 and not ran['timeout'] and not ran['truncated']:
            # One model per line: an identifier, a tab, then its display name.
            listed = [line.split('\t', 1)[0].strip() for line in ran['output'].splitlines() if '\t' in line]
            check['models'] = [name for name in listed if name] or None
        if check['models'] is None:
            check['detail'] = 'model list unavailable; authentication or quota may need attention'
    return check


def _scout_check_model(check, model):
    if model and check['models'] is not None and model not in check['models']:
        die(f"model {model!r} is not offered by {check['provider']}; choose one of: {', '.join(check['models'])}")
    return model and check['models'] is None


def _scout_disclosure(provider):
    spec = SCOUT_PROVIDERS[provider]
    return (f"Scout is experimental. When it runs, repository content inside each request's scope is sent "
            f"to {spec['recipient']} through {provider} ({spec['name']}). sensitive() paths, "
            f".coldsession-state/, and your exclusions are never in scope. Coldsession adds no spending cap; "
            f"usage is governed by the provider's own limits.")


def _scout_terminal():
    """Whether stdin is a person at a terminal. Windows reports NUL as a tty, so ask the console."""
    try:
        if not sys.stdin or not sys.stdin.isatty():
            return False
        if os.name != 'nt':
            return True
        import ctypes
        import msvcrt
        mode = ctypes.c_ulong()
        return bool(ctypes.windll.kernel32.GetConsoleMode(msvcrt.get_osfhandle(sys.stdin.fileno()), ctypes.byref(mode)))
    except (OSError, ValueError, AttributeError):
        return False


def _scout_confirm(provider):
    """Interactive acceptance on a terminal only. Piped or closed input is never consent."""
    if not _scout_terminal():
        return False
    try:
        answer = input(f'Type yes to share repository content with {SCOUT_PROVIDERS[provider]["recipient"]}: ')
    except EOFError:
        return False
    return answer.strip().lower() == 'yes'


def _scout_show_check(check):
    print(f"provider: {check['provider']} ({check['result']}){': ' + check['detail'] if check['detail'] else ''}")
    if check['version']:
        print(f"version: {check['version']}; authentication: {check['auth']}; quota: {check['quota']}")


def _scout_options(rest, flags, repeat=()):
    """Parse --flag VALUE pairs; repeated ones collect into lists."""
    values, extra, index = {key: [] for key in repeat}, [], 0
    while index < len(rest):
        key = rest[index]
        if key in flags or key in repeat:
            if index + 1 >= len(rest):
                die(f'{key} needs a value')
            if key in repeat:
                values[key].append(rest[index + 1])
            elif key in values:
                die(f'{key} was given twice')
            else:
                values[key] = rest[index + 1]
            index += 2
        else:
            extra.append(key)
            index += 1
    return values, extra


def _scout_exclusion(value):
    try:
        entry = _scout_entry(value)
    except ValueError as exc:
        die(str(exc))
    if entry == '.':
        die('excluding the whole repository would leave nothing to scout; run plan scout disable instead')
    return entry


def scout_setup(rest, as_json):
    options, extra = _scout_options(rest, ('--provider', '--model', '--timeout'), repeat=('--exclude',))
    accepted = '--accept-data-sharing' in extra
    extra = [value for value in extra if value != '--accept-data-sharing']
    if extra:
        die(f"unexpected setup arguments: {' '.join(extra)}")
    provider = options.get('--provider', 'agy')
    if provider not in SCOUT_PROVIDERS:
        die(f"unsupported scout provider {provider!r}; supported: {', '.join(SCOUT_PROVIDERS)}")
    try:
        previous = _scout_config() or {}
    except ValueError:
        # Setup is the repair path: keep valid exclusions (the bare
        # {"exclusions": [...]} form predates setup) and rewrite the rest.
        raw = load_json(_scout_config_path(), {})
        kept = raw.get('exclusions') if isinstance(raw, dict) else None
        previous = {'exclusions': kept if isinstance(kept, list) else []}
    if previous.get('provider') != provider:
        previous = {'exclusions': previous.get('exclusions', [])}
    timeout = options.get('--timeout', previous.get('timeout_seconds', SCOUT_DEFAULT_TIMEOUT))
    try:
        timeout = int(timeout)
    except ValueError:
        die('--timeout takes whole seconds')
    if not 10 <= timeout <= 3600:
        die('--timeout must be from 10 to 3600 seconds')
    exclusions = []
    for value in previous.get('exclusions', []):
        try:
            entry = _scout_entry(value)
        except ValueError:
            continue  # Unusable entries from a hand-edited file are dropped, not trusted.
        if entry != '.' and entry not in exclusions:
            exclusions.append(entry)
    for value in options['--exclude']:
        entry = _scout_exclusion(value)
        if entry not in exclusions:
            exclusions.append(entry)
    check = _scout_check(provider)
    _scout_record(last_check={k: check[k] for k in ('provider', 'result', 'detail', 'at')})
    disclosure = _scout_disclosure(provider)
    result = {'experimental': True, 'check': check, 'disclosure': disclosure, 'enabled': False}
    def refuse(message):
        if as_json:
            print(json.dumps(dict(result, error=message), indent=2))
        die(message)
    if check['result'] != 'ok':
        if not as_json:
            _scout_show_check(check)
        refuse(f"scout was not enabled: {check['detail']}")
    model = options.get('--model', previous.get('model', '')).strip()
    if len(model) > 200 or re.search(r'\s', model):
        die('a model name is one word of at most 200 characters')
    unvalidated = _scout_check_model(check, model)
    if not as_json:
        _scout_show_check(check)
        print('\n' + disclosure + '\n')
    if not accepted:
        if as_json:
            print(disclosure, file=sys.stderr)
        accepted = _scout_confirm(provider)
    if not accepted:
        refuse('scout was not enabled: data sharing was not accepted '
               '(non-interactive setup needs --accept-data-sharing)')
    config = {'experimental': True, 'enabled': True, 'provider': provider, 'model': model,
              'timeout_seconds': timeout, 'exclusions': exclusions, 'threshold': 'strict',
              'disclosure': {'recipient': SCOUT_PROVIDERS[provider]['recipient'],
                             'accepted_at': datetime.now().isoformat(timespec='seconds')}}
    _scout_home()
    save_json(_scout_config_path(), config)
    result.update(enabled=True, config=config, always_excluded=SCOUT_ALWAYS_EXCLUDED)
    if as_json:
        print(json.dumps(result, indent=2))
        return 0
    print(f"scout enabled (experimental): {provider}, model {model or 'provider default'}"
          f"{' (not validated: the provider did not list models)' if unvalidated else ''}, "
          f"timeout {timeout}s")
    print(f"always excluded: {', '.join(SCOUT_ALWAYS_EXCLUDED)}"
          f"{'; also excluded: ' + ', '.join(exclusions) if exclusions else ''}")
    print('change the model with plan scout model NAME; turn scout off with plan scout disable')
    return 0


def scout_configure(action, rest, as_json):
    """model, exclude, and disable: edits that never repeat setup or its disclosure."""
    config = _scout_config_or_die(required=action != 'disable')
    if config is None:
        print('scout is not set up; nothing to disable')
        return 0
    note = ''
    if action == 'disable':
        if rest:
            die('usage: plan scout disable')
        config['enabled'] = False
        note = 'scout disabled; cached reports and stats were kept'
    elif action == 'model':
        if len(rest) != 1:
            die('usage: plan scout model NAME|--default')
        model = '' if rest[0] == '--default' else rest[0].strip()
        if len(model) > 200 or re.search(r'\s', model):
            die('a model name is one word of at most 200 characters')
        check = _scout_check(config['provider'])
        if check['result'] == 'ok':
            unvalidated = _scout_check_model(check, model)
        else:
            unvalidated = bool(model)
        config['model'] = model
        note = f"scout model: {model or 'provider default'}" + (
            ' (not validated: the provider did not list models)' if unvalidated else '')
    else:
        if len(rest) < 2 or rest[0] not in ('add', 'remove'):
            die('usage: plan scout exclude add|remove PATH...')
        entries = [_scout_exclusion(value) for value in rest[1:]]
        exclusions = list(config.get('exclusions', []))
        for entry in entries:
            if rest[0] == 'add':
                if entry not in exclusions:
                    exclusions.append(entry)
                continue
            if sensitive(entry) or any(_scout_under(entry, p) for p in SCOUT_BUILTIN_EXCLUSIONS):
                die(f'{entry} is always excluded ({", ".join(SCOUT_ALWAYS_EXCLUDED)}) and cannot be removed')
            if entry not in exclusions:
                die(f'{entry} is not a configured exclusion')
            exclusions.remove(entry)
        config['exclusions'] = exclusions
        note = f"always excluded: {', '.join(SCOUT_ALWAYS_EXCLUDED)}; also excluded: {', '.join(exclusions) or 'nothing'}"
    save_json(_scout_config_path(), config)
    print(json.dumps({'config': config, 'always_excluded': SCOUT_ALWAYS_EXCLUDED}, indent=2) if as_json else note)
    return 0


def scout_doctor():
    """Doctor's scout entry: one flag when never set up, otherwise config, CLI, last check, and counters."""
    try:
        config = _scout_config()
    except (OSError, ValueError) as exc:
        return {'experimental': True, 'enabled': False, 'error': f'invalid scout config: {exc}'}
    if config is None:
        return {'experimental': True, 'enabled': False}
    stats = _scout_stats()
    last = stats.pop('last_check')
    return {'experimental': True, 'enabled': config['enabled'], 'provider': config['provider'],
            'model': config.get('model') or 'provider default',
            'timeout_seconds': config.get('timeout_seconds', SCOUT_DEFAULT_TIMEOUT),
            'cli_detected': bool(shutil.which(config['provider'])),
            'last_check': {k: last.get(k) for k in ('result', 'at', 'detail')} if last else None,
            'counters': stats}


# The host-facing instructions for a run, beside this runtime in both installs:
# .claude/commands/ and .agents/coldsession/commands/ sit next to bin/.
SCOUT_GUIDE = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'commands', 'cs-scout.md')


def scout_status(as_json):
    """Whether a host should try scout now: exit 0 only when a run could reach the provider.

    Workflow commands ask this before broad exploration, so with scout off it
    costs one local call and one line, and nothing else changes.
    """
    info = scout_doctor()
    if info.get('error'):
        reason = info['error']
    elif 'provider' not in info:
        reason = 'not set up'
    elif not info['enabled']:
        reason = 'disabled'
    elif not info['cli_detected']:
        reason = f"{info['provider']} is not on PATH"
    else:
        reason = None
    guide = os.path.relpath(SCOUT_GUIDE, ROOT).replace(os.sep, '/')
    if guide.startswith('..') or os.path.isabs(guide):
        guide = SCOUT_GUIDE
    if as_json:
        print(json.dumps({'experimental': True, 'available': reason is None, 'reason': reason,
                          'provider': info.get('provider'), 'model': info.get('model'),
                          'timeout_seconds': info.get('timeout_seconds'),
                          'guide': guide if reason is None else None}, indent=2))
    elif reason:
        print(f'scout off ({reason}); explore natively')
    else:
        print(f"scout on (experimental): {info['provider']}, model {info['model']}, "
              f"timeout {info['timeout_seconds']}s")
        print(f'before exploring, read {guide} and follow its "Run a request" and "Use the report" sections')
    return 1 if reason else 0


# Provider run. agy (verified on Windows, 1.2.6) has no read-only mode: with a
# workspace set, print mode reads and writes files there without prompting and
# soft-denies shell commands; --mode plan approves its own plan and then
# writes; --sandbox restricts only terminal commands and on Windows asks the OS
# for consent; --dangerously-skip-permissions also approves shell commands and
# unsandboxed retries. So scout never passes bypass, plan mode, or sandbox. The
# provider's workspace is a disposable copy holding only the in-scope files,
# and the real tree is snapshotted before and compared after. A change there
# rejects the report and is reported, never reverted.

SCOUT_STAGE_FILES = 20000
SCOUT_STAGE_BYTES = 64 * 1024 * 1024
SCOUT_OUTPUT_LIMIT = 256 * 1024


def _scout_file_digest(path):
    try:
        info = os.stat(path)
        if info.st_size > SCOUT_MAX_FILE:
            return f'stat:{info.st_size}:{info.st_mtime_ns}'
        with open(path, 'rb') as handle:
            return hashlib.sha256(handle.read()).hexdigest()
    except OSError:
        return None


def _scout_snapshot():
    """HEAD, porcelain status, and digests of every modified or untracked file; None without git."""
    head = _scout_git('rev-parse', '--verify', 'HEAD')
    status = _scout_git('status', '--porcelain=v1', '-z', '--untracked-files=all')
    listed = _scout_git('ls-files', '-z', '--modified', '--others', '--exclude-standard')
    if head is None or status is None or listed is None:
        return None
    entries, tokens, index = {}, status.split('\0'), 0
    while index < len(tokens):
        token = tokens[index]
        index += 1
        if len(token) > 3:
            entries[token[3:]] = token[:2]
            if token[0] in 'RC':
                index += 1  # the rename or copy source follows
    files = {name: _scout_file_digest(os.path.join(ROOT, name)) for name in set(listed.split('\0')) if name}
    return {'head': head.strip(), 'status': entries, 'files': files}


def _scout_tree_changes(before, after):
    if after is None:
        return ['(git state became unreadable)']
    changed = [] if before['head'] == after['head'] else [f"HEAD {before['head'][:12]} -> {after['head'][:12]}"]
    names = set(before['status']) | set(after['status']) | set(before['files']) | set(after['files'])
    return changed + sorted(name for name in names
                            if before['status'].get(name) != after['status'].get(name)
                            or before['files'].get(name) != after['files'].get(name))


def _scout_stage(request, stage):
    """Copy the files the request may cite into STAGE; return {relative path: digest}."""
    ctx = _ScoutContext(request)
    staged, total = {}, 0
    for name in ctx.candidates():
        resolved = ctx.rel(name)
        if isinstance(resolved, str):
            continue
        rel, target = resolved
        if (not os.path.isfile(target) or ctx.blocked(name) or ctx.blocked(rel)
                or not (ctx.in_scope(name) and ctx.in_scope(rel))
                or (ctx.allowed is not None and os.path.normcase(target) not in ctx.allowed)):
            continue
        try:
            if os.path.getsize(target) > SCOUT_MAX_FILE:
                continue
            with open(target, 'rb') as handle:
                data = handle.read()
        except OSError:
            continue
        total += len(data)
        if len(staged) >= SCOUT_STAGE_FILES or total > SCOUT_STAGE_BYTES:
            raise ValueError(f'scope is too large to stage (over {SCOUT_STAGE_FILES} files or '
                             f'{SCOUT_STAGE_BYTES // (1024 * 1024)} MiB); narrow --include')
        dest = os.path.join(stage, *name.split('/'))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, 'wb') as handle:
            handle.write(data)
        staged[name] = hashlib.sha256(data).hexdigest()
    return staged


def _scout_stage_changes(stage, staged):
    found = {}
    for base, _dirs, files in os.walk(stage):
        for name in files:
            path = os.path.join(base, name)
            found[os.path.relpath(path, stage).replace(os.sep, '/')] = _scout_file_digest(path)
    return sorted(name for name in set(found) | set(staged) if found.get(name) != staged.get(name))


def _scout_kind_schema(kind):
    """The report schema narrowed to KIND, as the validator reads it: only trace has steps, and needs them.

    agy fills every optional property a schema offers, so the shared schema
    would draw steps into locate and inventory reports.
    """
    schema = json.loads(_scout_read('report.schema.json'))
    if kind == 'trace':
        schema['required'] = schema['required'] + ['steps']
    else:
        del schema['properties']['steps']
    return json.dumps(schema, separators=(',', ':'))


def _scout_agy_command(cli, config, stage, request, timeout):
    # The prompt goes last and attached to its flag: agy otherwise takes the
    # next word as the prompt.
    prompt = request['prompt']
    command = [cli, '--add-dir', stage, '--output-format', 'json',
               '--json-schema', _scout_kind_schema(request['kind']),
               '--print-timeout', f'{max(5, timeout - 5)}s', '--disable-slash-commands']
    if config.get('model'):
        command += ['--model', config['model']]
    return command + ['--print=' + prompt.rstrip('\n') + '\n\n' + SCOUT_PROVIDERS['agy']['note'] + '\n']


def _scout_unstage(report, stage):
    """Map staging-copy paths the provider may cite back to repository-relative ones."""
    # The provider may cite the stage as given (e.g. an 8.3 short name on
    # Windows) or fully resolved, so either form maps back.
    prefixes = {_scout_fold(p.replace('\\', '/').rstrip('/') + '/')
                for p in (stage, os.path.realpath(stage))}
    def fix(value):
        if not isinstance(value, str):
            return value
        text = value.replace('\\', '/')
        text = re.sub(r'^file:///(?=[A-Za-z]:)', '', text)
        text = re.sub(r'^file://', '', text)
        for prefix in prefixes:
            if _scout_fold(text).startswith(prefix):
                return text[len(prefix):]
        return value
    for key in ('evidence', 'read_next'):
        for item in report.get(key) or []:
            if isinstance(item, dict) and 'file' in item:
                item['file'] = fix(item['file'])
    for item in report.get('searched') or []:
        if isinstance(item, dict) and isinstance(item.get('paths'), list):
            item['paths'] = [fix(path) for path in item['paths']]
    return report


def _scout_provider_report(ran, stage):
    """(report, None), or (None, (kind, detail)) where kind 'shape' may be retried and 'failed' may not."""
    envelope = None
    for line in reversed(ran['output'].splitlines()):
        line = line.strip()
        if line.startswith('{'):
            try:
                value = json.loads(line)
            except ValueError:
                continue
            if isinstance(value, dict) and 'status' in value:
                envelope = value
                break
    if ran['exit'] != 0:
        return None, ('failed', f"exited {ran['exit']}: {_scout_tail(ran['errors'] or ran['output'])}")
    if envelope is None:
        return None, ('shape', 'output was truncated' if ran['truncated']
                      else f"no JSON result in the output ({_scout_tail(ran['errors'] or ran['output'])[:120]})")
    if envelope.get('status') != 'SUCCESS':
        return None, ('failed', f"reported status {str(envelope.get('status'))[:40]}")
    report = envelope.get('structured_output')
    if not isinstance(report, dict):
        denied = [str(d.get('action'))[:40] for d in envelope.get('denied_actions') or [] if isinstance(d, dict)]
        return None, ('shape', 'no structured report' + ('; denied: ' + ', '.join(denied[:5]) if denied else ''))
    return _scout_unstage(report, stage), None


def _scout_fallback(reason, as_json, **extra):
    # Details can quote provider output, so they are filtered like any other.
    reason = ' '.join(redact(reason).split())
    if 'reasons' in extra:
        extra['reasons'] = [dict(item, detail=redact(item['detail'])) for item in extra['reasons']]
    line = f'scout unavailable ({reason}); explore natively'
    print(json.dumps(dict({'accepted': False, 'fallback': line, 'reason': reason}, **extra), indent=2)
          if as_json else line)
    return 1


def _scout_cache_lookup(request):
    """(accepted result, None) on a hit, else (None, reason). A stored report that no longer validates is dropped."""
    path = _scout_cache_path(request)
    miss = _scout_cacheable(request) or (None if os.path.exists(path) else 'no stored report')
    if miss:
        return None, miss
    stored = load_json(path, {}) or {}
    result, accepted = scout_validate(stored.get('report'), request)
    if accepted:
        result['cache'] = 'hit'
        return result, None
    try:
        os.unlink(path)
    except OSError:
        pass
    return None, 'stored report no longer validates'


def _scout_alert(provider, changed):
    shown = changed[:20] + ([f'... and {len(changed) - 20} more'] if len(changed) > 20 else [])
    print('!' * 72 + f'\nSCOUT ALERT: {provider} changed the working tree during a read-only request.\n'
          'The report was rejected. Nothing was reverted; review these paths yourself:\n'
          + ''.join(f'  {path}\n' for path in shown) + '!' * 72, file=sys.stderr)


def scout_run(request, as_json):
    """Answer REQUEST from the cache or the configured provider: a validated report or one fallback line."""
    try:
        config = _scout_config()
    except ValueError as exc:
        return _scout_fallback(f'invalid scout config: {exc}; rerun plan scout setup', as_json)
    if config is None:
        return _scout_fallback('scout is not set up; run plan scout setup to opt in', as_json)
    if not config['enabled']:
        return _scout_fallback('scout is disabled; run plan scout setup to enable it', as_json)
    hit, _miss = _scout_cache_lookup(request)
    if hit:
        _scout_record(cache_hits=1)
        _scout_print(hit, as_json)
        return 0
    provider = config['provider']
    def fallback(reason, rejected=(), **extra):
        _scout_record(fallbacks=1, rejected=rejected)
        return _scout_fallback(reason, as_json, **extra)
    cli = shutil.which(provider)
    if not cli:
        return fallback(f'{provider} is not on PATH')
    if os.name == 'nt' and os.path.splitext(cli)[1].lower() in ('.bat', '.cmd'):
        return fallback(f'{provider} resolves to a batch launcher, which cannot pass the request safely')
    _scout_home()  # its ignore file must exist before the snapshot, or our own counters would look like a change
    before = _scout_snapshot()
    if before is None or not request['rev']['head']:
        return fallback('the tree cannot be checked without a git repository and a commit')
    if before['head'] != request['rev']['head']:
        return fallback('HEAD changed since the request was made; regenerate it')
    timeout = config.get('timeout_seconds', SCOUT_DEFAULT_TIMEOUT)
    stage = tempfile.mkdtemp(prefix='coldsession-scout-')
    try:
        try:
            staged = _scout_stage(request, stage)
        except ValueError as exc:
            return fallback(str(exc))
        if not staged:
            return fallback('nothing in scope to scout')
        command = _scout_agy_command(cli, config, stage, request, timeout)
        for attempt in (1, 2):
            _scout_record(runs=1, retries=attempt - 1)
            ran = bounded_run(command, timeout=timeout, shell=False, cwd=stage,
                              limit=SCOUT_OUTPUT_LIMIT, stdin=subprocess.DEVNULL, split=True, clean=None)
            changed = _scout_tree_changes(before, _scout_snapshot())
            if changed:
                _scout_alert(provider, changed)
                _scout_record(tree_changes=1)
                return fallback(f'{provider} changed the working tree ({len(changed)} path(s)); nothing was reverted',
                                rejected=['tree_changed'], tree_changed=changed[:200])
            if ran['timeout']:
                _scout_record(timeouts=1)
                return fallback(f'{provider} timed out after {timeout}s')
            if _scout_stage_changes(stage, staged):
                return fallback(f'{provider} wrote files during a read-only request', rejected=['provider_wrote'])
            report, problem = _scout_provider_report(ran, stage)
            if problem and problem[0] == 'failed':
                return fallback(f'{provider} {problem[1]}')
            if report is not None:
                report['meta'] = {'provider': provider, 'model': config.get('model') or 'provider default'}
                result, accepted = scout_validate(report, request)
                if accepted:
                    break
                codes = sorted({reason['code'] for reason in result['reasons']})
                if result['shape_valid']:
                    return fallback('report failed validation: ' + ', '.join(codes), rejected=codes,
                                    reasons=result['reasons'][:SCOUT_MAX_REASONS])
                problem = ('shape', '; '.join(reason['detail'] for reason in result['reasons'][:3]))
            if attempt == 2:
                return fallback(f'invalid report shape twice: {problem[1][:200]}', rejected=['invalid_shape'])
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    _scout_record(accepted=1)
    result['attempts'] = attempt
    miss = _scout_cacheable(request)
    if miss:
        result['cache'] = f'not stored ({miss})'
    else:
        _scout_store(request, report)
        result['cache'] = 'stored'
    _scout_print(result, as_json)
    return 0


def cmd_scout(_phase, args):
    usage = ('usage: plan scout template KIND | request KIND NAME=VALUE... --purpose TEXT '
             '[--include PATH]... [--exclude PATH]... [--known TEXT]... | '
             'validate REPORT.json --request REQUEST.json [--json] | cached --request REQUEST.json [--json] | '
             'run --request REQUEST.json [--json] | run KIND NAME=VALUE... --purpose TEXT [--include PATH]... '
             '[--exclude PATH]... [--known TEXT]... [--json] | status [--json] | '
             'setup [--provider agy] [--model NAME] [--timeout SECONDS] [--exclude PATH]... '
             '[--accept-data-sharing] [--json] | model NAME|--default | exclude add|remove PATH... | disable')
    if not args or args[0] not in ('template', 'request', 'validate', 'cached', 'run', 'status', 'setup', 'model',
                                   'exclude', 'disable'):
        die(usage)
    action, rest = args[0], list(args[1:])
    as_json = '--json' in rest
    rest = [value for value in rest if value != '--json']
    if action == 'status':
        if rest:
            die(usage)
        return scout_status(as_json)
    if action == 'setup':
        return scout_setup(rest, as_json)
    if action in ('model', 'exclude', 'disable'):
        return scout_configure(action, rest, as_json)
    if action == 'template':
        if len(rest) != 1:
            die(usage)
        version, names, body = _scout_template(rest[0])
        print(f"{rest[0]} template v{version['version']} (common v{version['common']}); "
              f"parameters: {', '.join(names)}\n")
        print(body, end='')
        return 0
    options, positional, index = {'--include': [], '--exclude': [], '--known': [], '--purpose': [], '--request': []}, [], 0
    while index < len(rest):
        if rest[index] in options:
            if index + 1 >= len(rest):
                die(usage)
            options[rest[index]].append(rest[index + 1])
            index += 2
        else:
            positional.append(rest[index])
            index += 1
    # A run may carry its request inline, so a host needs no request file:
    # one written into the tree would make it dirty and defeat the cache.
    if action == 'request' or (action == 'run' and not options['--request']):
        if not positional or len(options['--purpose']) != 1 or options['--request']:
            die(usage)
        params = {}
        for pair in positional[1:]:
            if '=' not in pair:
                die(f'template parameters are NAME=VALUE, got {pair!r}')
            name, value = pair.split('=', 1)
            params[name.strip()] = value
        try:
            request = scout_request(positional[0], params, options['--include'] or None, options['--exclude'],
                                    options['--known'], options['--purpose'][0])
        except ValueError as exc:
            die(f'invalid scout request: {exc}')
        if action == 'run':
            return scout_run(request, as_json)
        print(json.dumps(request, indent=2))
        return 0
    if len(options['--request']) != 1 or any(options[key] for key in ('--include', '--exclude', '--known', '--purpose')):
        die(usage)
    request = _scout_load(options['--request'][0], 'request')
    if isinstance(request, ValueError):
        die(str(request))
    request = _scout_check_request(request)
    if action in ('cached', 'run') and positional:
        die(usage)
    if action == 'run':
        return scout_run(request, as_json)
    if action == 'cached':
        result, miss = _scout_cache_lookup(request)
        if result:
            if _scout_counting():
                _scout_record(cache_hits=1)
            _scout_print(result, as_json)
            return 0
        print(json.dumps({'hit': False, 'reason': miss}) if as_json else f'scout cache miss ({miss})')
        return 1
    if len(positional) != 1:
        die(usage)
    report = _scout_load(positional[0], 'report')
    if isinstance(report, ValueError):
        result = {'contract': SCOUT_CONTRACT, 'orientation_only': True, 'kind': request['kind'],
                  'accepted': False, 'shape_valid': False,
                  'reasons': [{'code': 'invalid_shape', 'detail': str(report)}]}
        accepted = False
    else:
        result, accepted = scout_validate(report, request)
    if _scout_counting():
        if accepted:
            _scout_record(accepted=1)
        else:
            _scout_record(rejected=sorted({reason['code'] for reason in result['reasons']}))
    if accepted:
        miss = _scout_cacheable(request)
        if miss:
            result['cache'] = f'not stored ({miss})'
        else:
            _scout_store(request, report)
            result['cache'] = 'stored'
    _scout_print(result, as_json)
    return 0 if accepted else 1


COMMANDS = {"version": cmd_version, "status": cmd_status, "lint": cmd_lint,
            "next": cmd_next, "brief": cmd_brief, "start": cmd_start,
            "done": cmd_done, "block": cmd_block, "begin": cmd_begin,
            "finish": cmd_finish,
            "findings": cmd_findings, "resolve": cmd_resolve, "bump": cmd_bump,
            "reviewed": cmd_reviewed, "recommend": cmd_recommend,
            "metrics": cmd_metrics, "guard": cmd_guard,
            "verify": cmd_verify, "replan": cmd_replan, "doctor": cmd_doctor,
            "handoff": cmd_handoff, "assign": cmd_assign, "integrate": cmd_integrate,
            "issue": cmd_issue, "scout": cmd_scout, "recover": None}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    name = argv[0]
    if name not in COMMANDS:
        die(f"unknown command {name!r}. Try: {', '.join(COMMANDS)}")
    if name in ("version", "metrics", "guard", "doctor", "issue", "scout"):
        # None of the three answer from a `current:` phase: version needs no
        # phase file at all, metrics scans every phase file itself, and guard
        # reads plan state defensively because it runs from a hook in
        # whatever repository the user is in. None may go through
        # read_phase(read_index()) -- that dies on a repo with no PLAN.md
        # yet, which is exactly the case both must fail open on.
        return COMMANDS[name](None, argv[1:])
    if name not in MUTATING:
        path = read_index()
        return COMMANDS[name](read_phase(path), argv[1:]) or 0

    # The lock spans the read as well as the write: a command that parsed the
    # file before another finished writing it would overwrite that write.
    lock = _lock_acquire(INDEX)
    try:
        upgrade = load_json(state_path('upgrade.json'), {})
        if upgrade.get('status') not in (None, 'complete', 'rolled-back'):
            die('installation update is incomplete; run installer --recover before workflow mutations')
        if os.environ.get('CS_WORKER_ASSIGNMENT'):
            die('workers cannot mutate shared workflow state; return results to the coordinator')
        recover_transaction()
        if name == 'recover':
            print('workflow transaction recovery complete')
            return 0
        path = read_index()
        phase = read_phase(path)
        validate_transition(phase, name, argv[1:])
        rc = COMMANDS[name](phase, argv[1:]) or 0
    finally:
        _lock_release(lock)
    if rc == 0:
        _orca_mirror()
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, IndexError, AttributeError) as exc:
        die(f'cannot validate workflow state: {exc}; run plan doctor and repair the reported file')
