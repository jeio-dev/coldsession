#!/usr/bin/env python3
"""plan - dependency and context tooling for the planning workflow.

Reads PLAN.md (an index) and the phase file it points at. The phase file's
frontmatter carries a machine-readable task graph, its `## Findings` block
carries a machine-readable finding list, and the body carries the prose.
Stdlib only, no install step.

  plan status                     where the phase stands, and what to run next
  plan recommend                  one line: the next command to run, and why
  plan lint                       validate graph and findings, exit 1 on error
  plan next [--parallel]          next runnable task ids
  plan brief T2                   bounded read list, token budget, verify line
  plan done T2                    mark a task done
  plan block T2 "reason"          mark a task blocked
  plan findings [--open]          the finding list
  plan resolve F1 STATE "note"    set a finding state, log it to the changelog
  plan begin STAGE [--resume]      claim review/revise/approve/close
  plan finish STAGE [--pass|--fail] complete a claimed stage
  plan start T2 [--resume]         claim one approved build task
  plan verify T2 [--attest TEXT]  run checks and record matching evidence
  plan replan [--recover-claims]  preserve history and return unfinished work to draft
  plan doctor [--json]             runtime, adapters, hooks, trust, and gaps
  plan recover                    replay an interrupted workflow transaction
  plan assign BACKEND [--max N]   coordinator claims one approved worker group
  plan integrate RESULT.json      accept a current verified worker result
  plan handoff T2 JSON|--stdin    record a bounded structured handoff
  plan bump                       bump the phase rev, at the start of a revise
  plan reviewed                   record that this rev has had a review pass
  plan metrics                    deterministic workflow metrics across every phase
  plan guard KIND [target]        shared hook checks; quiet for unrelated projects
  plan version                    print the coldsession release version
"""

import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import shutil
import threading
import uuid
import shlex
from pathlib import Path
from datetime import datetime

TOOL_VERSION = "3.0.0"
FORMAT_VERSION = "2.0.0"

ROOT = os.path.realpath(os.environ.get("PLAN_ROOT", "."))
INDEX = os.path.join(ROOT, "PLAN.md")
AGENTS_PATH = os.path.join(ROOT, "AGENTS.md")
AGENTS_MD_BUDGET = 60
# Soft budget on direct task context. Shared prose, inherited legacy scope,
# and package-manager lockfiles are reported separately. This is advisory.
BRIEF_TOKEN_BUDGET = 12000
LOCKFILE_NAMES = frozenset((
    'package-lock.json', 'npm-shrinkwrap.json', 'yarn.lock', 'pnpm-lock.yaml',
    'bun.lock', 'bun.lockb', 'Cargo.lock', 'poetry.lock', 'uv.lock', 'Pipfile.lock',
    'composer.lock', 'Gemfile.lock',
))

TASK_RE = re.compile(r"^\s{2}(T\d+):\s*\{(.*)\}\s*$")
HEAD_RE = re.compile(r"^##\s+(.+?)\s*$")
TASK_HEAD_RE = re.compile(r"^(T\d+)\b")
FINDING_RE = re.compile(r"^F\d+\b")
CHANGE_RE = re.compile(r"^rev\s+(\d+)\s*\|\s*(F\d+)\s*\|\s*([A-Za-z_-]+)\s*\|\s*(.*)$")
LIST_RE = lambda k: re.compile(k + r":\s*\[([^\]]*)\]")
WORD_RE = lambda k: re.compile(k + r":\s*([A-Za-z_-]+)")
# Owner ids are opaque and come from the surface, not from us: an Orca
# terminal handle or a Claude Code session id. Match anything up to the next
# field separator rather than a word, so a new surface's id shape needs no
# change here.
OWNER_RE = re.compile(r"owner:\s*([^,}\s]+)")
STATUSES = ("pending", "in_progress", "done", "blocked")
PSTATUSES = ("draft", "approved", "closed")
FSTATUSES = ("open", "resolved", "accepted")
SEVERITIES = ("Critical", "High", "Medium", "Low")
META_KEYS = ("phase", "rev", "status", "reviewed", "ready", "active",
             "active-rev", "workflow-rev", "ready-spec", "reviewed-spec",
             "active-spec", "reconciliation")
STAGES = ("review", "revise", "approve", "close")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def read_text(path):
    """Read a file, tolerating a UTF-8 BOM.

    Windows PowerShell writes one by default - `Set-Content -Encoding UTF8`
    and `Out-File` both do - and a BOM ahead of the opening `---` means
    split_frontmatter sees no frontmatter at all, so the phase reads as
    having no tasks. Files are always written back without one.
    """
    with open(path, encoding="utf-8-sig") as handle:
        return handle.read()


def split_frontmatter(text):
    if not text.startswith("---"):
        return "", text
    end = text.find("\n---", 3)
    if end == -1:
        return "", text
    return text[3:end], text[end + 4:]


def join_frontmatter(fm, body):
    return "---" + fm + "\n---" + body


def csv(raw):
    return [p.strip() for p in raw.split(",") if p.strip()]


def intof(value, default=0):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def read_index():
    if not os.path.exists(INDEX):
        die("no PLAN.md at repo root. Run /cs-plan first.")
    fm, _ = split_frontmatter(read_text(INDEX))
    m = re.search(r"^current:\s*(\S+)", fm, re.M)
    if not m:
        die("PLAN.md frontmatter has no `current:` pointer.")
    path = phase_path(m.group(1))
    if not os.path.exists(path):
        die(f"PLAN.md points at {m.group(1)}, which does not exist.\n"
            "  A phase was probably closed and the next one not planned yet.\n"
            "  Run /cs-plan for it in a new session -- /cs-plan writes the phase file\n"
            "  and moves `current:` to it -- or point `current:` back at the\n"
            "  phase file you are still working in.")
    return path


def parse_tasks(fm):
    tasks, order, malformed = {}, [], []
    in_tasks = False
    for line in fm.splitlines():
        if re.match(r"^tasks:\s*$", line):
            in_tasks = True
            continue
        if in_tasks:
            if line.strip() and not line.startswith("  "):
                in_tasks = False
                continue
            if not line.strip():
                continue
            m = TASK_RE.match(line)
            if not m:
                malformed.append(line.rstrip())
                continue
            tid, inner = m.group(1), m.group(2)
            if tid in tasks:
                malformed.append(f"duplicate task ID {tid}: {line}")
                continue
            fields = re.findall(r'(?:^|,)\s*([\w-]+)\s*:', inner)
            if (len(fields) != len(set(fields)) or set(fields) - {'deps', 'status', 'files', 'reads', 'owner'}
                    or not {'deps', 'status', 'files'}.issubset(fields)):
                malformed.append(f'invalid or duplicate task fields: {line}')
                continue
            deps = LIST_RE("deps").search(inner)
            files = LIST_RE("files").search(inner)
            status = WORD_RE("status").search(inner)
            owner = OWNER_RE.search(inner)
            tasks[tid] = {
                "deps": csv(deps.group(1)) if deps else [],
                "files": csv(files.group(1)) if files else [],
                "reads": csv(LIST_RE("reads").search(inner).group(1)) if LIST_RE("reads").search(inner) else [],
                "status": status.group(1) if status else "?",
                # Absent on every phase file written before format 1.5, and
                # absent again the moment the task stops being in progress.
                "owner": owner.group(1) if owner else None,
            }
            order.append(tid)
    return tasks, order, malformed


def parse_blocks(body):
    """Every `## Heading` in the body, mapped to its text."""
    blocks, current, buf = {}, None, []
    for line in body.splitlines():
        m = HEAD_RE.match(line)
        if m:
            if current is not None:
                blocks[current] = "\n".join(buf).strip()
            current, buf = m.group(1).strip(), []
            continue
        if current is not None:
            buf.append(line)
    if current is not None:
        blocks[current] = "\n".join(buf).strip()
    return blocks


COMMENT_RE = re.compile(r"<!--.*?-->", re.S)


def block(blocks, name):
    """A block's text with HTML comments removed.

    The templates carry their format examples inside comments; a commented
    finding is documentation, not a finding, including when the comment spans
    several lines and the example sits on one of the inner ones.
    """
    for head, text in blocks.items():
        if head.lower() == name.lower():
            return COMMENT_RE.sub("", text)
    return ""


def parse_findings(text):
    """One finding per line:

      F1 | Critical | Task ordering | T3 | open | description | recommended fix

    Prose and HTML comments are ignored. A line that starts with an F-id but
    does not carry seven fields is reported rather than silently dropped.
    """
    findings, order, malformed, dupes = {}, [], [], []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        if not line or line.startswith("<!--"):
            continue
        if not FINDING_RE.match(line):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) != 7:
            malformed.append(line)
            continue
        fid, sev, cat, tasks, status, desc, fix = parts
        if sev.title() not in SEVERITIES or status.lower() not in FSTATUSES:
            malformed.append(line)
            continue
        if fid in findings:
            dupes.append(fid)
            continue
        findings[fid] = {"severity": sev.title(), "category": cat,
                         "tasks": csv(tasks), "status": status.lower(),
                         "desc": desc, "fix": fix}
        order.append(fid)
    return findings, order, malformed, dupes


def parse_changelog(text):
    """One entry per line:  rev 2 | F1 | resolved | what carries the fix"""
    entries = []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        m = CHANGE_RE.match(line)
        if m:
            entries.append({"rev": intof(m.group(1)), "fid": m.group(2),
                            "state": m.group(3).lower(), "note": m.group(4).strip()})
    return entries


def read_phase(path):
    text = read_text(path)
    fm, body = split_frontmatter(text)
    meta = {}
    for key in META_KEYS:
        m = re.search(r"^%s:\s*(.+)$" % key, fm, re.M)
        if m:
            meta[key] = m.group(1).strip()

    tasks, order, malformed = parse_tasks(fm)
    meta_fields = re.findall(r'^([\w-]+):', fm, re.M)
    if len(meta_fields) != len(set(meta_fields)):
        malformed.append('duplicate frontmatter keys')
    task_heads = re.findall(r'^##\s+(T\d+)\b', COMMENT_RE.sub('', body), re.M)
    if len(task_heads) != len(set(task_heads)):
        malformed.append('duplicate task body sections')
    blocks = parse_blocks(body)

    sections = {}
    for head, chunk in blocks.items():
        m = TASK_HEAD_RE.match(head)
        if m:
            sections[m.group(1)] = chunk

    findings, forder, fmalformed, fdupes = parse_findings(block(blocks, "Findings"))

    return {"path": path, "meta": meta, "tasks": tasks, "order": order,
            "sections": sections, "blocks": blocks, "malformed": malformed,
            "findings": findings, "forder": forder, "fmalformed": fmalformed,
            "fdupes": fdupes, "changelog": parse_changelog(block(blocks, "Changelog")),
            "text": text}


def num(tid):
    return int(tid[1:])


def cycles(tasks):
    color, found = {}, []

    def walk(node, stack):
        color[node] = 1
        for dep in tasks.get(node, {}).get("deps", []):
            if dep not in tasks:
                continue
            if color.get(dep) == 1:
                found.append(" -> ".join(stack + [node, dep]))
            elif color.get(dep, 0) == 0:
                walk(dep, stack + [node])
        color[node] = 2

    for tid in tasks:
        if color.get(tid, 0) == 0:
            walk(tid, [])
    return found


def runnable(phase):
    out = []
    for tid in phase["order"]:
        t = phase["tasks"][tid]
        if t["status"] != "pending":
            continue
        if all(phase["tasks"].get(d, {}).get("status") == "done" for d in t["deps"]):
            out.append(tid)
    return out


def open_findings(phase, severities=None):
    out = []
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        if f["status"] != "open":
            continue
        if severities and f["severity"] not in severities:
            continue
        out.append(fid)
    return out


def verify_line(phase, tid):
    for line in phase["sections"].get(tid, "").splitlines():
        if re.match(r"^\s*[-*]?\s*Verify:", line):
            return line.strip().lstrip("-* ").strip()
    return None


# ------------------------------------------------------------------- lint

def lint_issues(phase):
    errs, warns = [], []
    t = phase["tasks"]

    for line in phase["malformed"]:
        errs.append(f"E01 unparseable task line: {line}")
    if not t:
        errs.append("E02 no tasks: block in the phase file frontmatter")

    fmt = phase["meta"].get("workflow-rev")
    if fmt is None:
        warns.append("W03 phase file has no workflow-rev; it was written by an "
                     "older coldsession and may not match this tool")
    elif fmt.split(".")[0] not in ("1", "2"):
        errs.append(f"E11 phase file is format {fmt}, supported format is {FORMAT_VERSION}; "
                    "major versions differ and the shapes are not compatible")

    if phase["meta"].get("status") not in PSTATUSES + (None,):
        warns.append(f"W01 unexpected phase status {phase['meta'].get('status')!r}")

    active = phase["meta"].get("active")
    if active and active not in STAGES + ("plan",):
        errs.append(f"E16 unknown active stage {active!r}")
    if active and not phase["meta"].get("active-rev"):
        errs.append(f"E17 active stage {active!r} has no active-rev")
    if not active and phase["meta"].get("active-rev"):
        errs.append("E18 active-rev exists without an active stage")

    for tid in phase["order"]:
        task = t[tid]
        if task["status"] not in STATUSES:
            errs.append(f"E03 {tid} has status {task['status']!r}")
        if task["status"] == "in_progress" and phase["meta"].get("status") != "approved":
            errs.append(f"E19 {tid} is in_progress but the phase is not approved")
        if not task["files"]:
            errs.append(f"E04 {tid} has an empty files list; build cannot bound its reads")
        elif task["status"] != "done" and phase["meta"].get("status") != "closed":
            tokens = _context_budget(phase, tid)['task']
            if tokens > BRIEF_TOKEN_BUDGET:
                warns.append(f"W07 {tid} file context is ~{tokens:,} tokens "
                             "(whole-file estimate, bytes/4; direct task context, "
                             "excluding shared/inherited files and implicit lockfile reads), over the "
                             f"{BRIEF_TOKEN_BUDGET:,}-token soft budget; advisory only. "
                             "Large existing files can trigger this for a small edit; "
                             f"inspect `plan brief {tid}` and use targeted reads. "
                             "Keep required files in scope; split only if the work is too broad.")
        for dep in task["deps"]:
            if dep not in t:
                errs.append(f"E05 {tid} depends on {dep}, which is not in this phase")
            elif num(dep) > num(tid):
                warns.append(f"W02 {tid} depends on later task {dep}; reorder or renumber")
        if task["status"] == "done":
            for dep in task["deps"]:
                if t.get(dep, {}).get("status") != "done":
                    errs.append(f"E06 {tid} is done but its dependency {dep} is not")
        if tid not in phase["sections"]:
            errs.append(f"E07 {tid} is in the graph but has no `## {tid}` section in the body")
        elif not verify_line(phase, tid):
            errs.append(f"E08 {tid} has no Verify: line; build has nothing to run")

    for tid in phase["sections"]:
        if tid not in t:
            errs.append(f"E09 `## {tid}` exists in the body but not in the tasks graph")

    for c in cycles(t):
        errs.append(f"E10 dependency cycle: {c}")

    for line in phase["fmalformed"]:
        errs.append(f"E12 unparseable finding line: {line}")
    for fid in phase["fdupes"]:
        errs.append(f"E13 finding {fid} is defined more than once")

    logged = {c["fid"] for c in phase["changelog"]}
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        for ref in f["tasks"]:
            if re.match(r"^T\d+$", ref) and ref not in t:
                errs.append(f"E14 finding {fid} names {ref}, which is not in this phase")
        if f["status"] != "open" and fid not in logged:
            warns.append(f"W04 {fid} is marked {f['status']} but no changelog entry "
                         "says what carries the fix")

    if phase["meta"].get("status") in ("approved", "closed"):
        stuck = open_findings(phase, ("Critical", "High"))
        if stuck:
            errs.append(f"E15 phase is {phase['meta']['status']} with open "
                        f"Critical/High findings: {', '.join(stuck)}")

    fmt_minor = intof((fmt or "1.0").split(".")[1] if "." in (fmt or "") else 0)
    rev = intof(phase["meta"].get("rev"), 1)
    ready = intof(phase["meta"].get("ready"), 0)
    if ready > rev:
        errs.append(f"E20 ready revision {ready} is newer than rev {rev}")
    if ready == rev and open_findings(phase):
        errs.append("E21 current revision is marked ready but still has open findings")
    if fmt_minor >= 4 and phase["meta"].get("status") == "approved" and ready != rev:
        errs.append(f"E22 phase is approved but rev {rev} has no matching ready marker")

    if intof(phase["meta"].get("rev"), 1) >= 3 and open_findings(phase, ("Critical",)):
        warns.append("W05 round 3 still has an open Critical; the phase is too large "
                     "or the objective is wrong. Split it and re-plan rather than "
                     "revising again")

    if os.path.exists(AGENTS_PATH):
        try:
            agents_lines = len(read_text(AGENTS_PATH).splitlines())
        except OSError:
            agents_lines = 0
        if agents_lines > AGENTS_MD_BUDGET:
            warns.append(f"W06 AGENTS.md is {agents_lines} lines, over the "
                         f"{AGENTS_MD_BUDGET}-line budget; a build session re-reads it "
                         "every task, trim it before adding more")

    if strict(phase):
        for tid, task in t.items():
            section = phase['sections'].get(tid, '')
            for field in ('Goal', 'Deliverables', 'Acceptance Criteria'):
                match = re.search(r'^' + field + r':(.*?)(?=^(?:Goal|Deliverables|Acceptance Criteria|Verify):|\Z)', section, re.M | re.S)
                if not match or not match.group(1).strip():
                    errs.append(f'E35 {tid} requires concrete {field}')
            for entry in task['files'] + task['reads']:
                try:
                    scope_path(entry)
                    if sensitive(entry):
                        raise ValueError(f'sensitive path cannot be task scope: {entry}')
                except ValueError as exc:
                    errs.append(f"E26 {tid}: {exc}")
            try:
                verification_checks(phase, tid)
            except ValueError as exc:
                errs.append(f"E27 {tid}: {exc}")
        if not block(phase['blocks'], 'Constraints').strip():
            errs.append('E28 missing durable Constraints (write None. if none apply)')
        spec = specification(phase)
        if phase['meta'].get('ready') and phase['meta'].get('ready-spec') != spec:
            errs.append('E29 readiness is stale; run plan replan')
        if phase['meta'].get('status') == 'approved' and (
                ready != rev or phase['meta'].get('ready-spec') != spec or
                phase['meta'].get('reviewed-spec') != spec):
            errs.append('E30 approval does not match the reviewed specification; run plan replan')
    return errs, warns


# -------------------------------------------------------------- recommend

def recommend(phase):
    """What to run next, derived from the file rather than from memory.

    Returns (command, why). The command is what a human types; the reason is
    the state that produced it, so a wrong recommendation is debuggable.
    """
    meta = phase["meta"]
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0) if meta.get("reviewed") else 0
    status = meta.get("status", "draft")
    opened = open_findings(phase)
    if strict(phase) and status != 'closed':
        if (any(t['status'] == 'blocked' for t in phase['tasks'].values()) or
                (meta.get('ready') and meta.get('ready-spec') != specification(phase))):
            return ('plan replan', 'blocked work or changed specification requires renewed review; settle active claims first')
        errs, _ = lint_issues(phase)
        if errs:
            return ('plan lint', 'repair the reported document errors, then run plan replan if approval is stale')
        if status == 'approved':
            for tid in phase['order']:
                if phase['tasks'][tid]['status'] == 'done' and not evidence_valid(phase, tid):
                    return (f'plan verify {tid}', 'historical completion requires current verification before close')

    active = meta.get("active")
    if active:
        return (f"/cs-{active} --resume",
                f"{active} is already active for rev {meta.get('active-rev', rev)}; "
                "a plain rerun is refused")

    if strict(phase) and load_json(assignment_path(phase), {}):
        return ('plan status', 'worker assignments remain; wait for results or explicitly recover settled claims, never replace quiet workers')

    in_progress = [x for x in phase["order"]
                   if phase["tasks"][x]["status"] == "in_progress"]
    if in_progress:
        return (f"/cs-build {in_progress[0]} --resume",
                f"{', '.join(in_progress)} already in progress; resume explicitly")

    if status == "closed":
        return ("/cs-plan",
                "this phase is closed; the next one has no file yet, and /cs-plan "
                "writes it and moves `current:` onto it")

    errs, _ = lint_issues(phase)

    if status == "draft":
        if rev >= 3 and open_findings(phase, ("Critical",)):
            return ("plan replan",
                    f"rev {rev} still has an open Critical "
                    f"({', '.join(open_findings(phase, ('Critical',)))}); split this phase "
                    "and re-plan rather than revising a fourth time")
        if not reviewed:
            return ("/cs-review",
                    "this phase has had no review pass; start one in a NEW session")
        if reviewed < rev:
            return ("/cs-review",
                    f"rev {rev} has not been checked since the last revision "
                    f"(last review pass was rev {reviewed}); run it in a NEW session")
        if opened:
            sev = ", ".join(sorted({phase["findings"][f]["severity"] for f in opened}))
            return ("/cs-revise",
                    f"{len(opened)} open finding(s) ({sev}): {', '.join(opened)}")
        if errs:
            return ("plan lint",
                    f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                    "this file until they are fixed")
        if intof(meta.get("ready"), 0) == rev:
            return ("(set status: approved)",
                    f"rev {rev} passed /cs-approve; the human approval edit is pending")
        return ("/cs-approve",
                f"rev {rev} is reviewed with no open findings; /cs-approve produces the "
                "evidence, then you set `status: approved` yourself")

    if errs:
        return ("plan lint",
                f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                "this file until they are fixed")

    if status == "approved":
        done = [x for x in phase["order"] if phase["tasks"][x]["status"] == "done"]
        nxt = runnable(phase)
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        blocked = [x for x in phase["order"] if phase["tasks"][x]["status"] == "blocked"]
        if nxt:
            return (f"/cs-build {nxt[0]}",
                    f"{len(done)} of {len(phase['order'])} tasks done; "
                    f"{nxt[0]} is runnable")
        if blocked and not pending:
            return ("/cs-review",
                    f"{', '.join(blocked)} blocked and nothing else is pending; "
                    "re-enter the loop at review")
        if pending:
            waiting = []
            for tid in pending:
                unmet = [d for d in phase["tasks"][tid]["deps"]
                         if phase["tasks"].get(d, {}).get("status") != "done"]
                waiting.append(f"{tid} waits on {', '.join(unmet) or 'nothing runnable'}")
            return ("plan replan", "; ".join(waiting))
        return ("/cs-close", "every task is done")

    return ("plan lint", f"unsupported phase status {status!r}")


# ---------------------------------------------------------------- writing

def write_phase(phase, text):
    atomic_write(phase["path"], text)


def sub_outside_comments(pat, repl, text):
    """Replace the first match that is not inside an HTML comment.

    The read path drops commented lines, so the write path has to as well.
    Otherwise `plan resolve F1` edits the F1 in the template's format example
    and reports success while the real finding stays open.
    """
    spans = [(m.start(), m.end()) for m in COMMENT_RE.finditer(text)]
    for m in pat.finditer(text):
        if any(a <= m.start() < b for a, b in spans):
            continue
        return text[:m.start()] + repl(m) + text[m.end():], True
    return text, False


def set_meta(text, key, value):
    """Set a frontmatter field, inserting it after `status:` if absent."""
    fm, body = split_frontmatter(text)
    pat = re.compile(r"^(%s:\s*).*$" % re.escape(key), re.M)
    if pat.search(fm):
        fm = pat.sub(lambda m: m.group(1) + str(value), fm, count=1)
    else:
        anchor = re.compile(r"^(status:.*)$", re.M)
        if anchor.search(fm):
            fm = anchor.sub(lambda m: m.group(1) + f"\n{key}: {value}", fm, count=1)
        else:
            fm = fm.rstrip("\n") + f"\n{key}: {value}\n"
    return join_frontmatter(fm, body)


def del_meta(text, *keys):
    """Remove optional frontmatter fields without disturbing body text."""
    fm, body = split_frontmatter(text)
    for key in keys:
        fm = re.sub(r"^%s:\s*.*\n?" % re.escape(key), "", fm, flags=re.M)
    return join_frontmatter(fm.rstrip("\n") + "\n", body)


def set_metas(text, values=None, remove=()):
    for key, value in (values or {}).items():
        text = set_meta(text, key, value)
    return del_meta(text, *remove) if remove else text


def append_to_block(text, name, line):
    """Insert a line at the end of a `## Name` block, creating it if absent."""
    fm, body = split_frontmatter(text)
    lines = body.splitlines()
    start = None
    for i, raw in enumerate(lines):
        m = HEAD_RE.match(raw)
        if m and m.group(1).strip().lower() == name.lower():
            start = i
            break
    if start is None:
        body = body.rstrip("\n") + f"\n\n## {name}\n\n{line}\n"
        return join_frontmatter(fm, body)
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if HEAD_RE.match(lines[i]):
            end = i
            break
    tail = end
    while tail > start + 1 and not lines[tail - 1].strip():
        tail -= 1
    if tail == start + 1:
        lines.insert(tail, "")
        tail += 1
    lines.insert(tail, line)
    return join_frontmatter(fm, "\n".join(lines))


def _owner_id():
    """Who is running this build, as durably as the surface allows.

    Orca's terminal handle first: it outlives a restarted agent session and
    names a terminal that a coordinator can address, so a resumed build keeps
    the claim it started with. Claude and Codex session/thread IDs are fallbacks.
    Anonymous single-task execution stays scoped; teams require stable identity.
    """
    return (os.environ.get("ORCA_TERMINAL_HANDLE")
            or os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("CODEX_THREAD_ID")
            or os.environ.get("CODEX_SESSION_ID") or None)


def _set_owner(text, tid, owner):
    """Write, replace, or drop one task's `owner:` field.

    Appended last inside the braces rather than woven in beside `status:`, so
    a phase file written before 1.5 gains the key without its other fields
    moving, and a diff of a claim is one field wide.
    """
    line = re.compile(r"^(\s{2}%s:\s*\{)(.*?)(\}\s*)$" % tid, re.M)

    def rewrite(m):
        inner = OWNER_RE.sub("", m.group(2))
        inner = re.sub(r",\s*,", ",", inner).rstrip().rstrip(",").rstrip()
        if owner:
            inner += f", owner: {owner}"
        return m.group(1) + inner + m.group(3)

    updated, _ = sub_outside_comments(line, rewrite, text)
    return updated


def _set_status(phase, tid, status, note=None):
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    pat = re.compile(r"^(\s{2}%s:\s*\{.*?status:\s*)([A-Za-z_-]+)" % tid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + status, phase["text"])
    if not hit:
        die(f"could not find a status field for {tid}")
    # One write, not two: the claim and the status it belongs to should never
    # be separately observable, least of all by a parallel build session.
    text = _set_owner(text, tid, _owner_id() if status == "in_progress" else None)
    write_phase(phase, text)
    print(f"{tid} -> {status}")
    if note:
        log = phase["path"].replace(".md", ".log.md")
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(f"\n## {tid} blocked\n{note}\n")
        print(f"note appended to {log}")


# ---------------------------------------------------------------- commands

def print_recommend(phase, prefix="next"):
    cmd, why = recommend(phase)
    print(f"{prefix}     {cmd}")
    print(f"          why: {why}")


def cmd_status(phase, _args):
    m = phase["meta"]
    counts = {s: 0 for s in STATUSES}
    for t in phase["tasks"].values():
        counts[t["status"]] = counts.get(t["status"], 0) + 1
    reviewed = m.get("reviewed")
    print(f"phase    {m.get('phase', '?')}  rev {m.get('rev', '?')}  "
          f"status {m.get('status', '?')}  "
          f"reviewed {reviewed if reviewed else 'never'}  "
          f"ready {m.get('ready', 'no')}  "
          f"active {m.get('active', 'none')}  "
          f"workflow-rev {m.get('workflow-rev', '?')}")
    print(f"file     {phase['path']}")
    print("tasks    " + "  ".join(f"{k} {v}" for k, v in counts.items() if v))
    if phase["forder"]:
        opened = open_findings(phase)
        detail = ""
        if opened:
            by = {}
            for fid in opened:
                by[phase["findings"][fid]["severity"]] = \
                    by.get(phase["findings"][fid]["severity"], 0) + 1
            detail = "  (" + ", ".join(f"{v} {k}" for k, v in by.items()) + ")"
        print(f"findings {len(phase['forder'])} total  {len(opened)} open{detail}")
    nxt = runnable(phase)
    print("runnable " + (", ".join(nxt) if nxt else "none"))
    blocked = [t for t in phase["order"] if phase["tasks"][t]["status"] == "blocked"]
    if blocked:
        print("blocked  " + ", ".join(blocked))
    print_recommend(phase)


def cmd_recommend(phase, _args):
    cmd, why = recommend(phase)
    print(f"{cmd}   why: {why}")
    return 0


def cmd_lint(phase, _args):
    errs, warns = lint_issues(phase)
    for line in errs:
        print(line)
    for line in warns:
        print(line)
    if not errs and not warns:
        print(f"ok  {len(phase['tasks'])} tasks, graph is acyclic, every task has files "
              f"and a Verify line; {len(phase['forder'])} findings, "
              f"{len(open_findings(phase))} open")
    return 1 if errs else 0


def cmd_next(phase, args):
    if strict(phase):
        validate_transition(phase, 'assign', [])
    nxt = runnable(phase)
    if strict(phase):
        nxt = [tid for tid in nxt if not any(
            other != tid and task['status'] == 'in_progress' and task_conflict(phase, tid, other)
            for other, task in phase['tasks'].items())]
    if not nxt:
        if strict(phase):
            print_recommend(phase)
            return 0
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        if phase["meta"].get("status") == "closed":
            print("this phase is closed: run /cs-plan for the next one")
        elif not pending:
            print("no pending tasks: the phase is complete, run /cs-close")
        else:
            print("nothing runnable: every pending task is waiting on an unfinished dependency")
            for tid in pending:
                waiting = [d for d in phase["tasks"][tid]["deps"]
                           if phase["tasks"].get(d, {}).get("status") != "done"]
                print(f"  {tid} waits on {', '.join(waiting)}")
        return 0

    if "--parallel" not in args:
        print(" ".join(nxt))
        return 0

    groups = []
    for tid in nxt:
        files = {_guard_norm(p) for p in phase["tasks"][tid]["files"]}
        running = {_guard_norm(p) for t in phase['tasks'].values() if t['status'] == 'in_progress' for p in t['files']}
        if files & running:
            continue
        for g in groups:
            if not files & g["files"] and not (strict(phase) and any(task_conflict(phase, tid, other) for other in g['ids'])):
                g["ids"].append(tid)
                g["files"] |= files
                break
        else:
            groups.append({"ids": [tid], "files": set(files)})
    print("these can run at the same time, one session each:")
    for g in groups:
        print("  " + " ".join(g["ids"]))
    if len(groups) > 1:
        print("groups touch overlapping files; run the groups in sequence")
    return 0


def _transitive_deps(phase, tid):
    """All ancestor task ids reachable via deps, in dependency-first order."""
    seen, order = set(), []

    def visit(t):
        for d in phase["tasks"].get(t, {}).get("deps", []):
            if d not in seen:
                seen.add(d)
                visit(d)
                order.append(d)

    visit(tid)
    return order


def read_set(phase, tid):
    """The bounded read list for one task, in the order a build session opens it.

    AGENTS.md, the phase file, the files of every transitive dependency, then
    the task's own; first occurrence wins so the prefix stays byte-identical
    across build sessions. `plan brief` prints this list and `plan guard`
    enforces it; they must never disagree about what a session may open, so
    both call this rather than rebuilding the traversal.
    """
    reads = ["AGENTS.md", phase["path"]]
    if not strict(phase):
        for dep in _transitive_deps(phase, tid):
            reads += phase["tasks"].get(dep, {}).get("files", [])
    reads += phase['tasks'].get(tid, {}).get('reads', [])
    reads += phase["tasks"].get(tid, {}).get("files", [])

    seen, ordered = set(), []
    for r in reads:
        if r not in seen:
            seen.add(r)
            ordered.append(r)
    return ordered


def _context_budget(phase, tid, include_inherited=False):
    """Whole-file bytes/4 inventory, separated from direct task context.

    Legacy read authorization inherits dependency files; that is not an
    instruction to load them all. Lockfiles are usually generated outputs;
    count them toward W07 only when explicitly requested in `reads`.
    Neither distinction changes read/write authorization or fingerprints.
    Other source/doc files still use their full size, not guessed excerpts.
    Resolve aliases once and keep missing files visible without guessing size.
    """
    phase_path = phase['path']

    def resolve(rel):
        if rel == phase_path:
            return rel
        return os.path.join(ROOT, rel)

    def canon(rel):
        return os.path.normcase(os.path.realpath(resolve(rel)))

    phase_canon = canon(phase_path)
    agents_canon = canon("AGENTS.md")
    task = phase['tasks'].get(tid, {})
    explicit_reads = {canon(p) for p in task.get('reads', [])}
    direct = explicit_reads | {canon(p) for p in task.get('files', [])}
    lockfile_names = {os.path.normcase(n) for n in LOCKFILE_NAMES}
    budget = dict(task=0, phase=0, agents=0, inherited=0, lockfiles=0, missing=[])
    seen = set()
    paths = (read_set(phase, tid) if include_inherited else
             ['AGENTS.md', phase_path] + task.get('reads', []) + task.get('files', []))
    for rel in paths:
        path = canon(rel)
        if path in seen:
            continue
        seen.add(path)
        try:
            size = os.path.getsize(resolve(rel)) // 4
        except OSError:
            budget['missing'].append(rel)
            continue
        if path == phase_canon:
            bucket = 'phase'
        elif path == agents_canon:
            bucket = 'agents'
        elif os.path.basename(path) in lockfile_names and path not in explicit_reads:
            bucket = 'lockfiles'
        elif path not in direct:
            bucket = 'inherited'
        else:
            bucket = 'task'
        budget[bucket] += size
    return budget


def _last_log_entry(path):
    """The most recent `## ...` entry in a handoff log, headed and bodied, or None.

    `plan brief` already tells a build session to read only the last entry;
    inlining it here bounds that the same way the Verify line already is,
    rather than trusting the instruction to stop a session short once it has
    the whole file open.
    """
    try:
        text = read_text(path)
    except (OSError, UnicodeDecodeError):
        # A pre-existing log in some other encoding (UTF-16, latin-1 from an
        # editor that never asked) must not turn "inline the last entry" into
        # a crash; brief still has a phase and files to report without it.
        return None
    # [ \t]+, not \s+: \s matches a newline too, so a bare "##" line with no
    # text after it would otherwise let the match run on through the blank
    # line beneath and swallow the next paragraph as part of the "heading".
    parts = re.split(r"(?m)^(##[ \t]+\S.*)$", text)
    if len(parts) < 3:
        return None
    head, body = parts[-2].strip(), parts[-1].strip()
    return f"{head}\n{body}" if body else head


def cmd_brief(phase, args):
    if not args:
        die("usage: plan brief T2")
    tid = args[0].upper()
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]

    unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
    ordered = read_set(phase, tid)

    status = phase["meta"].get("status", "?")
    print(f"task    {tid}   status {task['status']}")
    print(f"phase   {phase['path']}  (phase status {status})")
    if status != "approved":
        cmd, _ = recommend(phase)
        print(f"NOT APPROVED this phase is {status}, not approved - run {cmd} first")
    if task["status"] != "in_progress":
        print(f"NOT STARTED {tid} is {task['status']}; run plan start {tid} first")
    if unmet:
        print(f"BLOCKED unmet dependencies: {', '.join(unmet)} - do not start this task")
    read_lines = []
    for r in ordered:
        if r == phase["path"]:
            read_lines.append(f"{r}  (own section inlined below; open only for "
                               "Assumptions, Policy, or another task)")
        else:
            read_lines.append(r)
    print("read    " + "\n        ".join(read_lines))
    print("write   " + ', '.join(task['files']))
    print("        (bounded read-only discovery is allowed; correct an insufficient brief before implementation)")
    if strict(phase):
        print('spec    ' + specification(phase))
        for name in ('Constraints', 'Assumptions', 'Policy', 'Out of scope'):
            print(name.lower() + ' ' + block(phase['blocks'], name))
        for entry in relevant_handoffs(phase, tid):
            print('handoff ' + json.dumps(entry, ensure_ascii=True))

    section = phase["sections"].get(tid, "").strip()
    if section:
        print(f"section {tid}")
        print("        " + section.replace("\n", "\n        "))

    budget = _context_budget(phase, tid, include_inherited=True)
    total = sum(budget[key] for key in ('task', 'phase', 'agents', 'inherited', 'lockfiles'))
    note = f"; {len(budget['missing'])} not yet on disk" if budget['missing'] else ""
    over = f"  -- direct task context is over the {BRIEF_TOKEN_BUDGET:,}-token soft budget (advisory)" \
        if budget['task'] > BRIEF_TOKEN_BUDGET else ""
    print(f"budget  ~{total:,} tokens (estimate, bytes/4) across {len(ordered)} file(s): "
          f"~{budget['phase']:,} phase file, ~{budget['task']:,} task files/supporting reads, "
          f"~{budget['agents']:,} shared AGENTS.md, ~{budget['inherited']:,} inherited files, "
          f"~{budget['lockfiles']:,} generated lockfiles{note}{over}")
    print("        (file inventory, not measured prompt usage; inherited files need only targeted reads; "
          "lockfiles count toward W07 only when explicitly listed in reads)")

    v = verify_line(phase, tid)
    print(f"verify  {v[len('Verify:'):].strip() if v and v.startswith('Verify:') else v}")
    log = phase["path"].replace(".md", ".log.md")
    if os.path.exists(log) and not strict(phase):
        entry = _last_log_entry(log)
        if entry:
            print(f"handoff {log}  (last entry inlined below; open the file only for more)")
            print("        " + entry.replace("\n", "\n        "))
        else:
            print(f"handoff {log}  (no parseable `## ...` entry yet; read it directly "
                  "if you need it)")
    return 1 if unmet or status != "approved" or task["status"] != "in_progress" else 0


def cmd_findings(phase, args):
    only_open = "--open" in args
    rows = [f for f in phase["forder"]
            if not only_open or phase["findings"][f]["status"] == "open"]
    if not rows:
        print("no open findings" if only_open else
              "no findings recorded; /cs-review writes them into the phase file")
        return 0
    for fid in rows:
        f = phase["findings"][fid]
        print(f"{fid:<4} {f['severity']:<9} {f['status']:<9} "
              f"{','.join(f['tasks']) or '-':<10} {f['category']}")
        print(f"     {f['desc']}")
        print(f"     fix: {f['fix']}")
    opened = open_findings(phase)
    print(f"{len(phase['forder'])} findings, {len(opened)} open")
    return 0


def cmd_resolve(phase, args):
    if len(args) < 2:
        die('usage: plan resolve F1 <open|resolved|accepted> "what carries the fix"')
    fid, state = args[0].upper(), args[1].lower()
    note = " ".join(args[2:]).strip()
    if fid not in phase["findings"]:
        die(f"{fid} is not a finding in this phase")
    if state not in FSTATUSES:
        die(f"state must be one of {', '.join(FSTATUSES)}")
    if state != "open" and not note:
        die(f"{fid} -> {state} needs a note naming the task or plan line that "
            "carries the fix")

    active = phase["meta"].get("active")
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    expected = "review" if state == "open" else "revise"
    if modern and active != expected:
        die(f"{fid} -> {state} is only valid during an active {expected} pass; "
            f"run /cs-{expected} first")

    pat = re.compile(r"^(\s*[-*]?\s*%s\s*\|[^|]*\|[^|]*\|[^|]*\|\s*)([A-Za-z_-]+)" % fid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + state, phase["text"])
    if not hit:
        die(f"could not find the status field of {fid}; check its line has seven "
            "pipe-separated fields")
    rev = intof(phase["meta"].get("rev"), 1)
    text = append_to_block(text, "Changelog",
                           f"rev {rev} | {fid} | {state} | {note or 'reopened'}")
    write_phase(phase, text)
    print(f"{fid} -> {state}, logged to the changelog at rev {rev}")
    return 0


def _stage_refusal(phase, message):
    cmd, why = recommend(phase)
    die(f"{message}\nnext: {cmd}\nwhy: {why}")


def cmd_begin(phase, args):
    if not args:
        die(f"usage: plan begin <{'|'.join(STAGES)}> [--resume]")
    stage = args[0].lower()
    resume = "--resume" in args[1:]
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")

    meta = phase["meta"]
    active = meta.get("active")
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0)
    status = meta.get("status", "draft")

    if active:
        if active == stage and resume:
            print(f"resume {stage} at rev {meta.get('active-rev', rev)}")
            return 0
        if active == stage:
            _stage_refusal(phase, f"{stage} is already active; rerun with --resume")
        _stage_refusal(phase, f"cannot begin {stage}; {active} is active")
    if resume:
        _stage_refusal(phase, f"cannot resume {stage}; no {stage} pass is active")

    opened = open_findings(phase)
    if stage == "review":
        if status != "draft" or reviewed >= rev:
            _stage_refusal(phase, f"rev {rev} is not waiting for review")
    elif stage == "revise":
        if status != "draft" or reviewed != rev or not opened:
            _stage_refusal(phase, "this phase is not waiting for revision")
        if rev >= 3 and open_findings(phase, ("Critical",)):
            _stage_refusal(phase, "round 3 still has an open Critical; re-plan the phase")
    elif stage == "approve":
        if (status != "draft" or reviewed != rev or opened or
                intof(meta.get("ready"), 0) == rev):
            _stage_refusal(phase, "this revision is not waiting for readiness checking")
    elif stage == "close":
        unfinished = [tid for tid in phase["order"]
                      if phase["tasks"][tid]["status"] != "done"]
        if status != "approved" or unfinished or opened:
            _stage_refusal(phase, "this phase is not ready to close")

    text = set_metas(phase["text"], {"active": stage, "active-rev": rev})
    if strict(phase):
        text = set_meta(text, 'active-spec', specification(phase))
    write_phase(phase, text)
    print(f"begin {stage} at rev {rev}")
    return 0


def _require_active(phase, stage):
    active = phase["meta"].get("active")
    if active != stage:
        _stage_refusal(phase, f"cannot finish {stage}; active stage is {active or 'none'}")


def _tick_current_phase(phase):
    rel = os.path.relpath(phase["path"], ROOT).replace(os.sep, "/")
    index_text = read_text(INDEX)
    lines = index_text.splitlines()
    hit = False
    for i, line in enumerate(lines):
        if rel in line and re.match(r"^\s*-\s*\[[ xX]\]", line):
            lines[i] = re.sub(r"^(\s*-\s*)\[[ xX]\]", r"\1[x]", line, count=1)
            hit = True
            break
    if not hit:
        die(f"PLAN.md has no phase checklist line for {rel}")
    return "\n".join(lines) + ("\n" if index_text.endswith("\n") else "")


def cmd_finish(phase, args):
    if not args:
        die(f"usage: plan finish <{'|'.join(STAGES)}> [--pass|--fail]")
    stage = args[0].lower()
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")
    _require_active(phase, stage)

    rev = intof(phase["meta"].get("rev"), 1)
    active_rev = intof(phase["meta"].get("active-rev"), rev)
    text = phase["text"]

    if stage == "review":
        if rev != active_rev:
            die(f"review claimed rev {active_rev}, but phase is now rev {rev}")
        text = set_meta(text, "reviewed", rev)
        if strict(phase):
            if phase['meta'].get('active-spec') != specification(phase):
                die('specification changed during review; run plan replan')
            text = set_meta(text, 'reviewed-spec', specification(phase))
    elif stage == "revise":
        if rev != active_rev + 1:
            die("finish revise requires exactly one successful plan bump")
    elif stage in ("approve", "close"):
        passed = "--pass" in args[1:]
        failed = "--fail" in args[1:]
        if passed == failed:
            die(f"finish {stage} requires exactly one of --pass or --fail")
        errs, _ = lint_issues(phase)
        if passed and (errs or open_findings(phase)):
            die(f"cannot pass {stage}; lint errors or open findings remain")
        if failed and not (errs or open_findings(phase)):
            die(f"cannot fail {stage} without a persisted open finding or lint error")
        if stage == "approve" and passed:
            if intof(phase["meta"].get("reviewed"), 0) != rev:
                die(f"cannot mark rev {rev} ready; it has not been reviewed")
            text = set_meta(text, "ready", rev)
            if strict(phase):
                if phase['meta'].get('reviewed-spec') != specification(phase):
                    die('review is stale; run plan replan')
                text = set_meta(text, 'ready-spec', specification(phase))
        if stage == "close" and passed:
            if phase["meta"].get("status") != "approved":
                die("only an approved phase can close")
            if any(t["status"] != "done" for t in phase["tasks"].values()):
                die("cannot close while tasks remain unfinished")
            index_text = _tick_current_phase(phase)
            text = set_meta(text, "status", "closed")
            text = del_meta(text, "active", "active-rev")
            transaction({INDEX: index_text, phase['path']: del_meta(text, 'active-spec')})
            print(f"finish close --pass; {phase['meta'].get('phase', '?')} -> closed")
            return 0
        if stage == "close" and failed:
            text = set_meta(text, "status", "draft")
            text = del_meta(text, "ready")

    text = del_meta(text, "active", "active-rev", "active-spec")
    write_phase(phase, text)
    outcome = " --pass" if "--pass" in args else " --fail" if "--fail" in args else ""
    print(f"finish {stage}{outcome} at rev {rev}")
    return 0


def cmd_start(phase, args):
    if not args:
        die("usage: plan start T2 [--resume]")
    tid = args[0].upper()
    resume = "--resume" in args[1:]
    if phase["meta"].get("active"):
        _stage_refusal(phase, f"cannot start {tid}; {phase['meta']['active']} is active")
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]
    if phase["meta"].get("status") != "approved":
        _stage_refusal(phase, f"cannot start {tid}; phase is not approved")
    if task["status"] == "in_progress":
        if not resume:
            die(f"{tid} is already in_progress; rerun /cs-build {tid} --resume")
        # A resume is nearly always a new session, and the read gate follows
        # the claim, so the claim has to follow the session. Without this a
        # resumed build would be scoped to the dead session that stamped it.
        write_phase(phase, _set_owner(phase["text"], tid, _owner_id()))
        print(f"resume {tid}")
        return 0
    if resume:
        die(f"cannot resume {tid}; its status is {task['status']}")
    if task["status"] != "pending":
        die(f"cannot start {tid}; its status is {task['status']}")
    unmet = [d for d in task["deps"]
             if phase["tasks"].get(d, {}).get("status") != "done"]
    if unmet:
        die(f"cannot start {tid}; unmet dependencies: {', '.join(unmet)}")
    _set_status(phase, tid, "in_progress")
    return 0


def cmd_bump(phase, _args):
    if phase["meta"].get("active") != "revise":
        die("plan bump is only valid during an active revise pass")
    rev = intof(phase["meta"].get("rev"), 1)
    base = intof(phase["meta"].get("active-rev"), rev)
    if rev == base:
        rev += 1
        write_phase(phase, set_meta(phase["text"], "rev", rev))
        print(f"rev -> {rev}")
    elif rev == base + 1:
        print(f"rev already {rev}; resume did not bump again")
    else:
        die(f"active revise began at rev {base}, but current rev is {rev}")
    return 0


def cmd_reviewed(phase, _args):
    if phase["meta"].get("active") == "review":
        return cmd_finish(phase, ["review"])
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    if modern:
        die("plan reviewed requires an active review; run plan begin review first")
    rev = intof(phase["meta"].get("rev"), 1)
    if intof(phase["meta"].get("reviewed"), 0) >= rev:
        die(f"rev {rev} has already been reviewed")
    write_phase(phase, set_meta(phase["text"], "reviewed", rev))
    print(f"reviewed -> {rev} (legacy phase)")
    return 0


def cmd_done(phase, args):
    if not args:
        die("usage: plan done T2")
    tid = args[0].upper()
    task = phase["tasks"].get(tid)
    if task:
        if task["status"] != "in_progress":
            die(f"{tid} must be in_progress before it can be marked done")
        unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
        if unmet:
            die(f"{tid} depends on {', '.join(unmet)}, which are not done")
    _set_status(phase, tid, "done")
    return 0


def cmd_block(phase, args):
    if not args:
        die('usage: plan block T2 "reason"')
    tid = args[0].upper()
    task = phase["tasks"].get(tid)
    if not task:
        die(f"{tid} is not in this phase")
    if task["status"] != "in_progress":
        die(f"{tid} must be in_progress before it can be blocked")
    if strict(phase):
        reason = redact(' '.join(args[1:]) or 'unspecified blocker')[:4096].replace('|', '/')
        text = re.sub(r'^(  ' + tid + r':.*?status:\s*)in_progress', r'\g<1>blocked', phase['text'], flags=re.M)
        text = _set_owner(text, tid, None)
        text = set_metas(text, {'status': 'draft'}, remove=('ready', 'ready-spec'))
        fid = 'F' + str(max([num(f) for f in phase['forder']] or [0]) + 1)
        text = append_to_block(text, 'Findings', f'{fid} | High | Blocker | {tid} | open | {reason} | settle workers and replan the blocked contract')
        log = phase['path'][:-3] + '.log.md'
        previous = read_text(log) if os.path.exists(log) else ''
        transaction({phase['path']: text, log: previous + f'\n## {tid} blocked\n{reason}\n'})
        print(f'{tid} -> blocked; phase -> draft; readiness cleared; run plan replan after workers settle')
        return 0
    _set_status(phase, tid, "blocked", " ".join(args[1:]) or "no reason given")
    text = read_text(phase["path"])
    text = set_meta(text, "status", "draft")
    text = del_meta(text, "ready")
    write_phase(phase, text)
    print("phase -> draft; readiness cleared")
    return 0


def cmd_version(_phase, _args):
    print(TOOL_VERSION)
    return 0


# --------------------------------------------------------------- metrics

def _phase_files():
    """Every phase file on disk, `.log.md` handoffs excluded."""
    plans_dir = os.path.join(ROOT, "docs", "plans")
    try:
        paths = glob.glob(os.path.join(plans_dir, "*.md"))
    except OSError:
        return []
    return sorted(p for p in paths if not p.endswith(".log.md"))


def _load_phases():
    """Every phase file that parses, skipping any that don't.

    Unlike every other subcommand, metrics has no single `current:` phase to
    trust: it reads the whole `docs/plans/` directory, so one unreadable or
    malformed file must not take the rest of the report down with it.
    """
    phases = []
    for path in _phase_files():
        try:
            phases.append(read_phase(path))
        except Exception:
            continue
    return phases


def _git_cycle_days(path):
    """Days between a phase file's first and most recent commit, or None.

    None covers every way this can't be answered -- git missing, the path
    outside a repo, the file never committed -- so metrics degrades to "n/a"
    for that phase rather than failing the whole report.
    """
    rel = os.path.relpath(path, ROOT)
    try:
        result = subprocess.run(
            ["git", "-C", ROOT, "log", "--follow", "--format=%aI", "--", rel],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    stamps = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(stamps) < 2:
        return None
    try:
        parsed = sorted(datetime.fromisoformat(s) for s in stamps)
    except ValueError:
        return None
    return (parsed[-1] - parsed[0]).total_seconds() / 86400.0


def _fmt_avg(values, unit=""):
    if not values:
        return "n/a"
    return f"avg {sum(values) / len(values):.1f}{unit} ({len(values)} phase(s))"


def cmd_metrics(_phase, _args):
    """Deterministic metrics over every phase file, for the Stage 6 loopback.

    Scans docs/plans/*.md directly rather than the current phase, so -- like
    guard -- it must fail open: no docs/plans directory, no PLAN.md, or a
    repo that hasn't adopted coldsession yet all exit 0 with nothing to
    report, never a traceback.
    """
    try:
        phases = _load_phases()
    except Exception:
        return 0
    if not phases:
        print("no phase files under docs/plans/; nothing to report")
        return 0

    closed = [p for p in phases if p["meta"].get("status") == "closed"]
    approved = [p for p in phases if p["meta"].get("status") == "approved"]
    draft = len(phases) - len(closed) - len(approved)

    print(f"phases   {len(phases)} scanned "
          f"({len(closed)} closed, {len(approved)} approved, {draft} draft)")

    print("\nleading indicators")

    revisions = [intof(p["meta"].get("ready"), 0) - 1
                 for p in phases if p["meta"].get("ready") is not None]
    print(f"  revisions to approval   {_fmt_avg(revisions)}")

    if revisions:
        first_pass = sum(1 for r in revisions if r == 0)
        rate = 100.0 * first_pass / len(revisions)
        print(f"  first-pass approve rate {rate:.0f}% ({first_pass} of {len(revisions)})")
    else:
        print("  first-pass approve rate n/a (no phase has an approved revision yet)")

    blocked_counts = [sum(1 for t in p["tasks"].values() if t["status"] == "blocked")
                       for p in phases]
    phases_with_blocked = sum(1 for c in blocked_counts if c)
    print(f"  tasks blocked           {sum(blocked_counts)} total across "
          f"{phases_with_blocked} of {len(phases)} phase(s)")

    rounds = [intof(p["meta"].get("rev"), 1) for p in phases]
    print(f"  review rounds           {_fmt_avg(rounds)}")

    task_tokens, over_budget = [], 0
    for p in phases:
        for tid in p["order"]:
            # metrics scans every phase file on disk, including ones this
            # tool never validated the shape of, so -- like _load_phases()
            # skipping a phase that doesn't parse -- one task whose
            # dependency graph is pathological (deep enough to blow the
            # recursion limit) must not take the rest of the report down.
            try:
                tokens = _context_budget(p, tid)['task']
            except Exception:
                continue
            task_tokens.append(tokens)
            if tokens > BRIEF_TOKEN_BUDGET:
                over_budget += 1
    if task_tokens:
        avg = sum(task_tokens) / len(task_tokens)
        print(f"  task context budget     avg ~{avg:,.0f} tokens/task, task files/supporting reads "
              f"({over_budget} of {len(task_tokens)} over the "
              f"{BRIEF_TOKEN_BUDGET:,}-token budget)")
    else:
        print("  task context budget     n/a (no tasks found)")

    print("\nlagging indicators")

    by_sev = {}
    for p in phases:
        for f in p["findings"].values():
            by_sev[f["severity"]] = by_sev.get(f["severity"], 0) + 1
    total_findings = sum(by_sev.values())
    if total_findings:
        sev_line = ", ".join(f"{sev} {by_sev[sev]}" for sev in SEVERITIES if sev in by_sev)
        print(f"  findings by severity    {sev_line} ({total_findings} total)")
    else:
        print("  findings by severity    none recorded")

    reopened = sum(1 for p in closed for c in p["changelog"] if c["state"] == "open")
    print(f"  findings reopened       {reopened} (across {len(closed)} closed phase(s))")

    resolved = sum(1 for p in phases for f in p["findings"].values()
                   if f["status"] == "resolved")
    accepted = sum(1 for p in phases for f in p["findings"].values()
                   if f["status"] == "accepted")
    if resolved + accepted:
        share = 100.0 * resolved / (resolved + accepted)
        print(f"  resolved vs accepted    {resolved} resolved, {accepted} accepted "
              f"({share:.0f}% resolved)")
    else:
        print("  resolved vs accepted    n/a (no closed findings yet)")

    cycle_days = [d for d in (_git_cycle_days(p["path"]) for p in closed) if d is not None]
    if cycle_days:
        print(f"  phase cycle time        {_fmt_avg(cycle_days, 'd')} (git-tracked, closed)")
    else:
        print("  phase cycle time        n/a (no closed phase is tracked in git history)")

    return 0


# ----------------------------------------------------------------- guard

# Advisory prompt text asks a model to honour these rules; `plan guard` is the
# deterministic layer behind it, called from .claude/hooks/ on the Claude
# surface. Codex has no hook mechanism, so there the same rules stay advisory.
#
# Every path through guard fails open. It runs on every prompt and every file
# tool call in whatever repository the user happens to be in, including one
# that has never heard of coldsession, so absent, unreadable, or ambiguous
# plan state must exit 0 in silence. Deny only on a positive match.

GUARD_KINDS = ("read", "write", "lint", "stage")
AUTHORING_COMMANDS = ("cs-plan", "cs-revise")
JUDGING_COMMANDS = ("cs-review", "cs-approve", "cs-close")
# A 2.x compatibility alias runs the stage it aliases, so it has to face the
# same gate. Resolved to the canonical name before anything is checked or
# recorded: a gate that named only the canonical commands was one rename away
# from bypassable, and a session log that recorded both spellings would leave
# the same hole for whatever consults it next.
COMMAND_ALIASES = {"cs-recheck": "cs-review"}
CS_COMMAND_RE = re.compile(r"^[/$]?(cs-[a-z-]+)\b")
APPROVED_RE = re.compile(r"^status:\s*approved\s*$", re.M)


def _guard_deny(code, message, hint=""):
    """Exit 2 with the reason on stderr, which is what a hook feeds back."""
    print(f"{code} {message}", file=sys.stderr)
    if hint:
        print(f"  {hint}", file=sys.stderr)
    return 2


def _guard_phase():
    """The current phase, or None the moment anything is unclear.

    Deliberately not read_index(): that calls die() on a missing PLAN.md or a
    dangling `current:` pointer, and a guard that exits 1 there would break
    every session in every repository that does not use coldsession.
    """
    try:
        if not os.path.exists(INDEX):
            return None
        fm, _ = split_frontmatter(read_text(INDEX))
        m = re.search(r"^current:\s*(\S+)", fm, re.M)
        if not m:
            return None
        path = scope_path(m.group(1))
        plans = os.path.normcase(os.path.realpath(os.path.join(ROOT, 'docs', 'plans')))
        if not path.startswith(plans + os.sep) or not path.endswith('.md') or path.endswith('.log.md'):
            return None
        if not os.path.exists(path):
            return None
        return read_phase(path)
    except Exception:
        return None


def _guard_payload():
    """The hook event JSON on stdin, or {} when there is none.

    Hooks pipe the event in rather than passing arguments, so the shell
    wrappers stay trivial and every field is parsed in one place. The
    argument forms (`plan guard read src/a.py`) exist for humans and tests,
    and take precedence over anything on stdin.

    Decoded from bytes as utf-8-sig rather than read as text, for the reason
    read_text() gives: Windows PowerShell prepends a BOM when it pipes to a
    native command, and a BOM ahead of the opening brace makes json.loads
    raise -- which, because guard fails open, would turn every gate on that
    platform into a silent no-op. Reading bytes also keeps a non-ASCII path
    intact when the console codepage is not UTF-8.
    """
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        stream = getattr(sys.stdin, "buffer", None)
        raw = stream.read().decode("utf-8-sig", "replace") if stream else sys.stdin.read()
    except Exception:
        return {}
    raw = raw.strip()
    if not raw:
        return {}
    try:
        data = json.loads(raw)
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def _guard_norm(path):
    """One comparable form for a path: absolute against ROOT, case-folded."""
    if not path or not isinstance(path, str):
        return None
    try:
        p = os.path.expanduser(path.replace('\\', os.sep))
        if not os.path.isabs(p):
            p = os.path.join(ROOT, p)
        return os.path.normcase(os.path.realpath(p))
    except Exception:
        return None


def _guard_scope(phase, owner=None):
    """(in-progress task ids, allowed paths), or None when no build is running.

    `plan start` stamps the calling session onto the task it claims, so when
    the caller owns exactly the tasks it started, the gate scopes to those and
    the bounded-read contract stays as tight with six build sessions running
    as with one.

    Everything else falls back to the union of every in-progress task's read
    set: an unstamped claim from a pre-1.5 phase file, a Codex session that
    has no id to stamp, or a caller Orca and Claude Code both declined to
    name. The union is looser but never wrong, which is the trade guard makes
    everywhere -- it denies only on a positive match.

    PLAN.md and the phase handoff log join the set because a build session
    legitimately reads the index and appends to the log, and neither appears
    in any task's `files`.
    """
    if phase is None:
        return None
    active = [t for t in phase["order"] if phase["tasks"][t]["status"] == "in_progress"]
    if not active:
        return None
    if owner:
        mine = [t for t in active if phase["tasks"][t].get("owner") == owner]
        if mine:
            active = mine
    paths = {_guard_norm(INDEX), _guard_norm(phase["path"]),
             _guard_norm(phase["path"][:-3] + ".log.md")}
    for tid in active:
        for entry in read_set(phase, tid):
            paths.add(_guard_norm(entry))
    paths.discard(None)
    return active, paths


def _guard_read(phase, path, owner=None):
    scope = _guard_scope(phase, owner)
    if scope is None:
        return 0
    active, allowed = scope
    target = _guard_norm(path)
    root = _guard_norm(ROOT)
    if target is None or root is None or target in allowed:
        return 0
    if not target.startswith(root + os.sep):
        # Outside the project. What this gate enforces is "the files of this
        # repository, as listed in the brief"; a path outside it is not
        # something a phase file can describe, so it is not guard's to refuse.
        # Denying here buys little and false-positives on scratch space, and a
        # false positive on the happy path is the worse failure.
        return 0
    return _guard_deny(
        "E23",
        f"{os.path.relpath(target, root)} is not in the brief for "
        f"{', '.join(active)}",
        f"run `plan brief {active[0]}` for the read list. A file the task "
        "needs and the brief omits is a plan finding, not permission to "
        "widen context.")


def _guard_write(phase, path, payload):
    """Refuse the edit that sets `status: approved`.

    /cs-approve deliberately cannot approve: a clean pass writes `ready:
    <rev>` and the human sets the status. That is the one line in the
    workflow no agent may write, so it is checked rather than requested.

    Only an edit that *introduces* the line is refused. An edit that carries
    an already-approved status line through untouched is not an approval.
    """
    if phase is None:
        return 0
    root = _guard_norm(ROOT)
    target = _guard_norm(path)
    plans = _guard_norm(os.path.join(ROOT, "docs", "plans"))
    if target is None or plans is None or not target.startswith(plans + os.sep):
        return 0

    tool_input = payload.get("tool_input")
    tool_input = tool_input if isinstance(tool_input, dict) else {}
    try:
        before = read_text(target) if os.path.exists(target) else ""
    except Exception:
        before = ""

    edits = []
    if isinstance(tool_input.get("content"), str):
        edits.append((before, tool_input["content"]))
    if isinstance(tool_input.get("new_string"), str):
        edits.append((tool_input.get("old_string") or "", tool_input["new_string"]))
    for item in tool_input.get("edits") or []:
        if isinstance(item, dict) and isinstance(item.get("new_string"), str):
            edits.append((item.get("old_string") or "", item["new_string"]))

    for old, new in edits:
        if APPROVED_RE.search(new) and not APPROVED_RE.search(old):
            return _guard_deny(
                "E24",
                "an agent may not set `status: approved` in "
                f"{os.path.relpath(target, root)}",
                "/cs-approve writes `ready: <rev>` and stops. The human sets "
                "the status; that separation is the point of the checklist.")
    return 0


def _guard_phase_at(path):
    """The phase file just written, or None when it is not one of ours.

    Deliberately not `current:`. The hook fires on every Edit|Write, and the
    write that most needs linting is the next phase file -- /cs-plan writes
    it and only then moves the pointer, so keying on the pointer left the
    freshly authored file as the one file the gate could not see. The first
    /cs-plan of a project writes a phase file before PLAN.md exists at all.

    Widening past the pointer must not widen past coldsession, so the match
    is positive and made on the file itself: a `.md` under docs/plans/, not a
    `.log.md` handoff, that parses and declares a `phase:` in its
    frontmatter. A repository keeping unrelated markdown there gets nothing.
    """
    target = _guard_norm(path)
    plans = _guard_norm(os.path.join(ROOT, "docs", "plans"))
    if target is None or plans is None:
        return None
    if not target.startswith(plans + os.sep):
        return None
    if not target.endswith(".md") or target.endswith(".log.md"):
        return None
    try:
        phase = read_phase(target)
    except Exception:
        return None
    return phase if phase["meta"].get("phase") else None


def _guard_lint(path):
    """Surface a shape error on the write that caused it.

    Errors only -- `plan lint` exits non-zero on E-codes alone -- so a phase
    still being drafted does not fire on every intermediate save.
    """
    phase = _guard_phase_at(path)
    if phase is None:
        return 0
    target = phase["path"]
    try:
        errs, _ = lint_issues(phase)
    except Exception:
        return 0
    if not errs:
        return 0
    print(f"E-codes in {os.path.relpath(target, _guard_norm(ROOT))}:", file=sys.stderr)
    for line in errs:
        print(f"  {line}", file=sys.stderr)
    print("  fix these now rather than spending a review round on them.",
          file=sys.stderr)
    return 2


def _session_dir():
    base = os.environ.get("PLAN_SESSION_DIR")
    if base:
        return base
    return os.path.join(tempfile.gettempdir(), "coldsession-sessions")


def _session_log(session):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(session))[:120]
    return os.path.join(_session_dir(), safe + ".txt")


def _session_ran(session):
    try:
        with open(_session_log(session), encoding="utf-8") as handle:
            return [line.strip() for line in handle if line.strip()]
    except OSError:
        return []


def _session_record(session, command):
    try:
        os.makedirs(_session_dir(), exist_ok=True)
        with open(_session_log(session), "a", encoding="utf-8") as handle:
            handle.write(command + "\n")
    except OSError:
        pass


def _split_session(args):
    """(session id or None, the remaining arguments)."""
    rest = list(args)
    if "--session" not in rest:
        return None, rest
    i = rest.index("--session")
    session = rest[i + 1] if i + 1 < len(rest) else None
    return session, rest[:i] + rest[i + 2:]


def _guard_stage(args, payload):
    """Keep the judging commands cold.

    A review written in the session that wrote the plan has the right wording
    and none of the independence, which is worse than no review: it looks like
    one. The rule is the product's core claim, and until now was only ever
    asked for in prose.

    State is one line per command in a temp file keyed on the session id --
    sessions are ephemeral and so is this. No session id, and no readable
    plan state to judge against, both mean no basis to refuse, so both exit 0.
    """
    session, rest = _split_session(args)
    if session is None:
        session = payload.get("session_id")
    prompt = rest[0] if rest else payload.get("prompt")
    if not session or not isinstance(prompt, str):
        return 0

    m = CS_COMMAND_RE.match(prompt.strip())
    if not m:
        return 0
    command = COMMAND_ALIASES.get(m.group(1), m.group(1))

    if command in JUDGING_COMMANDS:
        authored = [c for c in _session_ran(session) if c in AUTHORING_COMMANDS]
        # Session history alone is not grounds to refuse. Everything else in
        # guard reads plan state before it denies; this did not, so a stray
        # session log was enough to gate /cs-review in a repository that has
        # no PLAN.md and never adopted coldsession. Checked here rather than
        # at the top of the function because /cs-plan legitimately runs
        # *before* PLAN.md exists -- it is the command that writes it -- so
        # the command still has to be recorded, and only the denial waits for
        # state that can justify it.
        if authored and _guard_phase() is not None:
            return _guard_deny(
                "E25",
                f"/{command} cannot run in the session that ran /{authored[0]}",
                "every step that judges the previous one runs cold. Exit this "
                f"session and run /{command} in a new one; the phase file "
                "carries everything it needs.")
    _session_record(session, command)
    return 0


def cmd_guard(_phase, args):
    """Deterministic gates behind the workflow's advisory rules.

      plan guard read  [PATH]                 bounded reads
      plan guard write [PATH]                 human-only approval
      plan guard lint  [PATH]                 lint on write
      plan guard stage [CMD] [--session ID]   cold judging sessions

    With no PATH or CMD the event is read as hook JSON on stdin.
    """
    if not args or args[0] not in GUARD_KINDS:
        # Silently. Guard has no caller but a hook, and a hook's stderr is
        # fed back to the model -- on UserPromptSubmit and PreToolUse it
        # arrives mid-turn, in whatever the user was actually doing. Usage
        # text belongs in `plan --help`, which lists the kinds, and not in
        # someone else's conversation.
        return 0
    kind, rest = args[0], args[1:]

    # Read stdin only when the arguments do not already answer the question.
    # A hook passes everything on stdin; a human passes it on the command
    # line and should not have the call block waiting for input that is
    # never coming.
    if kind == "stage":
        session, tail = _split_session(rest)
        needs_stdin = not (session and tail)
    else:
        needs_stdin = not rest or kind == "write"
    payload = _guard_payload() if needs_stdin else {}

    if kind != 'stage':
        normalized = normalize_event(payload)
        phase = _guard_phase()
        if phase and strict(phase):
            try:
                return strict_guard(phase, kind, rest, normalized)
            except (OSError, ValueError, TypeError, KeyError, AttributeError):
                return _guard_deny('E31', 'cannot validate hook payload or workflow state', 'run plan doctor and repair state before mutation')
        if phase is None and os.path.exists(INDEX) and kind == 'write':
            return _guard_deny('E31', 'cannot validate current workflow state', 'run plan doctor; repair PLAN.md before mutations')

    if kind == "stage":
        try:
            return _guard_stage(rest, payload)
        except Exception:
            return 0

    path = rest[0] if rest else None
    if path is None:
        tool_input = payload.get("tool_input")
        if isinstance(tool_input, dict):
            path = tool_input.get("file_path") or tool_input.get("path")
    if not path:
        return 0

    try:
        # lint decides from the written file alone, so it never pays for the
        # index read -- and this hook fires on every Edit and Write.
        if kind == "lint":
            return _guard_lint(path)
        phase = _guard_phase()
        if kind == "read":
            # The environment first, so the gate resolves the caller exactly
            # the way `plan start` did when it stamped the claim. The event's
            # session_id is the backstop for a surface that hands a hook the
            # id without also exporting it.
            owner = _owner_id() or payload.get("session_id")
            return _guard_read(phase, path, owner if isinstance(owner, str) else None)
        return _guard_write(phase, path, payload)
    except Exception:
        return 0


# ------------------------------------------------------------------ locking

# Every mutation is a read-modify-write of the whole phase file: main() parses
# it, the command edits that text, write_phase puts it back. Two commands whose
# spans overlap therefore lose one of the two writes, and `plan done T2` racing
# `plan done T3` from two build sessions is exactly the shape parallel builds
# produce. The lock spans the whole command rather than write_phase alone,
# because by the time write_phase runs the stale read has already happened.
#
# Read-only commands take no lock, and `guard` above all: it runs on every file
# tool call, and a gate that can block or fail is worse than no gate.

LOCK_TIMEOUT = 10.0
LOCK_STALE = 60.0


def _lock_dir():
    base = os.environ.get("PLAN_LOCK_DIR")
    if base:
        return base
    return os.path.join(tempfile.gettempdir(), "coldsession-locks")


def _lock_path(phase_path):
    """One lock file per phase file, keyed on its absolute path.

    Hashed and kept out of the repository: a lock is per-machine and
    ephemeral, so it has no business being a file the project can commit.
    """
    key = hashlib.sha256(os.path.normcase(os.path.realpath(phase_path)).encode("utf-8")).hexdigest()
    return os.path.join(_lock_dir(), key[:32] + ".lock")


def _lock_age(path):
    """Seconds since the lock was taken, or None if it is already gone.

    Deliberately os.stat rather than reading the file. On Windows CPython
    opens a file for reading without FILE_SHARE_DELETE, so a waiter that
    read the lock on every retry would make the holder's own unlink fail with
    a sharing violation -- orphaning the lock and stalling every waiter until
    the stale threshold. os.stat shares delete access and never blocks it.
    """
    try:
        return max(0.0, time.time() - os.stat(path).st_mtime)
    except OSError:
        return None


def _lock_pid(path):
    """The holder's pid, for the refusal message only. Best effort."""
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().split(" ")[0] or None
    except OSError:
        return None


def _lock_acquire(phase_path):
    """Claim one phase file for the length of one command.

    O_EXCL is the portable primitive: atomic on both platforms, no third-party
    file locking, and it leaves the holder's pid on disk for the error message.

    Returns the lock path. Unavailable locking refuses mutation. Locks never
    expire by age; interrupted processes require explicit operator recovery.
    """
    path = _lock_path(phase_path)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError as exc:
        die(f'cannot establish mutation lock: {exc}')
    deadline = time.monotonic() + LOCK_TIMEOUT
    while True:
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            pass
        except OSError as exc:
            die(f'cannot establish mutation lock: {exc}')
        else:
            try:
                os.write(fd, f"{os.getpid()} {time.time():.0f}".encode("utf-8"))
            finally:
                os.close(fd)
            return path

        if time.monotonic() >= deadline:
            die(f"another plan command is holding this phase "
                f"(pid {_lock_pid(path) or '?'}).\n"
                "  Wait for it to finish and rerun this command.\n"
                f"  If nothing is running, delete {path}.")
        time.sleep(0.05)


def _lock_release(path):
    """Drop the claim, retrying briefly.

    A single swallowed failure here is not a lost write but a lock nobody
    holds and nobody can take, which stalls every waiter until the stale
    threshold. Windows can still refuse the unlink if something has the file
    open for the moment, so give it a few tries before giving up.
    """
    if not path:
        return
    for _ in range(20):
        try:
            os.unlink(path)
            return
        except FileNotFoundError:
            return
        except OSError:
            time.sleep(0.01)


# -------------------------------------------------------- version 2 contract

def strict(phase):
    return phase['meta'].get('workflow-rev', '1').split('.')[0] == '2'


def normalize_event(payload):
    data = payload.get('tool_input', payload.get('input', payload.get('arguments', {})))
    if isinstance(data, str):
        try:
            data = json.loads(data)
        except ValueError:
            data = {'patch': data}
    if not isinstance(data, dict):
        data = {}
    return {'tool_name': payload.get('tool_name', payload.get('name', '')),
            'tool_input': data, 'session_id': payload.get('session_id', payload.get('thread_id'))}


def sensitive(path):
    parts = path.replace('\\', '/').lower().split('/')
    leaf = parts[-1]
    return ('.git' in parts or '.ssh' in parts or leaf == '.env' or
            (leaf.startswith('.env.') and leaf not in ('.env.example', '.env.sample')) or
            leaf.endswith(('.pem', '.key', '.p12')) or leaf in ('credentials', 'credentials.json'))


def strict_guard(phase, kind, args, payload):
    data = payload['tool_input']
    if kind == 'lint':
        return _guard_lint(args[0] if args else data.get('file_path', data.get('path')))
    paths = [args[0]] if args else [data.get('file_path', data.get('path'))]
    patch = data.get('patch', data.get('input', ''))
    if isinstance(patch, str) and '*** Begin Patch' in patch:
        paths = re.findall(r'^\*\*\* (?:Update File|Add File|Delete File|Move to): (.+)$', patch, re.M)
        if re.search(r'^\+status:\s*approved\s*$', patch, re.M):
            return _guard_deny('E24', 'an agent may not approve a phase', 'human approval is required')
    tasks = [tid for tid, t in phase['tasks'].items() if t['status'] == 'in_progress']
    if tasks and kind == 'write' and phase['meta'].get('ready-spec') != specification(phase):
        return _guard_deny('E29', 'approved specification changed, including resolved scope paths', 'settle work and run plan replan')
    owner = os.environ.get('CS_WORKER_ASSIGNMENT') or _owner_id() or payload.get('session_id')
    if owner:
        assignments = load_json(assignment_path(phase), {})
        mine = [tid for tid in tasks if phase['tasks'][tid].get('owner') == owner or
                owner in (assignments.get(tid, {}).get('assignment'), assignments.get(tid, {}).get('worker'))]
        if mine:
            tasks = mine
        elif tasks and not (len(tasks) == 1 and not phase['tasks'][tasks[0]].get('owner')) and not any(
                a.get('coordinator') == owner for a in assignments.values()):
            return _guard_deny('E32', 'session does not own an active task', 'use the coordinator or explicitly resume the correct claim')
    command = data.get('command', data.get('cmd'))
    if isinstance(command, list):
        command = ' '.join(shlex.quote(str(word)) for word in command)
    if command and kind == 'write':
        # Arbitrary shell is a language, not a safely parseable list of paths.
        # Permit the validated runtime and filename-only discovery. Native
        # permissions remain authoritative for all other execution.
        if sensitive(command):
            return _guard_deny('E33', 'shell references sensitive files', 'use project-approved secret handling')
        if tasks:
            safe = safe_runtime_command(command)
            discovery = command.strip() == 'rg --files'
            if not safe and not discovery:
                return _guard_deny('E34', 'shell payload cannot be proven within task scope',
                                   'use scoped file tools, filename discovery, or plan verify; retain native permissions')
        elif re.search(r'approved|PLAN\.md|docs[/\\]plans', command, re.I):
            return _guard_deny('E24', 'shell mutation of workflow documents cannot be validated', 'use scoped edit tools and plan commands')
        return 0
    if kind == 'write' and not any(paths):
        return _guard_deny('E31', 'write payload has no verifiable paths', 'use a supported scoped file tool')
    for path in filter(None, paths):
        if sensitive(path):
            return _guard_deny('E33', 'sensitive file access is restricted', 'use project-approved secret handling')
        target = _guard_norm(path)
        root = os.path.normcase(ROOT)
        if not target or not target.startswith(root + os.sep):
            return _guard_deny('E26', 'path escapes repository after resolving links', 'use repository file paths')
        if kind == 'write':
            denied = _guard_write(phase, path, payload)
            if denied:
                return denied
        if tasks:
            allowed = set()
            for tid in tasks:
                entries = phase['tasks'][tid]['files'] if kind == 'write' else read_set(phase, tid)
                allowed.update(_guard_norm(p) for p in entries)
            if kind == 'read':
                allowed.add(_guard_norm(INDEX))
            if target not in allowed:
                return _guard_deny('E23', f'{kind} outside task scope: {path}',
                                   'correct an insufficient brief through replan before implementation')
    return 0


def safe_runtime_command(command):
    if re.search(r'[;&|<>`$%\r\n]', command):
        return False
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    if words and words[0] in ('python', 'python3', 'py'):
        words = words[1:]
    executables = {prefix + suffix for prefix in ('.claude/bin/plan', '.agents/coldsession/bin/plan')
                   for suffix in ('', '.cmd')}
    return bool(len(words) >= 2 and words[0] in executables and words[1] in
                ('status', 'lint', 'brief', 'next', 'recommend', 'verify', 'done', 'block', 'handoff', 'integrate', 'assign'))


def scope_path(value):
    """Exact repository file, with links/junctions resolved before authorization."""
    value = value.replace('\\', '/')
    if (not value or value.startswith('/') or re.match(r'^[A-Za-z]:', value)
            or any(p in ('..', '.', '') for p in value.split('/'))
            or any(c in value for c in '*?[]:')):
        raise ValueError(f'invalid repository file path {value!r}')
    path = os.path.normcase(os.path.realpath(os.path.join(ROOT, value)))
    root = os.path.normcase(os.path.realpath(ROOT))
    if not path.startswith(root + os.sep):
        raise ValueError(f'path escapes repository: {value}')
    if os.path.isdir(path):
        raise ValueError(f'scope must name a file, not a directory: {value}')
    return path


def phase_path(value):
    try:
        path = scope_path(value)
        plans = os.path.normcase(os.path.realpath(os.path.join(ROOT, 'docs', 'plans')))
        if not path.startswith(plans + os.sep) or not path.endswith('.md') or path.endswith('.log.md'):
            raise ValueError('current must name a phase .md file under docs/plans')
        return path
    except ValueError as exc:
        die(str(exc))


def digest(value):
    return hashlib.sha256(value).hexdigest()


def specification(phase):
    """Hash requirements, including headings and unknown prose, excluding bookkeeping."""
    fm, body = split_frontmatter(phase['text'])
    chunks = re.split(r'(?=^##\s)', COMMENT_RE.sub('', body), flags=re.M)
    prose = []
    for chunk in chunks:
        head = chunk.splitlines()[0].strip() if chunk.splitlines() else ''
        if head.lower() in ('## findings', '## changelog', '## migration', '## history'):
            continue
        prose.append('\n'.join(line.rstrip() for line in chunk.strip().splitlines()))
    def canonical(key, values):
        if key == 'deps':
            return sorted(values)
        result = []
        for value in values:
            try:
                result.append(os.path.relpath(scope_path(value), ROOT).replace(os.sep, '/'))
            except ValueError:
                result.append('invalid:' + value)
        return sorted(result)
    contract = {'phase': phase['meta'].get('phase'), 'prose': prose,
                'tasks': {tid: {key: canonical(key, task.get(key, [])) for key in ('deps', 'files', 'reads')}
                          for tid, task in phase['tasks'].items()}}
    return digest(json.dumps(contract, sort_keys=True, ensure_ascii=True).encode())


def atomic_write(path, text):
    path = os.path.abspath(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.cs-', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8', newline='\n') as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        if os.path.exists(path):
            os.chmod(temporary, os.stat(path).st_mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def state_path(name):
    return os.path.join(ROOT, '.coldsession-state', name)


def load_json(path, default=None):
    if not os.path.exists(path):
        return default
    return json.loads(read_text(path))


def save_json(path, value):
    atomic_write(path, json.dumps(value, sort_keys=True, indent=2) + '\n')


def json_input(value):
    """Accept a JSON object, stdin, or an existing file without forcing scratch writes."""
    if value == '--stdin':
        return json.loads(sys.stdin.read(16385))
    if value.lstrip().startswith('{'):
        if len(value) > 16384:
            die('JSON input exceeds 16384 characters')
        return json.loads(value)
    return load_json(scope_path(value))


def transaction(changes):
    journal = state_path('transaction.json')
    entries = [{'path': os.path.relpath(path, ROOT).replace(os.sep, '/'),
                'before': read_text(path) if os.path.exists(path) else None, 'after': text}
               for path, text in changes.items()]
    save_json(journal, entries)
    recover_transaction()


def recover_transaction():
    journal = state_path('transaction.json')
    entries = load_json(journal)
    if entries is None:
        return
    # Validate all inputs before writing any; replay is safe after any prefix.
    for entry in entries:
        path = scope_path(entry['path'])
        current = read_text(path) if os.path.exists(path) else None
        if current not in (entry['before'], entry['after']):
            die(f'incomplete transaction conflicts with {entry["path"]}; preserve changes and recover from {journal}')
    for entry in entries:
        atomic_write(scope_path(entry['path']), entry['after'])
    os.unlink(journal)


def evidence_path(phase):
    return phase['path'][:-3] + '.evidence.json'


def verification_checks(phase, tid):
    checks = []
    for line in phase['sections'].get(tid, '').splitlines():
        line = line.strip().lstrip('-* ').strip()
        if not line.startswith('Verify:'):
            continue
        raw = line[7:].strip()
        match = re.fullmatch(r'`([^`\n]+)`(?: exits 0)?', raw)
        if match:
            checks.append({'kind': 'automated', 'command': match.group(1)})
        elif re.match(r'^(manual|visual):\s*\S', raw):
            kind, description = raw.split(':', 1)
            checks.append({'kind': kind, 'command': description.strip()})
        else:
            raise ValueError('Verify must be `exact command` exits 0, manual: action, or visual: action; one per line')
    if not checks:
        raise ValueError('no declared verification')
    return checks


def working_fingerprint(phase, tid):
    paths = set(phase['tasks'][tid]['files'] + phase['tasks'][tid].get('reads', []))
    for dep in _transitive_deps(phase, tid):
        paths.update(phase['tasks'][dep]['files'])
    values = []
    for entry in sorted(paths):
        path = scope_path(entry)
        if os.path.exists(path):
            with open(path, 'rb') as handle:
                h = hashlib.sha256()
                for chunk in iter(lambda: handle.read(65536), b''):
                    h.update(chunk)
            value = h.hexdigest()
        else:
            value = 'missing'
        values.append((entry, os.path.relpath(path, ROOT).replace(os.sep, '/'), value))
    return digest(json.dumps(values).encode())


def task_conflict(phase, left, right):
    a, b = phase['tasks'][left], phase['tasks'][right]
    aw = {scope_path(p) for p in a['files']}
    bw = {scope_path(p) for p in b['files']}
    ar = {scope_path(p) for p in a.get('reads', [])}
    br = {scope_path(p) for p in b.get('reads', [])}
    return bool(aw & (bw | br) or bw & ar)


def evidence_valid(phase, tid):
    record = (load_json(evidence_path(phase), {}) or {}).get(tid, {})
    return (record.get('spec') == specification(phase) and
            record.get('files') == working_fingerprint(phase, tid) and
            record.get('checks-hash') == digest(json.dumps(verification_checks(phase, tid), sort_keys=True).encode()) and
            record.get('success') is True)


def redact(text):
    text = re.sub(r'-----BEGIN [^-]*PRIVATE KEY-----.*?(?:-----END [^-]*PRIVATE KEY-----|\Z)',
                  '[REDACTED PRIVATE KEY]', text, flags=re.S)
    text = re.sub(r'(?i)\b(authorization|api[_-]?key|token|secret|password)\s*[:=]\s*[^\r\n]+',
                  r'\1=[REDACTED]', text)
    return re.sub(r'\b(?:sk-[\w-]{12,}|gh[pousr]_[\w]{15,}|AKIA[A-Z0-9]{16})\b', '[REDACTED]', text)


def bounded_run(command, timeout=300, env=None, shell=True):
    """Drain continuously with bounded memory. Never persist an environment dump."""
    output = bytearray()
    total = [0]
    try:
        process = subprocess.Popen(command, cwd=ROOT, shell=shell, env=env,
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   start_new_session=os.name != 'nt')
    except OSError as exc:
        return {'exit': 127, 'output': redact(str(exc)), 'truncated': False, 'timeout': False}
    def drain():
        while True:
            chunk = process.stdout.read(4096)
            if not chunk:
                break
            total[0] += len(chunk)
            output.extend(chunk[:max(0, 16384 - len(output))])
    reader = threading.Thread(target=drain, daemon=True)
    reader.start()
    timed_out = False
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        if os.name == 'nt':
            subprocess.run(['taskkill', '/PID', str(process.pid), '/T', '/F'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            import signal
            os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    reader.join(timeout=2)
    if not reader.is_alive():
        process.stdout.close()
    return {'exit': process.returncode, 'output': redact(output.decode('utf-8', 'replace')),
            'truncated': total[0] > len(output) or reader.is_alive(), 'timeout': timed_out}


def validate_transition(phase, name, args):
    """Single entry gate for the strict workflow, including resume and completion."""
    if phase['malformed']:
        die('invalid task graph; run plan lint and repair duplicate/malformed IDs')
    if not strict(phase):
        return
    if phase['meta'].get('status') == 'closed':
        die('historical closed phase is read-only; run /cs-plan')
    assignments = load_json(assignment_path(phase), {})
    actor = _owner_id() or 'local operator'
    if assignments and any(a.get('coordinator') != actor for a in assignments.values()):
        die('shared workflow state belongs to the assignment coordinator')
    if name == 'done' and args and args[0].upper() in assignments:
        die('assigned tasks must complete through plan integrate with the current result receipt')
    if name in ('replan', 'block', 'resolve', 'bump', 'handoff'):
        return
    if name == 'finish' and '--fail' in args:
        return  # cmd_finish requires a persisted finding/error and the matching claim
    errs, _ = lint_issues(phase)
    if errs:
        die('workflow state is invalid: ' + '; '.join(errs) + '; run plan replan for recovery')
    if phase['meta'].get('status') == 'closed':
        die('historical closed phase is read-only; run /cs-plan')
    if name in ('start', 'done', 'verify', 'assign', 'integrate'):
        if phase['meta'].get('status') != 'approved' or phase['meta'].get('active'):
            die('execution requires an approved phase with no active review stage')
        if open_findings(phase):
            die('open findings prevent execution; run plan replan')
        if name in ('start', 'done', 'verify'):
            tid = args[0].upper() if args else ''
            if tid not in phase['tasks']:
                die('supply a valid task ID')
            task = phase['tasks'][tid]
            if any(phase['tasks'][d]['status'] != 'done' for d in task['deps']):
                die(f'{tid} has unfinished dependencies')
            for dep in task['deps']:
                if not evidence_valid(phase, dep):
                    die(f'{tid} dependency evidence is missing or stale; run plan verify {dep}')
            if name == 'start':
                for other, candidate in phase['tasks'].items():
                    if other != tid and candidate['status'] == 'in_progress' and task_conflict(phase, tid, other):
                        die(f'{tid} conflicts with running task {other}')
            elif task['status'] not in (('in_progress', 'done') if name == 'verify' else ('in_progress',)):
                die(f'{tid} must be in_progress before {name}')
            if name == 'done' and not evidence_valid(phase, tid):
                die(f'{tid} needs matching successful evidence; run plan verify {tid}')
    if name in ('begin', 'finish') and args and args[0] == 'close':
        for tid in phase['order']:
            if not evidence_valid(phase, tid):
                die(f'{tid} completion is historical or verification is stale; run plan verify {tid}')
    if name == 'begin' and args and args[0] in ('review', 'approve'):
        if any(t['status'] == 'in_progress' for t in phase['tasks'].values()):
            die('running work must settle before review')
        if args[0] == 'approve' and phase['meta'].get('reviewed-spec') != specification(phase):
            die('reviewed specification changed; run plan replan')


def cmd_verify(phase, args):
    if not args or args[0].upper() not in phase['tasks']:
        die('usage: plan verify T1 [--attest "observed result"] [--timeout SECONDS]')
    tid = args[0].upper()
    checks = verification_checks(phase, tid)
    attest = args[args.index('--attest') + 1] if '--attest' in args and args.index('--attest') + 1 < len(args) else ''
    timeout = intof(args[args.index('--timeout') + 1], 300) if '--timeout' in args else 300
    if timeout < 1 or timeout > 3600:
        die('verification timeout must be between 1 and 3600 seconds')
    spec, before = specification(phase), working_fingerprint(phase, tid)
    records = load_json(evidence_path(phase), {})
    records[tid] = {'spec': spec, 'files': before, 'success': False,
                    'state': 'running', 'at': datetime.now().isoformat()}
    save_json(evidence_path(phase), records)
    results = []
    for check in checks:
        if check['kind'] == 'automated':
            result = bounded_run(check['command'], timeout=timeout)
        else:
            result = {'exit': 0 if attest.strip() else None, 'attestation': redact(attest)[:4096],
                      'actor': _owner_id() or 'local operator', 'truncated': len(attest) > 4096}
        results.append(result)
    fresh = read_phase(phase['path'])
    after = working_fingerprint(fresh, tid)
    success = (before == after and spec == specification(fresh) and
               all(r['exit'] == 0 and not r.get('timeout') for r in results))
    records = load_json(evidence_path(phase), {})
    records[tid] = {'spec': spec, 'files': before,
                    'checks': [{**check, 'command': redact(check['command'])} for check in checks],
                    'checks-hash': digest(json.dumps(checks, sort_keys=True).encode()), 'results': results,
                    'success': success, 'at': datetime.now().isoformat()}
    save_json(evidence_path(phase), records)
    print(json.dumps(records[tid], indent=2))
    if not success:
        print('verification failed, lacked an attestation, or inputs changed; rerun before done', file=sys.stderr)
    return 0 if success else 1


def cmd_replan(phase, args):
    if phase['meta'].get('status') == 'closed':
        die('closed history cannot be replanned; run /cs-plan for a new phase')
    active = phase['meta'].get('active') or any(t['status'] == 'in_progress' for t in phase['tasks'].values())
    if active and '--recover-claims' not in args:
        die('claims remain; settle workers, then explicitly run plan replan --recover-claims; age alone is not abandonment')
    text = phase['text']
    for tid, task in phase['tasks'].items():
        if task['status'] != 'done':
            text = re.sub(r'^(  ' + tid + r':.*?status:\s*)\w+', r'\g<1>pending', text, flags=re.M)
            text = _set_owner(text, tid, None)
    text = set_metas(text, {'status': 'draft', 'rev': intof(phase['meta'].get('rev'), 1) + 1},
                     remove=('ready', 'ready-spec', 'reviewed', 'reviewed-spec', 'active', 'active-rev', 'active-spec'))
    text = append_to_block(text, 'History', f"Replan from rev {phase['meta'].get('rev')}; completed work and findings retained.")
    transaction({phase['path']: text, assignment_path(phase): '{}\n'})
    print('unfinished work -> draft; findings and completion history retained; next /cs-review in a fresh session')


def relevant_handoffs(phase, tid):
    records = load_json(phase['path'][:-3] + '.handoffs.json', [])
    superseded = {key for entry in records for key in entry.get('supersedes', [])}
    log = phase['path'][:-3] + '.log.md'
    legacy = []
    if os.path.exists(log):
        for heading, content in parse_blocks(read_text(log)).items():
            tasks = re.findall(r'\bT\d+\b', heading)
            if tasks:
                legacy.append({'id': 'legacy-' + digest((heading + content).encode())[:16],
                                   'task': tasks[0], 'affects': tasks, 'decisions': redact(content)[:2048],
                                   'provenance': os.path.relpath(log, ROOT) + '#' + heading,
                                   'limitations': 'Legacy narrative; not automated verification evidence.'})
    records = legacy + records
    relevant = set(_transitive_deps(phase, tid) + [tid])
    return [e for e in records if e['id'] not in superseded and
            (e.get('task') in relevant or tid in e.get('affects', []))][-8:]


def cmd_handoff(phase, args):
    if len(args) != 2 or args[0] not in phase['tasks']:
        die('usage: plan handoff T1 <JSON-file> (decisions, evidence, limitations, affects, provenance, supersedes)')
    entry = json_input(args[1])
    required = ('decisions', 'evidence', 'limitations', 'affects', 'provenance', 'supersedes')
    if not isinstance(entry, dict) or any(key not in entry for key in required):
        die('handoff is missing required fields')
    if len(json.dumps(entry)) > 4096:
        die('handoff exceeds 4096 characters')
    if not isinstance(entry['affects'], list) or any(t not in phase['tasks'] for t in entry['affects']):
        die('handoff affects must contain known task IDs')
    path = phase['path'][:-3] + '.handoffs.json'
    entries = load_json(path, [])
    known = {e['id'] for e in entries}
    known.update(e['id'] for tid in phase['order'] for e in relevant_handoffs(phase, tid))
    if not isinstance(entry['supersedes'], list) or any(key not in known for key in entry['supersedes']):
        die('supersedes must name existing handoff IDs')
    entry = {key: redact(value) if isinstance(value, str) else value for key, value in entry.items()}
    entry.update(id=uuid.uuid4().hex, task=args[0], spec=specification(phase), at=datetime.now().isoformat())
    entries.append(entry)
    save_json(path, entries)
    print(entry['id'])


def assignment_path(phase):
    return phase['path'][:-3] + '.assignments.json'


def cmd_assign(phase, args):
    if not strict(phase):
        die('team assignments require an explicit format 2 upgrade')
    if len(args) == 3 and args[0] == '--bind':
        tid, worker = args[1].upper(), args[2]
        records = load_json(assignment_path(phase), {})
        if tid not in records or records[tid]['spec'] != specification(phase):
            die('cannot bind an unknown or superseded assignment')
        if records[tid].get('worker') not in (None, worker):
            die('assignment is already bound; settle the worker and explicitly recover claims before replacement')
        if not re.fullmatch(r'[A-Za-z0-9_./:-]+', worker):
            die('worker session identity contains unsupported characters')
        if any(record.get('worker') == worker for key, record in records.items() if key != tid):
            die('worker session already owns another assignment')
        records[tid]['worker'] = worker
        transaction({phase['path']: _set_owner(phase['text'], tid, worker),
                     assignment_path(phase): json.dumps(records, indent=2) + '\n'})
        print(f'{tid} bound to worker session {worker}; assignment ID unchanged')
        return 0
    if not args or args[0] not in ('orca', 'codex', 'claude'):
        die('usage: plan assign orca|codex|claude [--max N], or plan assign --bind T1 WORKER_SESSION')
    if not _owner_id():
        die('team coordination requires a stable harness session identity; use manual builds if none is exported')
    if os.environ.get('CS_WORKER_ASSIGNMENT'):
        die('nested fanout is prohibited')
    maximum = intof(args[args.index('--max') + 1], 2) if '--max' in args else 2
    if maximum < 1 or maximum > 8:
        die('--max must be between 1 and 8')
    records = load_json(assignment_path(phase), {})
    if records:
        die('an assignment group still exists; integrate it or explicitly recover claims before dispatch')
    occupied = {scope_path(p) for t in phase['tasks'].values() if t['status'] == 'in_progress' for p in t['files']}
    text = phase['text']
    for tid in runnable(phase):
        paths = {scope_path(p) for p in phase['tasks'][tid]['files']}
        if paths & occupied or any(task_conflict(phase, tid, other) for other in
                                   list(records) + [t for t, value in phase['tasks'].items() if value['status'] == 'in_progress']):
            continue
        if any(not evidence_valid(phase, dep) for dep in phase['tasks'][tid]['deps']):
            continue
        assignment = uuid.uuid4().hex
        records[tid] = {'task': tid, 'spec': specification(phase), 'assignment': assignment,
                        'backend': args[0], 'coordinator': _owner_id() or 'local operator',
                        'files': phase['tasks'][tid]['files'], 'reads': phase['tasks'][tid]['reads'],
                        'verify': verification_checks(phase, tid),
                        'expected': 'return task, spec, assignment, outcome, decisions, evidence, limitations; no state writes or commits'}
        text = re.sub(r'^(  ' + tid + r':.*?status:\s*)pending', r'\g<1>in_progress', text, flags=re.M)
        text = _set_owner(text, tid, assignment)
        occupied.update(paths)
        if len(records) >= maximum:
            break
    if not records:
        die('no approved nonconflicting tasks; run plan recommend')
    transaction({phase['path']: text, assignment_path(phase): json.dumps(records, indent=2) + '\n'})
    print(json.dumps(records, indent=2))


def cmd_integrate(phase, args):
    if len(args) != 1:
        die('usage: plan integrate <worker-result.json>')
    result = json_input(args[0])
    records = load_json(assignment_path(phase), {})
    tid = result.get('task')
    assignment = records.get(tid)
    if not assignment or any(result.get(key) != assignment[key] for key in ('spec', 'assignment')):
        die('superseded or unknown worker result; preserve source changes and inspect current assignments')
    if result['spec'] != specification(phase):
        die('phase changed during execution; stop integration and run plan replan after workers settle')
    if result.get('outcome') != 'success':
        return cmd_block(phase, [tid, 'worker blocker: ' + str(result.get('limitations', 'unspecified'))])
    if not evidence_valid(phase, tid):
        die(f'coordinator must run plan verify {tid} before integration')
    del records[tid]
    text = re.sub(r'^(  ' + tid + r':.*?status:\s*)in_progress', r'\g<1>done', phase['text'], flags=re.M)
    text = _set_owner(text, tid, None)
    transaction({phase['path']: text, assignment_path(phase): json.dumps(records, indent=2) + '\n'})
    print(f'{tid} integrated; coordinator may record handoff and commit')


def cmd_doctor(_phase, args):
    report = {'release': TOOL_VERSION, 'format': FORMAT_VERSION,
              'python': sys.version.split()[0], 'runtime_compatible': sys.version_info >= (3, 9),
              'adapters': {}, 'hooks': {}, 'trust': 'unknown: confirm in each harness',
              'gaps': ['Hooks do not replace native sandbox, permissions, or hook trust.',
                       'Arbitrary shell/program execution and MCP tools cannot be fully analyzed.',
                       'Codex hook registration depends on installed harness support; inspect its configuration.',
                       'Native team tools must be available in the current session; CLI presence is insufficient.']}
    def diagnostic_json(path):
        try:
            value = load_json(path, {})
            if not isinstance(value, dict):
                raise ValueError('expected an object')
            return value
        except (OSError, ValueError):
            report.setdefault('diagnostic_errors', []).append('unreadable or invalid JSON: ' + os.path.relpath(path, ROOT))
            return {}
    for name, relative in (('claude', '.claude/bin/plan'), ('codex', '.agents/coldsession/bin/plan')):
        report['adapters'][name] = {'installed': os.path.isfile(os.path.join(ROOT, relative)),
                                   'cli_detected': bool(shutil.which(name))}
        if shutil.which(name):
            report['adapters'][name]['version'] = bounded_run([shutil.which(name), '--version'], timeout=5, shell=False)
    settings = diagnostic_json(os.path.join(ROOT, '.claude', 'settings.json'))
    report['hooks']['claude_disabled'] = settings.get('disableAllHooks', False)
    report['hooks']['claude_events'] = sorted(settings.get('hooks', {}).keys())
    report['hooks']['claude_managed'] = 'cs-guard-' in json.dumps(settings.get('hooks', {}))
    report['hooks']['codex_config_present'] = os.path.exists(os.path.join(ROOT, '.codex', 'config.toml'))
    if report['hooks']['codex_config_present']:
        config = read_text(os.path.join(ROOT, '.codex', 'config.toml'))
        report['hooks']['codex_managed'] = '# BEGIN coldsession managed hooks' in config
        try:
            import tomllib
        except ImportError:
            report['gaps'].append('Python <3.11: no stdlib TOML parser; Codex configuration validity is unknown.')
        else:
            try:
                parsed = tomllib.loads(config)
                report['hooks']['codex_events'] = sorted(parsed.get('hooks', {}))
                report['hooks']['codex_config_valid'] = True
            except ValueError:
                report['hooks']['codex_config_valid'] = False
    ownership = diagnostic_json(state_path('installed.json'))
    inconsistent = []
    for relative, expected in ownership.get('files', {}).items():
        try:
            path = scope_path(relative)
            with open(path, 'rb') as handle:
                actual = digest(handle.read())
        except (OSError, ValueError):
            actual = None
        if actual != expected:
            inconsistent.append(relative)
    report['installed_file_changes'] = inconsistent
    report['session_identity_detected'] = bool(_owner_id())
    report['codex_recorded_trust'] = 'unknown'
    try:
        import tomllib
        user_config = os.path.join(os.environ.get('CODEX_HOME', os.path.join(os.path.expanduser('~'), '.codex')), 'config.toml')
        if os.path.isfile(user_config):
            projects = tomllib.loads(read_text(user_config)).get('projects', {})
            for project, entry in projects.items():
                if _guard_norm(project) == _guard_norm(ROOT):
                    trust = entry.get('trust_level')
                    if trust in ('trusted', 'untrusted'):
                        report['codex_recorded_trust'] = trust
    except (ImportError, OSError, ValueError, AttributeError):
        pass  # Recorded trust is a diagnostic hint, never a permission grant.
    report['upgrade'] = diagnostic_json(state_path('upgrade.json')).get('status', 'none')
    report['workflow_transaction_pending'] = os.path.exists(state_path('transaction.json'))
    try:
        if os.path.exists(INDEX):
            phase = read_phase(read_index())
            report['workflow_errors'], report['workflow_warnings'] = lint_issues(phase)
            report['next'] = ' '.join(recommend(phase))
    except (OSError, ValueError, SystemExit):
        report['workflow_errors'] = ['invalid PLAN.md/current phase; repair the pointer or document']
    if '--json' in args:
        print(json.dumps(report, indent=2))
    else:
        for key, value in report.items():
            print(f'{key}: {json.dumps(value) if isinstance(value, (dict, list)) else value}')
    return 0


# ------------------------------------------------------------------- orca

# Orca is an editor that runs each checkout as a tracked workspace with a
# status column and a comment on its card. When plan runs inside one, the
# phase's state is worth pushing there, so a board of ten worktrees answers
# "where is this one" without opening a terminal in each. Everything below is
# a convenience: a missing, slow, or unhappy Orca must never change what plan
# does, how long it takes, or what it prints.

ORCA_TIMEOUT = 5
ORCA_STATUS = {"draft": "todo", "approved": "in-progress", "closed": "completed"}
MUTATING = ("start", "done", "block", "begin", "finish", "resolve", "bump",
            "reviewed", "verify", "replan", "handoff", "assign", "integrate", "recover")


def _orca_cli():
    """The Orca CLI for this session, or None when there is nothing to mirror.

    ORCA_WORKTREE_ID gates the whole feature. It is set only inside an
    Orca-managed terminal, so a non-Orca user never pays for a subprocess --
    and, because the terminal is managed, bare `orca` is the Orca CLI on every
    platform. Outside one, on Linux, it would usually be the GNOME screen
    reader, which is why this returns None rather than guessing a name.
    """
    if not os.environ.get("ORCA_WORKTREE_ID"):
        return None
    explicit = os.environ.get("ORCA_CLI_COMMAND")
    if explicit:
        return explicit
    return "orca-dev" if os.environ.get("ORCA_DEV_REPO_ROOT") else "orca"


def _orca(*args):
    """Run one Orca command, best effort. Never raises, never prints.

    Every failure -- no Orca, no binary on PATH, a timeout, a non-zero exit --
    is the same silent no-op, for the reason guard fails open: a side channel
    that breaks the thing it decorates is worse than no side channel.
    """
    cli = _orca_cli()
    if not cli:
        return None
    try:
        proc = subprocess.run([cli, *args], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=ORCA_TIMEOUT)
    except Exception:
        return None
    return proc.stdout if proc.returncode == 0 else None


def _orca_card(phase):
    """(workspace status id, comment) for the phase as it now stands.

    An active stage means the phase is being judged rather than built, which
    is `in-review` whatever the phase status says underneath it.
    """
    meta = phase["meta"]
    if meta.get("active") in STAGES:
        status = "in-review"
    else:
        status = ORCA_STATUS.get(meta.get("status", "draft"), "todo")
    cmd, _ = recommend(phase)
    done = sum(1 for t in phase["order"] if phase["tasks"][t]["status"] == "done")
    comment = (f"{meta.get('phase', '?')} rev {intof(meta.get('rev'), 1)} | "
               f"{done}/{len(phase['order'])} done | next {cmd}")
    return status, comment


def _orca_mirror():
    """Push the phase's state onto its Orca card. Best effort, always silent.

    Called once from main() after a mutating command rather than from each
    command, because only main() knows the command ran to completion -- every
    refusal path dies before returning. The phase is re-read because the
    command edited the file after `phase` was parsed.

    die() raises SystemExit, which is not an Exception, so an unreadable index
    or phase has to be caught explicitly or it would escape a helper whose
    whole contract is that it cannot fail.
    """
    if not _orca_cli():
        return
    try:
        status, comment = _orca_card(read_phase(read_index()))
    except (Exception, SystemExit):
        return
    _orca("worktree", "set", "--worktree", "active",
          "--workspace-status", status, "--comment", comment, "--json")


COMMANDS = {"version": cmd_version, "status": cmd_status, "lint": cmd_lint,
            "next": cmd_next, "brief": cmd_brief, "start": cmd_start,
            "done": cmd_done, "block": cmd_block, "begin": cmd_begin,
            "finish": cmd_finish,
            "findings": cmd_findings, "resolve": cmd_resolve, "bump": cmd_bump,
            "reviewed": cmd_reviewed, "recommend": cmd_recommend,
            "metrics": cmd_metrics, "guard": cmd_guard,
            "verify": cmd_verify, "replan": cmd_replan, "doctor": cmd_doctor,
            "handoff": cmd_handoff, "assign": cmd_assign, "integrate": cmd_integrate,
            "recover": None}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    name = argv[0]
    if name not in COMMANDS:
        die(f"unknown command {name!r}. Try: {', '.join(COMMANDS)}")
    if name in ("version", "metrics", "guard", "doctor"):
        # None of the three answer from a `current:` phase: version needs no
        # phase file at all, metrics scans every phase file itself, and guard
        # reads plan state defensively because it runs from a hook in
        # whatever repository the user is in. None may go through
        # read_phase(read_index()) -- that dies on a repo with no PLAN.md
        # yet, which is exactly the case both must fail open on.
        return COMMANDS[name](None, argv[1:])
    if name not in MUTATING:
        path = read_index()
        return COMMANDS[name](read_phase(path), argv[1:]) or 0

    # The lock spans the read as well as the write: a command that parsed the
    # file before another finished writing it would overwrite that write.
    lock = _lock_acquire(INDEX)
    try:
        upgrade = load_json(state_path('upgrade.json'), {})
        if upgrade.get('status') not in (None, 'complete', 'rolled-back'):
            die('installation update is incomplete; run installer --recover before workflow mutations')
        if os.environ.get('CS_WORKER_ASSIGNMENT'):
            die('workers cannot mutate shared workflow state; return results to the coordinator')
        recover_transaction()
        if name == 'recover':
            print('workflow transaction recovery complete')
            return 0
        path = read_index()
        phase = read_phase(path)
        validate_transition(phase, name, argv[1:])
        rc = COMMANDS[name](phase, argv[1:]) or 0
    finally:
        _lock_release(lock)
    if rc == 0:
        _orca_mirror()
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, IndexError, AttributeError) as exc:
        die(f'cannot validate workflow state: {exc}; run plan doctor and repair the reported file')
