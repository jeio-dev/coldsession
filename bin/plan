#!/usr/bin/env python3
"""plan - dependency and context tooling for the planning workflow.

Reads PLAN.md (an index) and the phase file it points at. The phase file's
frontmatter carries a machine-readable task graph, its `## Findings` block
carries a machine-readable finding list, and the body carries the prose.
Stdlib only, no install step.

  plan status                     where the phase stands, and what to run next
  plan recommend                  one line: the next command to run, and why
  plan lint                       validate graph and findings, exit 1 on error
  plan next [--parallel]          next runnable task ids
  plan brief T2                   bounded read list + verify line for one task
  plan done T2                    mark a task done
  plan block T2 "reason"          mark a task blocked
  plan findings [--open]          the finding list
  plan resolve F1 STATE "note"    set a finding state, log it to the changelog
  plan begin STAGE [--resume]      claim review/revise/approve/close
  plan finish STAGE [--pass|--fail] complete a claimed stage
  plan start T2 [--resume]         claim one approved build task
  plan bump                       bump the phase rev, at the start of a revise
  plan reviewed                   record that this rev has had a review pass
  plan version                    print the coldsession release version
"""

import os
import re
import sys

TOOL_VERSION = "2.0.0"
FORMAT_VERSION = "1.4.0"

ROOT = os.environ.get("PLAN_ROOT", ".")
INDEX = os.path.join(ROOT, "PLAN.md")

TASK_RE = re.compile(r"^\s{2}(T\d+):\s*\{(.*)\}\s*$")
HEAD_RE = re.compile(r"^##\s+(.+?)\s*$")
TASK_HEAD_RE = re.compile(r"^(T\d+)\b")
FINDING_RE = re.compile(r"^F\d+\b")
CHANGE_RE = re.compile(r"^rev\s+(\d+)\s*\|\s*(F\d+)\s*\|\s*([A-Za-z_-]+)\s*\|\s*(.*)$")
LIST_RE = lambda k: re.compile(k + r":\s*\[([^\]]*)\]")
WORD_RE = lambda k: re.compile(k + r":\s*([A-Za-z_-]+)")
STATUSES = ("pending", "in_progress", "done", "blocked")
PSTATUSES = ("draft", "approved", "closed")
FSTATUSES = ("open", "resolved", "accepted")
SEVERITIES = ("Critical", "High", "Medium", "Low")
META_KEYS = ("phase", "rev", "status", "reviewed", "ready", "active",
             "active-rev", "workflow-rev")
STAGES = ("review", "revise", "approve", "close")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def read_text(path):
    """Read a file, tolerating a UTF-8 BOM.

    Windows PowerShell writes one by default - `Set-Content -Encoding UTF8`
    and `Out-File` both do - and a BOM ahead of the opening `---` means
    split_frontmatter sees no frontmatter at all, so the phase reads as
    having no tasks. Files are always written back without one.
    """
    return open(path, encoding="utf-8-sig").read()


def split_frontmatter(text):
    if not text.startswith("---"):
        return "", text
    end = text.find("\n---", 3)
    if end == -1:
        return "", text
    return text[3:end], text[end + 4:]


def join_frontmatter(fm, body):
    return "---" + fm + "\n---" + body


def csv(raw):
    return [p.strip() for p in raw.split(",") if p.strip()]


def intof(value, default=0):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def read_index():
    if not os.path.exists(INDEX):
        die("no PLAN.md at repo root. Run /cs-plan first.")
    fm, _ = split_frontmatter(read_text(INDEX))
    m = re.search(r"^current:\s*(\S+)", fm, re.M)
    if not m:
        die("PLAN.md frontmatter has no `current:` pointer.")
    path = os.path.join(ROOT, m.group(1))
    if not os.path.exists(path):
        die(f"PLAN.md points at {m.group(1)}, which does not exist.\n"
            "  A phase was probably closed and the next one not planned yet.\n"
            "  Run /cs-plan for it in a new session -- /cs-plan writes the phase file\n"
            "  and moves `current:` to it -- or point `current:` back at the\n"
            "  phase file you are still working in.")
    return path


def parse_tasks(fm):
    tasks, order, malformed = {}, [], []
    in_tasks = False
    for line in fm.splitlines():
        if re.match(r"^tasks:\s*$", line):
            in_tasks = True
            continue
        if in_tasks:
            if line.strip() and not line.startswith("  "):
                in_tasks = False
                continue
            if not line.strip():
                continue
            m = TASK_RE.match(line)
            if not m:
                malformed.append(line.rstrip())
                continue
            tid, inner = m.group(1), m.group(2)
            deps = LIST_RE("deps").search(inner)
            files = LIST_RE("files").search(inner)
            status = WORD_RE("status").search(inner)
            tasks[tid] = {
                "deps": csv(deps.group(1)) if deps else [],
                "files": csv(files.group(1)) if files else [],
                "status": status.group(1) if status else "?",
            }
            order.append(tid)
    return tasks, order, malformed


def parse_blocks(body):
    """Every `## Heading` in the body, mapped to its text."""
    blocks, current, buf = {}, None, []
    for line in body.splitlines():
        m = HEAD_RE.match(line)
        if m:
            if current is not None:
                blocks[current] = "\n".join(buf).strip()
            current, buf = m.group(1).strip(), []
            continue
        if current is not None:
            buf.append(line)
    if current is not None:
        blocks[current] = "\n".join(buf).strip()
    return blocks


COMMENT_RE = re.compile(r"<!--.*?-->", re.S)


def block(blocks, name):
    """A block's text with HTML comments removed.

    The templates carry their format examples inside comments; a commented
    finding is documentation, not a finding, including when the comment spans
    several lines and the example sits on one of the inner ones.
    """
    for head, text in blocks.items():
        if head.lower() == name.lower():
            return COMMENT_RE.sub("", text)
    return ""


def parse_findings(text):
    """One finding per line:

      F1 | Critical | Task ordering | T3 | open | description | recommended fix

    Prose and HTML comments are ignored. A line that starts with an F-id but
    does not carry seven fields is reported rather than silently dropped.
    """
    findings, order, malformed, dupes = {}, [], [], []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        if not line or line.startswith("<!--"):
            continue
        if not FINDING_RE.match(line):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) != 7:
            malformed.append(line)
            continue
        fid, sev, cat, tasks, status, desc, fix = parts
        if sev.title() not in SEVERITIES or status.lower() not in FSTATUSES:
            malformed.append(line)
            continue
        if fid in findings:
            dupes.append(fid)
            continue
        findings[fid] = {"severity": sev.title(), "category": cat,
                         "tasks": csv(tasks), "status": status.lower(),
                         "desc": desc, "fix": fix}
        order.append(fid)
    return findings, order, malformed, dupes


def parse_changelog(text):
    """One entry per line:  rev 2 | F1 | resolved | what carries the fix"""
    entries = []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*").strip()
        m = CHANGE_RE.match(line)
        if m:
            entries.append({"rev": intof(m.group(1)), "fid": m.group(2),
                            "state": m.group(3).lower(), "note": m.group(4).strip()})
    return entries


def read_phase(path):
    text = read_text(path)
    fm, body = split_frontmatter(text)
    meta = {}
    for key in META_KEYS:
        m = re.search(r"^%s:\s*(.+)$" % key, fm, re.M)
        if m:
            meta[key] = m.group(1).strip()

    tasks, order, malformed = parse_tasks(fm)
    blocks = parse_blocks(body)

    sections = {}
    for head, chunk in blocks.items():
        m = TASK_HEAD_RE.match(head)
        if m:
            sections[m.group(1)] = chunk

    findings, forder, fmalformed, fdupes = parse_findings(block(blocks, "Findings"))

    return {"path": path, "meta": meta, "tasks": tasks, "order": order,
            "sections": sections, "blocks": blocks, "malformed": malformed,
            "findings": findings, "forder": forder, "fmalformed": fmalformed,
            "fdupes": fdupes, "changelog": parse_changelog(block(blocks, "Changelog")),
            "text": text}


def num(tid):
    return int(tid[1:])


def cycles(tasks):
    color, found = {}, []

    def walk(node, stack):
        color[node] = 1
        for dep in tasks.get(node, {}).get("deps", []):
            if dep not in tasks:
                continue
            if color.get(dep) == 1:
                found.append(" -> ".join(stack + [node, dep]))
            elif color.get(dep, 0) == 0:
                walk(dep, stack + [node])
        color[node] = 2

    for tid in tasks:
        if color.get(tid, 0) == 0:
            walk(tid, [])
    return found


def runnable(phase):
    out = []
    for tid in phase["order"]:
        t = phase["tasks"][tid]
        if t["status"] != "pending":
            continue
        if all(phase["tasks"].get(d, {}).get("status") == "done" for d in t["deps"]):
            out.append(tid)
    return out


def open_findings(phase, severities=None):
    out = []
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        if f["status"] != "open":
            continue
        if severities and f["severity"] not in severities:
            continue
        out.append(fid)
    return out


def verify_line(phase, tid):
    for line in phase["sections"].get(tid, "").splitlines():
        if re.match(r"^\s*[-*]?\s*Verify:", line):
            return line.strip().lstrip("-* ").strip()
    return None


# ------------------------------------------------------------------- lint

def lint_issues(phase):
    errs, warns = [], []
    t = phase["tasks"]

    for line in phase["malformed"]:
        errs.append(f"E01 unparseable task line: {line}")
    if not t:
        errs.append("E02 no tasks: block in the phase file frontmatter")

    fmt = phase["meta"].get("workflow-rev")
    if fmt is None:
        warns.append("W03 phase file has no workflow-rev; it was written by an "
                     "older coldsession and may not match this tool")
    elif fmt.split(".")[0] != FORMAT_VERSION.split(".")[0]:
        errs.append(f"E11 phase file is format {fmt}, supported format is {FORMAT_VERSION}; "
                    "major versions differ and the shapes are not compatible")

    if phase["meta"].get("status") not in PSTATUSES + (None,):
        warns.append(f"W01 unexpected phase status {phase['meta'].get('status')!r}")

    active = phase["meta"].get("active")
    if active and active not in STAGES + ("plan",):
        errs.append(f"E16 unknown active stage {active!r}")
    if active and not phase["meta"].get("active-rev"):
        errs.append(f"E17 active stage {active!r} has no active-rev")
    if not active and phase["meta"].get("active-rev"):
        errs.append("E18 active-rev exists without an active stage")

    for tid in phase["order"]:
        task = t[tid]
        if task["status"] not in STATUSES:
            errs.append(f"E03 {tid} has status {task['status']!r}")
        if task["status"] == "in_progress" and phase["meta"].get("status") != "approved":
            errs.append(f"E19 {tid} is in_progress but the phase is not approved")
        if not task["files"]:
            errs.append(f"E04 {tid} has an empty files list; build cannot bound its reads")
        for dep in task["deps"]:
            if dep not in t:
                errs.append(f"E05 {tid} depends on {dep}, which is not in this phase")
            elif num(dep) > num(tid):
                warns.append(f"W02 {tid} depends on later task {dep}; reorder or renumber")
        if task["status"] == "done":
            for dep in task["deps"]:
                if t.get(dep, {}).get("status") != "done":
                    errs.append(f"E06 {tid} is done but its dependency {dep} is not")
        if tid not in phase["sections"]:
            errs.append(f"E07 {tid} is in the graph but has no `## {tid}` section in the body")
        elif not verify_line(phase, tid):
            errs.append(f"E08 {tid} has no Verify: line; build has nothing to run")

    for tid in phase["sections"]:
        if tid not in t:
            errs.append(f"E09 `## {tid}` exists in the body but not in the tasks graph")

    for c in cycles(t):
        errs.append(f"E10 dependency cycle: {c}")

    for line in phase["fmalformed"]:
        errs.append(f"E12 unparseable finding line: {line}")
    for fid in phase["fdupes"]:
        errs.append(f"E13 finding {fid} is defined more than once")

    logged = {c["fid"] for c in phase["changelog"]}
    for fid in phase["forder"]:
        f = phase["findings"][fid]
        for ref in f["tasks"]:
            if re.match(r"^T\d+$", ref) and ref not in t:
                errs.append(f"E14 finding {fid} names {ref}, which is not in this phase")
        if f["status"] != "open" and fid not in logged:
            warns.append(f"W04 {fid} is marked {f['status']} but no changelog entry "
                         "says what carries the fix")

    if phase["meta"].get("status") in ("approved", "closed"):
        stuck = open_findings(phase, ("Critical", "High"))
        if stuck:
            errs.append(f"E15 phase is {phase['meta']['status']} with open "
                        f"Critical/High findings: {', '.join(stuck)}")

    fmt_minor = intof((fmt or "1.0").split(".")[1] if "." in (fmt or "") else 0)
    rev = intof(phase["meta"].get("rev"), 1)
    ready = intof(phase["meta"].get("ready"), 0)
    if ready > rev:
        errs.append(f"E20 ready revision {ready} is newer than rev {rev}")
    if ready == rev and open_findings(phase):
        errs.append("E21 current revision is marked ready but still has open findings")
    if fmt_minor >= 4 and phase["meta"].get("status") == "approved" and ready != rev:
        errs.append(f"E22 phase is approved but rev {rev} has no matching ready marker")

    if intof(phase["meta"].get("rev"), 1) >= 3 and open_findings(phase, ("Critical",)):
        warns.append("W05 round 3 still has an open Critical; the phase is too large "
                     "or the objective is wrong. Split it and re-plan rather than "
                     "revising again")

    return errs, warns


# -------------------------------------------------------------- recommend

def recommend(phase):
    """What to run next, derived from the file rather than from memory.

    Returns (command, why). The command is what a human types; the reason is
    the state that produced it, so a wrong recommendation is debuggable.
    """
    meta = phase["meta"]
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0) if meta.get("reviewed") else 0
    status = meta.get("status", "draft")
    opened = open_findings(phase)

    active = meta.get("active")
    if active:
        return (f"/cs-{active} --resume",
                f"{active} is already active for rev {meta.get('active-rev', rev)}; "
                "a plain rerun is refused")

    in_progress = [x for x in phase["order"]
                   if phase["tasks"][x]["status"] == "in_progress"]
    if in_progress:
        return (f"/cs-build {in_progress[0]} --resume",
                f"{', '.join(in_progress)} already in progress; resume explicitly")

    if status == "closed":
        return ("/cs-plan",
                "this phase is closed; the next one has no file yet, and /cs-plan "
                "writes it and moves `current:` onto it")

    errs, _ = lint_issues(phase)

    if status == "draft":
        if rev >= 3 and open_findings(phase, ("Critical",)):
            return ("/cs-plan",
                    f"rev {rev} still has an open Critical "
                    f"({', '.join(open_findings(phase, ('Critical',)))}); split this phase "
                    "and re-plan rather than revising a fourth time")
        if not reviewed:
            return ("/cs-review",
                    "this phase has had no review pass; start one in a NEW session")
        if reviewed < rev:
            return ("/cs-review",
                    f"rev {rev} has not been checked since the last revision "
                    f"(last review pass was rev {reviewed}); run it in a NEW session")
        if opened:
            sev = ", ".join(sorted({phase["findings"][f]["severity"] for f in opened}))
            return ("/cs-revise",
                    f"{len(opened)} open finding(s) ({sev}): {', '.join(opened)}")
        if errs:
            return ("(fix the linter first)",
                    f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                    "this file until they are fixed")
        if intof(meta.get("ready"), 0) == rev:
            return ("(set status: approved)",
                    f"rev {rev} passed /cs-approve; the human approval edit is pending")
        return ("/cs-approve",
                f"rev {rev} is reviewed with no open findings; /cs-approve produces the "
                "evidence, then you set `status: approved` yourself")

    if errs:
        return ("(fix the linter first)",
                f"plan lint reports {len(errs)} error(s); nothing downstream can trust "
                "this file until they are fixed")

    if status == "approved":
        done = [x for x in phase["order"] if phase["tasks"][x]["status"] == "done"]
        nxt = runnable(phase)
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        blocked = [x for x in phase["order"] if phase["tasks"][x]["status"] == "blocked"]
        if nxt:
            return (f"/cs-build {nxt[0]}",
                    f"{len(done)} of {len(phase['order'])} tasks done; "
                    f"{nxt[0]} is runnable")
        if blocked and not pending:
            return ("/cs-review",
                    f"{', '.join(blocked)} blocked and nothing else is pending; "
                    "re-enter the loop at review")
        if pending:
            waiting = []
            for tid in pending:
                unmet = [d for d in phase["tasks"][tid]["deps"]
                         if phase["tasks"].get(d, {}).get("status") != "done"]
                waiting.append(f"{tid} waits on {', '.join(unmet) or 'nothing runnable'}")
            return ("(nothing runnable)", "; ".join(waiting))
        return ("/cs-close", "every task is done")

    return ("(fix phase status)", f"unsupported phase status {status!r}")


# ---------------------------------------------------------------- writing

def write_phase(phase, text):
    open(phase["path"], "w", encoding="utf-8").write(text)


def sub_outside_comments(pat, repl, text):
    """Replace the first match that is not inside an HTML comment.

    The read path drops commented lines, so the write path has to as well.
    Otherwise `plan resolve F1` edits the F1 in the template's format example
    and reports success while the real finding stays open.
    """
    spans = [(m.start(), m.end()) for m in COMMENT_RE.finditer(text)]
    for m in pat.finditer(text):
        if any(a <= m.start() < b for a, b in spans):
            continue
        return text[:m.start()] + repl(m) + text[m.end():], True
    return text, False


def set_meta(text, key, value):
    """Set a frontmatter field, inserting it after `status:` if absent."""
    fm, body = split_frontmatter(text)
    pat = re.compile(r"^(%s:\s*).*$" % re.escape(key), re.M)
    if pat.search(fm):
        fm = pat.sub(lambda m: m.group(1) + str(value), fm, count=1)
    else:
        anchor = re.compile(r"^(status:.*)$", re.M)
        if anchor.search(fm):
            fm = anchor.sub(lambda m: m.group(1) + f"\n{key}: {value}", fm, count=1)
        else:
            fm = fm.rstrip("\n") + f"\n{key}: {value}\n"
    return join_frontmatter(fm, body)


def del_meta(text, *keys):
    """Remove optional frontmatter fields without disturbing body text."""
    fm, body = split_frontmatter(text)
    for key in keys:
        fm = re.sub(r"^%s:\s*.*\n?" % re.escape(key), "", fm, flags=re.M)
    return join_frontmatter(fm.rstrip("\n") + "\n", body)


def set_metas(text, values=None, remove=()):
    for key, value in (values or {}).items():
        text = set_meta(text, key, value)
    return del_meta(text, *remove) if remove else text


def append_to_block(text, name, line):
    """Insert a line at the end of a `## Name` block, creating it if absent."""
    fm, body = split_frontmatter(text)
    lines = body.splitlines()
    start = None
    for i, raw in enumerate(lines):
        m = HEAD_RE.match(raw)
        if m and m.group(1).strip().lower() == name.lower():
            start = i
            break
    if start is None:
        body = body.rstrip("\n") + f"\n\n## {name}\n\n{line}\n"
        return join_frontmatter(fm, body)
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if HEAD_RE.match(lines[i]):
            end = i
            break
    tail = end
    while tail > start + 1 and not lines[tail - 1].strip():
        tail -= 1
    if tail == start + 1:
        lines.insert(tail, "")
        tail += 1
    lines.insert(tail, line)
    return join_frontmatter(fm, "\n".join(lines))


def _set_status(phase, tid, status, note=None):
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    pat = re.compile(r"^(\s{2}%s:\s*\{.*?status:\s*)([A-Za-z_-]+)" % tid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + status, phase["text"])
    if not hit:
        die(f"could not find a status field for {tid}")
    write_phase(phase, text)
    print(f"{tid} -> {status}")
    if note:
        log = phase["path"].replace(".md", ".log.md")
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(f"\n## {tid} blocked\n{note}\n")
        print(f"note appended to {log}")


# ---------------------------------------------------------------- commands

def print_recommend(phase, prefix="next"):
    cmd, why = recommend(phase)
    print(f"{prefix}     {cmd}")
    print(f"          why: {why}")


def cmd_status(phase, _args):
    m = phase["meta"]
    counts = {s: 0 for s in STATUSES}
    for t in phase["tasks"].values():
        counts[t["status"]] = counts.get(t["status"], 0) + 1
    reviewed = m.get("reviewed")
    print(f"phase    {m.get('phase', '?')}  rev {m.get('rev', '?')}  "
          f"status {m.get('status', '?')}  "
          f"reviewed {reviewed if reviewed else 'never'}  "
          f"ready {m.get('ready', 'no')}  "
          f"active {m.get('active', 'none')}  "
          f"workflow-rev {m.get('workflow-rev', '?')}")
    print(f"file     {phase['path']}")
    print("tasks    " + "  ".join(f"{k} {v}" for k, v in counts.items() if v))
    if phase["forder"]:
        opened = open_findings(phase)
        detail = ""
        if opened:
            by = {}
            for fid in opened:
                by[phase["findings"][fid]["severity"]] = \
                    by.get(phase["findings"][fid]["severity"], 0) + 1
            detail = "  (" + ", ".join(f"{v} {k}" for k, v in by.items()) + ")"
        print(f"findings {len(phase['forder'])} total  {len(opened)} open{detail}")
    nxt = runnable(phase)
    print("runnable " + (", ".join(nxt) if nxt else "none"))
    blocked = [t for t in phase["order"] if phase["tasks"][t]["status"] == "blocked"]
    if blocked:
        print("blocked  " + ", ".join(blocked))
    print_recommend(phase)


def cmd_recommend(phase, _args):
    cmd, why = recommend(phase)
    print(f"{cmd}   why: {why}")
    return 0


def cmd_lint(phase, _args):
    errs, warns = lint_issues(phase)
    for line in errs:
        print(line)
    for line in warns:
        print(line)
    if not errs and not warns:
        print(f"ok  {len(phase['tasks'])} tasks, graph is acyclic, every task has files "
              f"and a Verify line; {len(phase['forder'])} findings, "
              f"{len(open_findings(phase))} open")
    return 1 if errs else 0


def cmd_next(phase, args):
    nxt = runnable(phase)
    if not nxt:
        pending = [x for x in phase["order"] if phase["tasks"][x]["status"] == "pending"]
        if phase["meta"].get("status") == "closed":
            print("this phase is closed: run /cs-plan for the next one")
        elif not pending:
            print("no pending tasks: the phase is complete, run /cs-close")
        else:
            print("nothing runnable: every pending task is waiting on an unfinished dependency")
            for tid in pending:
                waiting = [d for d in phase["tasks"][tid]["deps"]
                           if phase["tasks"].get(d, {}).get("status") != "done"]
                print(f"  {tid} waits on {', '.join(waiting)}")
        return 0

    if "--parallel" not in args:
        print(" ".join(nxt))
        return 0

    groups = []
    for tid in nxt:
        files = set(phase["tasks"][tid]["files"])
        for g in groups:
            if not files & g["files"]:
                g["ids"].append(tid)
                g["files"] |= files
                break
        else:
            groups.append({"ids": [tid], "files": set(files)})
    print("these can run at the same time, one session each:")
    for g in groups:
        print("  " + " ".join(g["ids"]))
    if len(groups) > 1:
        print("groups touch overlapping files; run the groups in sequence")
    return 0


def _transitive_deps(phase, tid):
    """All ancestor task ids reachable via deps, in dependency-first order."""
    seen, order = set(), []

    def visit(t):
        for d in phase["tasks"].get(t, {}).get("deps", []):
            if d not in seen:
                seen.add(d)
                visit(d)
                order.append(d)

    visit(tid)
    return order


def cmd_brief(phase, args):
    if not args:
        die("usage: plan brief T2")
    tid = args[0].upper()
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]

    unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
    reads = ["AGENTS.md", phase["path"]]
    for dep in _transitive_deps(phase, tid):
        reads += phase["tasks"].get(dep, {}).get("files", [])
    reads += task["files"]

    seen, ordered = set(), []
    for r in reads:
        if r not in seen:
            seen.add(r)
            ordered.append(r)

    status = phase["meta"].get("status", "?")
    print(f"task    {tid}   status {task['status']}")
    print(f"phase   {phase['path']}  (phase status {status})")
    if status != "approved":
        cmd, _ = recommend(phase)
        print(f"NOT APPROVED this phase is {status}, not approved - run {cmd} first")
    if task["status"] != "in_progress":
        print(f"NOT STARTED {tid} is {task['status']}; run plan start {tid} first")
    if unmet:
        print(f"BLOCKED unmet dependencies: {', '.join(unmet)} - do not start this task")
    print("read    " + "\n        ".join(ordered))
    print("        (nothing else; if you need a file that is not listed, stop and say so)")
    v = verify_line(phase, tid)
    print(f"verify  {v[len('Verify:'):].strip() if v and v.startswith('Verify:') else v}")
    log = phase["path"].replace(".md", ".log.md")
    if os.path.exists(log):
        print(f"handoff {log}  (read the last entry only)")
    return 1 if unmet or status != "approved" or task["status"] != "in_progress" else 0


def cmd_findings(phase, args):
    only_open = "--open" in args
    rows = [f for f in phase["forder"]
            if not only_open or phase["findings"][f]["status"] == "open"]
    if not rows:
        print("no open findings" if only_open else
              "no findings recorded; /cs-review writes them into the phase file")
        return 0
    for fid in rows:
        f = phase["findings"][fid]
        print(f"{fid:<4} {f['severity']:<9} {f['status']:<9} "
              f"{','.join(f['tasks']) or '-':<10} {f['category']}")
        print(f"     {f['desc']}")
        print(f"     fix: {f['fix']}")
    opened = open_findings(phase)
    print(f"{len(phase['forder'])} findings, {len(opened)} open")
    return 0


def cmd_resolve(phase, args):
    if len(args) < 2:
        die('usage: plan resolve F1 <open|resolved|accepted> "what carries the fix"')
    fid, state = args[0].upper(), args[1].lower()
    note = " ".join(args[2:]).strip()
    if fid not in phase["findings"]:
        die(f"{fid} is not a finding in this phase")
    if state not in FSTATUSES:
        die(f"state must be one of {', '.join(FSTATUSES)}")
    if state != "open" and not note:
        die(f"{fid} -> {state} needs a note naming the task or plan line that "
            "carries the fix")

    active = phase["meta"].get("active")
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    expected = "review" if state == "open" else "revise"
    if modern and active != expected:
        die(f"{fid} -> {state} is only valid during an active {expected} pass; "
            f"run /cs-{expected} first")

    pat = re.compile(r"^(\s*[-*]?\s*%s\s*\|[^|]*\|[^|]*\|[^|]*\|\s*)([A-Za-z_-]+)" % fid, re.M)
    text, hit = sub_outside_comments(pat, lambda m: m.group(1) + state, phase["text"])
    if not hit:
        die(f"could not find the status field of {fid}; check its line has seven "
            "pipe-separated fields")
    rev = intof(phase["meta"].get("rev"), 1)
    text = append_to_block(text, "Changelog",
                           f"rev {rev} | {fid} | {state} | {note or 'reopened'}")
    write_phase(phase, text)
    print(f"{fid} -> {state}, logged to the changelog at rev {rev}")
    return 0


def _stage_refusal(phase, message):
    cmd, why = recommend(phase)
    die(f"{message}\nnext: {cmd}\nwhy: {why}")


def cmd_begin(phase, args):
    if not args:
        die(f"usage: plan begin <{'|'.join(STAGES)}> [--resume]")
    stage = args[0].lower()
    resume = "--resume" in args[1:]
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")

    meta = phase["meta"]
    active = meta.get("active")
    rev = intof(meta.get("rev"), 1)
    reviewed = intof(meta.get("reviewed"), 0)
    status = meta.get("status", "draft")

    if active:
        if active == stage and resume:
            print(f"resume {stage} at rev {meta.get('active-rev', rev)}")
            return 0
        if active == stage:
            _stage_refusal(phase, f"{stage} is already active; rerun with --resume")
        _stage_refusal(phase, f"cannot begin {stage}; {active} is active")
    if resume:
        _stage_refusal(phase, f"cannot resume {stage}; no {stage} pass is active")

    opened = open_findings(phase)
    if stage == "review":
        if status != "draft" or reviewed >= rev:
            _stage_refusal(phase, f"rev {rev} is not waiting for review")
    elif stage == "revise":
        if status != "draft" or reviewed != rev or not opened:
            _stage_refusal(phase, "this phase is not waiting for revision")
        if rev >= 3 and open_findings(phase, ("Critical",)):
            _stage_refusal(phase, "round 3 still has an open Critical; re-plan the phase")
    elif stage == "approve":
        if (status != "draft" or reviewed != rev or opened or
                intof(meta.get("ready"), 0) == rev):
            _stage_refusal(phase, "this revision is not waiting for readiness checking")
    elif stage == "close":
        unfinished = [tid for tid in phase["order"]
                      if phase["tasks"][tid]["status"] != "done"]
        if status != "approved" or unfinished or opened:
            _stage_refusal(phase, "this phase is not ready to close")

    text = set_metas(phase["text"], {"active": stage, "active-rev": rev})
    write_phase(phase, text)
    print(f"begin {stage} at rev {rev}")
    return 0


def _require_active(phase, stage):
    active = phase["meta"].get("active")
    if active != stage:
        _stage_refusal(phase, f"cannot finish {stage}; active stage is {active or 'none'}")


def _tick_current_phase(phase):
    rel = os.path.relpath(phase["path"], ROOT).replace(os.sep, "/")
    index_text = read_text(INDEX)
    lines = index_text.splitlines()
    hit = False
    for i, line in enumerate(lines):
        if rel in line and re.match(r"^\s*-\s*\[[ xX]\]", line):
            lines[i] = re.sub(r"^(\s*-\s*)\[[ xX]\]", r"\1[x]", line, count=1)
            hit = True
            break
    if not hit:
        die(f"PLAN.md has no phase checklist line for {rel}")
    return "\n".join(lines) + ("\n" if index_text.endswith("\n") else "")


def cmd_finish(phase, args):
    if not args:
        die(f"usage: plan finish <{'|'.join(STAGES)}> [--pass|--fail]")
    stage = args[0].lower()
    if stage not in STAGES:
        die(f"stage must be one of {', '.join(STAGES)}")
    _require_active(phase, stage)

    rev = intof(phase["meta"].get("rev"), 1)
    active_rev = intof(phase["meta"].get("active-rev"), rev)
    text = phase["text"]

    if stage == "review":
        if rev != active_rev:
            die(f"review claimed rev {active_rev}, but phase is now rev {rev}")
        text = set_meta(text, "reviewed", rev)
    elif stage == "revise":
        if rev != active_rev + 1:
            die("finish revise requires exactly one successful plan bump")
    elif stage in ("approve", "close"):
        passed = "--pass" in args[1:]
        failed = "--fail" in args[1:]
        if passed == failed:
            die(f"finish {stage} requires exactly one of --pass or --fail")
        errs, _ = lint_issues(phase)
        if passed and (errs or open_findings(phase)):
            die(f"cannot pass {stage}; lint errors or open findings remain")
        if failed and not (errs or open_findings(phase)):
            die(f"cannot fail {stage} without a persisted open finding or lint error")
        if stage == "approve" and passed:
            if intof(phase["meta"].get("reviewed"), 0) != rev:
                die(f"cannot mark rev {rev} ready; it has not been reviewed")
            text = set_meta(text, "ready", rev)
        if stage == "close" and passed:
            if phase["meta"].get("status") != "approved":
                die("only an approved phase can close")
            if any(t["status"] != "done" for t in phase["tasks"].values()):
                die("cannot close while tasks remain unfinished")
            index_text = _tick_current_phase(phase)
            text = set_meta(text, "status", "closed")
            text = del_meta(text, "active", "active-rev")
            open(INDEX, "w", encoding="utf-8").write(index_text)
            write_phase(phase, text)
            print(f"finish close --pass; {phase['meta'].get('phase', '?')} -> closed")
            return 0
        if stage == "close" and failed:
            text = set_meta(text, "status", "draft")
            text = del_meta(text, "ready")

    text = del_meta(text, "active", "active-rev")
    write_phase(phase, text)
    outcome = " --pass" if "--pass" in args else " --fail" if "--fail" in args else ""
    print(f"finish {stage}{outcome} at rev {rev}")
    return 0


def cmd_start(phase, args):
    if not args:
        die("usage: plan start T2 [--resume]")
    tid = args[0].upper()
    resume = "--resume" in args[1:]
    if phase["meta"].get("active"):
        _stage_refusal(phase, f"cannot start {tid}; {phase['meta']['active']} is active")
    if tid not in phase["tasks"]:
        die(f"{tid} is not in this phase")
    task = phase["tasks"][tid]
    if phase["meta"].get("status") != "approved":
        _stage_refusal(phase, f"cannot start {tid}; phase is not approved")
    if task["status"] == "in_progress":
        if not resume:
            die(f"{tid} is already in_progress; rerun /cs-build {tid} --resume")
        print(f"resume {tid}")
        return 0
    if resume:
        die(f"cannot resume {tid}; its status is {task['status']}")
    if task["status"] != "pending":
        die(f"cannot start {tid}; its status is {task['status']}")
    unmet = [d for d in task["deps"]
             if phase["tasks"].get(d, {}).get("status") != "done"]
    if unmet:
        die(f"cannot start {tid}; unmet dependencies: {', '.join(unmet)}")
    _set_status(phase, tid, "in_progress")
    return 0


def cmd_bump(phase, _args):
    if phase["meta"].get("active") != "revise":
        die("plan bump is only valid during an active revise pass")
    rev = intof(phase["meta"].get("rev"), 1)
    base = intof(phase["meta"].get("active-rev"), rev)
    if rev == base:
        rev += 1
        write_phase(phase, set_meta(phase["text"], "rev", rev))
        print(f"rev -> {rev}")
    elif rev == base + 1:
        print(f"rev already {rev}; resume did not bump again")
    else:
        die(f"active revise began at rev {base}, but current rev is {rev}")
    return 0


def cmd_reviewed(phase, _args):
    if phase["meta"].get("active") == "review":
        return cmd_finish(phase, ["review"])
    fmt = phase["meta"].get("workflow-rev", "1.0.0")
    modern = intof(fmt.split(".")[1] if "." in fmt else 0) >= 4
    if modern:
        die("plan reviewed requires an active review; run plan begin review first")
    rev = intof(phase["meta"].get("rev"), 1)
    if intof(phase["meta"].get("reviewed"), 0) >= rev:
        die(f"rev {rev} has already been reviewed")
    write_phase(phase, set_meta(phase["text"], "reviewed", rev))
    print(f"reviewed -> {rev} (legacy phase)")
    return 0


def cmd_done(phase, args):
    if not args:
        die("usage: plan done T2")
    tid = args[0].upper()
    task = phase["tasks"].get(tid)
    if task:
        if task["status"] != "in_progress":
            die(f"{tid} must be in_progress before it can be marked done")
        unmet = [d for d in task["deps"] if phase["tasks"].get(d, {}).get("status") != "done"]
        if unmet:
            die(f"{tid} depends on {', '.join(unmet)}, which are not done")
    _set_status(phase, tid, "done")
    return 0


def cmd_block(phase, args):
    if not args:
        die('usage: plan block T2 "reason"')
    tid = args[0].upper()
    task = phase["tasks"].get(tid)
    if not task:
        die(f"{tid} is not in this phase")
    if task["status"] != "in_progress":
        die(f"{tid} must be in_progress before it can be blocked")
    _set_status(phase, tid, "blocked", " ".join(args[1:]) or "no reason given")
    text = read_text(phase["path"])
    text = set_meta(text, "status", "draft")
    text = del_meta(text, "ready")
    write_phase(phase, text)
    print("phase -> draft; readiness cleared")
    return 0


def cmd_version(_phase, _args):
    print(TOOL_VERSION)
    return 0


COMMANDS = {"version": cmd_version, "status": cmd_status, "lint": cmd_lint,
            "next": cmd_next, "brief": cmd_brief, "start": cmd_start,
            "done": cmd_done, "block": cmd_block, "begin": cmd_begin,
            "finish": cmd_finish,
            "findings": cmd_findings, "resolve": cmd_resolve, "bump": cmd_bump,
            "reviewed": cmd_reviewed, "recommend": cmd_recommend}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    name = argv[0]
    if name not in COMMANDS:
        die(f"unknown command {name!r}. Try: {', '.join(COMMANDS)}")
    if name == "version":
        return cmd_version(None, argv[1:])
    phase = read_phase(read_index())
    return COMMANDS[name](phase, argv[1:]) or 0


if __name__ == "__main__":
    sys.exit(main())
